  "keJing": [
    [
      {
        "key": "遥克课 睽卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课上下俱无相克，则取日干与其他三课上神比较。若同时出现数者遥克日干，日干遥克之神，则取与日干比者为用。"
      }
    ],
    [
      {
        "key": "蒿矢课",
        "value": ""
      },
      {
        "key": "特征",
        "value": "先取遥克日干之神作初传，为蒿矢课。远神克日缓而轻，如折蒿为矢力弱难伤。三传带金为矢有簇，有杀伤力。"
      },
      {
        "key": "含义",
        "value": "开始气势汹汹，后来雷声大雨点小。忧喜皆无实，文书虚谋。不宜有客，有客多反目成仇。利主不利客，利小不利大。诸事先难后利，先动手无利，后动手有利。"
      },
      {
        "key": "注意",
        "value": "三传神将凶，日辰无气。有盗贼及其他阴谋灾害。三传神将吉，日辰有气者，谒贵有喜，待人亦来。"
      },
      {
        "key": "占事",
        "value": "开始时有如雷般的凶势，但愈久愈休，逐渐消失。"
      },
      {
        "key": "文书",
        "value": "忧喜不能成实，文书停留在谋划上。"
      },
      {
        "key": "行人",
        "value": "不宜有客，有客多为仇敌。"
      },
      {
        "key": "兵事",
        "value": "兵利主一方，不利客一方。"
      }
    ],
    [
      {
        "key": "六十、元胎课 家人卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
      },
      {
        "key": "含义",
        "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
      },
      {
        "key": "注意",
        "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
      }
    ],
    [
      {
        "key": "绝胎格",
        "value": "元胎课逢反吟，虽开花但不结子。"
      }
    ],
    [
      {
        "key": "病胎格",
        "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
      }
    ],
    [
      {
        "key": "生胎格",
        "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
      }
    ],
    [
      {
        "key": "蓦越格",
        "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
      }
    ]
  ],
  "bifa": "25.金日逢丁凶祸动.C.蛇虎遁鬼格.六甲.夜\n25.金日逢丁凶祸动.E.马载虎鬼格.昼\n26.水日逢丁财动之.A.财乘丁马格.③财乘日本临干上.夜常\n26.水日逢丁财动之.A.财乘丁马格.④财乘日本.夜常\n37.末助初兮三等论.D.自招其祸格\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n47.贵虽在狱宜临干\n66.支坟财并旅程稽\n69.虎乘遁鬼殃非浅.夜虎\n75.宾主不投刑在上.Ⅲ.三字刑\n77.互生俱生凡事益.B.俱生格\n91.虎乘干鬼凶速速.A.马载虎鬼格.昼",
  "zhiZhi": "甲午日第四局干上亥\n课体：遥克，蒿矢，元胎。\n课义：申为矢箭，射中非善，马载马鬼，昼难脱患。\n解曰：蒿矢本无力，得申金发用，便为矢有金镞。若被射中，非吉祥之事。况申金又为日鬼，而兼驿马，鬼则患深，马则动速。夜占犹可，昼占白虎乘之，其凶更甚。虽有善避者，岂能脱然免于患耶。\n断曰：蒿矢之卦，祸福俱轻。然合病胎之格，忧疑莫决。虎临干鬼发用，至为凶险。幸是折腰，吉凶皆半途消散，求官者反嫌其空陷也。若四季占，亥水无气，却喜申鬼生亥，乃不幸中之幸。否则虚心坐待，长生在干，亦可窃金育日也。\n天时：雨后生寒，日孟出而不出，大风之象。\n家宅：卯加午为闭口，主有喑者。虎乘申，主家有病人未愈。宅上朱勾，主有文书勾连之事，宜慎。\n婚姻：虽见和合，有阻；\n胎产：安吉，防生哑儿。\n功名：巳年月大吉，合催官捧印，化龙之兆。\n求财：惊患多而获利细。\n疾病：主咽喉症，巳酉丑月占，为脓血之灾。\n失脱：元武临贵，勾陈落空，不能捕获。\n出行：出必旋返。\n行人：中路有阻。\n争讼：利主不利客托贵无力。\n兵战：宜慎。\n毕法云：宾主不投刑在上，闭口卦体两般推。\n课经云：亥加寅，夜将太常，乘日之长生，来人必占婚姻，或有恩赐服食等事。\n神将论云：太冲乘勾空为沙门，用日主其僧多不洁少实。又天后加申，甲日为湖池。",
  "jiYingQian": "甲午日第四局干上亥\n课体：蒿矢、玄胎、闭口、折腰、不行传。\n又：此课亥来生日，是官长垂顾，太阴阴祐之象。但羊刃作雀在宅，乃本家之朱雀恐目下本家有事起。初传白虎作鬼祟，中传巳为子孙空亡暗害，是家中人所为，从此遂自生事。末传寅加巳上落空，远则四年，近则四月，被事牵缠。若见令嗣人讼，其身不便免议。傅大录占课时，正得知县意，乃与其叔竞田，与弟争财，其弟与人作闹，大录妻叶氏证虚二次，其弟挟恨，故告他子违法事。州府送判枉法，计会得免，故不过半年。又课中与支不足，因行察劫掠贼案，受钱一千贯，三年事发，禁勘八个月，第四年配英州而死（《壬占汇选》作：己酉年正月十五甲午日子将卯时，傅大禄己巳生，四十一岁占平生。傅生于十一月初三日午时）。\n又同日时，何子玉占得此课。其何子玉，年壬戌，四十八，行年在丑上。此课先生曰：“来年行年寅上，因僧人丧之水边，拾得物，有十一年之宽，后依旧不足，犯刑责刑事，却做炉匠，被姓陈人坏了。”次年有一僧人，五月过水而死，有银四斤在腹，被他拾得，果有十一年之宽。第十一年，又在此溪边，却被人劫尽其财。后作坑冶匠，未及四年，为陈巡检装诬作贼，配英州。亥加寅，七与四，乃十一年也，马作鬼，有凶动也（《壬占汇选》作：何子重壬戌生，四十八岁占平生，同得此课）。\n《玉历钤》云：此课申为日鬼，临亥为害，且将皆凶，气象不和。幸而蒿矢，中传空亡折腰，凡百忧喜无成。\n《毕法》云：此课日上亥虽为甲之长生，初传申却是木绝，又来克伐，虽有面前之微吉，却有背后之深害，谚曰“贪得一粒粟，失却半年粮”，此之谓也。\n上神生日，日上生辰上，用克日，初克末。\n课名：蒿矢、玄胎。中末空亡，然甲日乃为凶中之吉，盖初传申乃日鬼，若不空，即为害。但此占事，虽可解忧，不可作吉，虽朱勾在中援引，亦不能成功。\n《义》曰：神将生助，福自有成。先凶后吉，渐得其情。闻忧有解，成事变更。守正修德，无不利亨。\n《象》曰：白虎当途事可忧，凶中有救放眉头。吉人终不为灾害，天理昭昭自有由。\n又：此蒿矢带金之卦，其凶可畏，一曰玄胎，亦曰天网。《经》云：“神遥克日名蒿矢，射我虽端当不畏。贵人逆转子无良，天乙顺行臣不义。家有宾来不可容，亦忧口舌西南至。”凡事主动摇，人情倒置，象如以蒿为矢，射我虽中而不人。祸福俱轻，求事难成，利主不利客。占行人来，访人见，若带金煞，亦能伤人，主幕然有灾。所幸传入空乡，又名遗镞，不能成事，祸从内起。况玄胎如婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不通，触则成祸，惟君子守正修德则亨。夫天网者，即天网四张也，《经》曰“天网四张，万物被伤”，为阻滞，为疑难，为灾恼。上神生日，所为百事吉，运用如意，遇灾不凶，逢吉愈吉。日是人相助，夜是神相助。若冬占，主声名显达，岁生日者，尤为吉昌。占者遇之此课，凡占谋百事，主客相和，但畏夫阻滞之神为扰。占吉事者阻挠而后难成，占忧惊之事先凶后吉，难中有救，上门相助。占老人小儿病，得之大凶，有德可解。\n占出兵行师得此：宜先避其锋，然后方可动垒。昼占凶，夜占稍可，终见讲和，而不能成其凶咎也。大抵此课，凡占百事，有始无终之象也。\n春中夏吉。\n真一山人云：此课原来号折腰，吉凶半路总虚劳。求官须待巳年月，巳化为龙福自高。\n《无惑钤》云：申为矢箭，射中非善。马载虎鬼，患难脱免。\n《钤解》曰：蒿矢得金为有力，又为虎鬼乘马，凶甚速也。夜占可，昼占难免其患难也。又云：乐里生悲，先受生，后坐脱败宜守。又云：若四季占，亥水无气，却喜申鬼生亥，乃不幸中幸。又云：卯加午为闭口，占家宅上乘朱勾，主文书勾连，宜慎，吉。",
