      {
        "条目": "毕法赋11：众鬼虽彰全不畏（课传鬼与子孙制鬼）",
        "成格": "相关位置见日鬼（申）；相关位置子孙能克已见鬼（巳）；第2课上神、初传申临地盘亥乘白虎；中传巳临地盘申乘勾陈（旬空）；巳临申旬空。",
        "意象": "鬼有制或有承接转生，压力存在化解途径。"
      },
      {
        "条目": "毕法赋38：闭口卦体两般推（旬尾加旬首）",
        "成格": "旬尾加旬首（旬首午，旬尾卯，旬尾所临地盘午）；第3课上神卯临地盘午乘朱雀。",
        "意象": "堵塞、隐匿、不言、不泄；财禄作旬尾可取不肯交付之象。"
      },
      {
        "条目": "毕法赋47：贵虽在狱宜临干（贵临辰戌）",
        "成格": "实际贵人临地盘辰戌（天盘丑临地盘辰乘贵人）；天盘丑临地盘辰乘贵人（坐空）；丑临辰坐空。",
        "意象": "主事者处拘制、烦忧之地，干求不畅，须察其能否助我。"
      },
      {
        "条目": "毕法赋60：太阳射宅屋光辉（太阳临支）",
        "成格": "月将临支（太阳月将卯，上神卯）；第3课上神卯临地盘午乘朱雀。",
        "意象": "宅居明朗、受光饰或上人照拂；月将临支之象。"
      },
      {
        "条目": "毕法赋67：受虎克神为病症（白虎乘神所克五行）",
        "成格": "实际白虎见相关位置（天盘申临地盘亥乘白虎）；第2课上神、初传申临地盘亥乘白虎。",
        "意象": "白虎乘金，所乘支克木，以受克五行作病症部类线索。"
      },
      {
        "条目": "毕法赋68：制鬼之位乃良医（制鬼位置）",
        "成格": "相关位置见日鬼（申）；相关位置子孙能克已见鬼（巳）；第2课上神、初传申临地盘亥乘白虎；中传巳临地盘申乘勾陈（旬空）；巳临申旬空。",
        "意象": "制鬼者为解忧途径；依问可取医者、捕者、代理交涉者。"
      },
      {
        "条目": "毕法赋75：宾主不投刑在上（三字刑）",
        "成格": "三传集齐三刑（申、巳、寅）；第2课上神、初传申临地盘亥乘白虎；中传巳临地盘申乘勾陈（旬空）；末传寅临地盘巳乘腾蛇（坐空）；巳临申旬空、寅临巳坐空。",
        "意象": "刑在相应位置，交涉不投、强制冲突；自刑可取自扰之象。"
      },
      {
        "条目": "毕法赋77：互生俱生凡事益（俱生结构）",
        "成格": "干上生日干（亥、甲）；支上生日支（卯、午）；第1课上神亥临地盘寅乘太阴；第3课上神卯临地盘午乘朱雀。",
        "意象": "双方各有生助，各得益处。"
      },
      {
        "条目": "毕法赋82：不行传者考初时（初实中末空陷）",
        "成格": "初传申临地盘亥，支与坐地皆不空；中传天盘巳临地盘申，旬空；末传天盘寅临地盘巳，坐空。",
        "意象": "事重初起与实处，后续承接乏力；按初传所指判断眼前之事。"
      },
      {
        "条目": "毕法赋91：虎临干鬼凶速速（虎乘日鬼）",
        "成格": "白虎乘神克日干（乘支申，日干甲）；见课传（第2课上神、初传）；第2课上神、初传申临地盘亥乘白虎。",
        "意象": "虎乘日鬼，压力或惊扰来得迅疾；官职事务另察催官之义。"
      }
    ]
