    {
      "case_id": "BK26-ANCIENT-433",
      "subjudgment_id": "BK26-ANCIENT-433-Q01",
      "judgment": "棋子余8同课与周凶",
      "category_tags": [
        "官讼占"
      ],
      "judgment_stage_tags": [
        "取用",
        "作用与救制",
        "过程结果"
      ],
      "disposition": "source_method_recorded",
      "method_note": "32除12余8明再起亦此课；己丑命见丁墓戌临丑、太岁未三刑，故与寅命差甚判有罪；后相国赐死只原叙。",
      "source_spans": [
