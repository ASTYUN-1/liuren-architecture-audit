      "judgment": "内官武职及喧争不见官",
      "category_tags": [
        "财运占"
      ],
      "judgment_stage_tags": [
        "类象链",
        "作用与救制",
        "过程结果"
      ],
      "disposition": "source_method_recorded",
      "method_note": "商征取酉丁，亥阴贵、末常武臣酒食加亥入狱，年勾合喧争且勾空不见官；原二内官与张直殿争后和未见官。",
