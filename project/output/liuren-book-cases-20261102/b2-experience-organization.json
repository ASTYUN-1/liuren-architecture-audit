      "judgment_stage_tags": [
        "取用",
        "方位定位",
        "作用与救制"
      ],
      "disposition": "source_method_recorded",
      "method_note": "未羊类上太阳月将、丁未未发用，本位西南未眷属；本位不旺但将相气说不失。原妻姐家寻获仅原叙。",
