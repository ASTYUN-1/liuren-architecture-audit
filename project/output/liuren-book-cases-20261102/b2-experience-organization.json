    {
      "case_id": "BK26-ANCIENT-432",
      "subjudgment_id": "BK26-ANCIENT-432-Q01",
      "judgment": "盛讼可辩雪",
      "category_tags": [
        "官讼占"
      ],
      "judgment_stage_tags": [
        "作用与救制",
        "过程结果",
        "反证"
      ],
      "disposition": "source_method_recorded",
      "method_note": "辰月将青龙临干支、卯勾生日丁、亥子鬼临寅卯空，故谓到京公讼前休；实际后述破京脱归，时间过程不直接等到京前即结。",
      "source_spans": [
        {
          "path": "书籍库/现代著作/《壬占汇选》.txt",
