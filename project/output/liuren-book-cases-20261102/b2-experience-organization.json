    },
    {
      "case_id": "BK26-ANCIENT-432",
      "subjudgment_id": "BK26-ANCIENT-432-Q02",
      "judgment": "相同盘的年命限制",
      "category_tags": [
        "官讼占"
      ],
      "judgment_stage_tags": [
        "取用",
        "反馈范围/方法缺口"
      ],
      "disposition": "source_method_recorded",
      "method_note": "盛寅命与周己丑不同，作者明确乌能无罪作比较；这是不同人两问，不用盛生还对周吉凶互证。",
      "source_spans": [
        {
