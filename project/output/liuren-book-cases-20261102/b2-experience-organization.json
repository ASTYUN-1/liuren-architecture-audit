    },
    {
      "case_id": "BK26-ANCIENT-431",
      "subjudgment_id": "BK26-ANCIENT-431-Q02",
      "judgment": "病症风癫发搐与应日时",
      "category_tags": [
        "健康占"
      ],
      "judgment_stage_tags": [
        "取象",
        "应期",
        "反馈范围/方法缺口"
      ],
      "disposition": "source_method_recorded",
      "method_note": "卯加申、戌加卯说风癫发搐；久病卯加申取申日子时，子时完整推法未细明，且原无独立死亡实报。",
      "source_spans": [
        {
          "path": "书籍库/现代著作/《壬占汇选》.txt",
