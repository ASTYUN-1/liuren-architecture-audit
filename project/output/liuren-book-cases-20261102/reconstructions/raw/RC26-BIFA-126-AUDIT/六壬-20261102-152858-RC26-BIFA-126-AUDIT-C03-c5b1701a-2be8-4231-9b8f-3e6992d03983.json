  "keJing": [
    [
      {
        "key": "重审课 坤卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
      },
      {
        "key": "含义",
        "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
      },
      {
        "key": "注意",
        "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
      },
      {
        "key": "占事",
        "value": "宜后起，祸由内生。"
      },
      {
        "key": "兵事",
        "value": "用兵主胜。"
      },
      {
        "key": "占孕",
        "value": "主生女。"
      },
      {
        "key": "谋望",
        "value": "主先难后成。"
      },
      {
        "key": "诉讼",
        "value": "后者胜，对被告有利。"
      },
      {
        "key": "初传为墓绝，末传为生旺",
        "value": "灾祸消解，事终有成。"
      },
      {
        "key": "初传为生旺，末传为墓绝",
        "value": "先易后难，先得后失。"
      },
      {
        "key": "初传克末传",
        "value": "有凶兆"
      },
      {
        "key": "末传克初传",
        "value": "为吉兆，"
      },
      {
        "key": "末传天将为龙、常、阴。后、",
        "value": ""
      },
      {
        "key": "六合等吉将，或为德、喜等吉神",
        "value": "逢凶化吉。"
      }
    ],
    [
      {
        "key": "二十九、斩关课 井卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "魁罡加日辰发用，乃豹隐南山之课。"
      },
      {
        "key": "含义",
        "value": "关梁逾越，最利逃亡，捕贼难获，出行无殃。病讼凶祸，厌祷吉祥。最利隐遁逃亡。"
      },
      {
        "key": "注意",
        "value": "贵人临亥，为贵登天门。甲戊庚日贵登天门，为神藏煞没。凡占事遇之，主万事顺利，不独斩关课如此。河魁加亥，名魁度天门，主抑塞难通；天罡加寅，名罡塞鬼户，主谋为顺利；"
      },
      {
        "key": "另注",
        "value": "魁罡临日辰，传有虎阴申酉为斩关得逃者，永远不获。若带血支、血忌、呻吟、羊刃、三杀，必伤人而走。"
      },
      {
        "key": "占行",
        "value": "利于出行，逃遁，但捉贼难获。"
      },
      {
        "key": "占病",
        "value": "遇之大凶。"
      },
      {
        "key": "占讼",
        "value": "遇之大凶。"
      },
      {
        "key": "其他",
        "value": "宜于书符、合药，厌祷。"
      },
      {
        "key": "天地独通",
        "value": "逃亡出行，如有神助。"
      }
    ],
    [
      {
        "key": "炎上格（炎上课）",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传寅午戌，合为火局。或者巳午未属南方一气，也是此格。占天晴旱，"
      },
      {
        "key": "含义",
        "value": "春夏占吉。占主文书、火事。常人占主口舌及宅不安。火鬼并，火灾；朱雀并，官讼；天空并，屋坏。病者多热，或在于心。见后合，妇人血病。占天大晴，占人性急、文明。占行人来，火性动也。失物藏窑炉处。事主急速，枉图不遂，虚多实少，事难持久。或朋党疏狂鼓扇而成，先喜后嗔，先合后散，盖火焰不久成灰矣。忌戌加寅为墓临生，盖火以虚而明，实则暗，占事明反为暗。午加戌主失马、文书凭证，入墓故也。戌为狱神，传墓有讼狱事。壬癸日为财，其实是鬼，盖火生土，土能克水，名子母鬼，凡占主破骨肉解破其事。大都炎上利于见官，雪明皂白。秋夏占为恃势谋事成。庚辛日名带杀，来意占病讼。如年命更乘火神，病死讼凶。辛酉日寅加辛为用，主因财成怨也。日干若亦为火，象君，宜奏对。日干得驿马贞位，为天子持权，仕人差遣快心。驿马贞位者，以罡加日建，视马上所得神为贞神，年命遇更吉。"
      }
    ]
  ],
  "bifa": "02.首尾相见始终宜.B.回环格\n05.六阳数足须公用.A.六阳格\n25.金日逢丁凶祸动.C.蛇虎遁鬼格.六甲.昼\n28.传鬼化财钱险危.A.取还魂债格\n30.屋宅宽广致人衰.B.狮兽冲宅格.夜虎\n43.害贵讼直作屈断.Ⅰ.害昼贵\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n49.两贵受克难干贵.B.贵人忌惮格.昼\n52.罡塞鬼户任谋为.B.神藏煞没格.夜贵\n64.夫妇芜淫各有私\n66.支坟财并旅程稽\n69.虎乘遁鬼殃非浅.昼虎\n85.初遭夹克不由己.昼\n85.初遭夹克不由己.夜",
  "zhiZhi": "甲子日第五局干上戌\n课体：重审，斩关，炎上，狡童，泆女。\n课义：支干互克，各被相触，昼畏中传，亡财失仆。\n解曰：干上戌克子，支上申克甲，是各被相触也。中传午遁旬庚，上乘白虎，至凶至恶，纵空亡不能为解。\n毕法云：虎乘遁鬼殃非浅，占病甚危。初戌财仆既为旬空，又遭夹克，则仆亡财失，所不免也。\n断曰：重审之卦，传见炎上，主多虚少实之象。以墓临生，明事反暗，求谋失意，事有难成，不可托人，亦不可投谒。解散忧疑则吉，守旧则亨。九流僧道，白手求财，无心谋干者，可望成就。盖重审以下克上，以卑犯尊，以贱役贵。事多不顺，起于女人，多是内事。阴小在下，不可遂意而行。课体虽曰芜淫，亦不止夫妇阴私暗昧也。\n天时：晴不雨。\n家宅：破耗致穷，常人有官事。\n婚姻：暗而不明；后克龙，辰克日，主女妨夫。\n产孕：男胎不实，防有伤损。\n疾病：属肺与大肠，久病则凶。\n出行：不利。\n行人：未至。\n遗失：为家人隐匿难寻。\n捕获：贼在东南，音信不实，捕之无踪。\n出兵：辰上克日，夜占元武克勾，大宜谨慎。\n毕法云：初遭夹克不由己，夫妇芜淫各有私；六阳数足须公用，后合占婚岂用媒。\n心镜云：干将就子忧甲克，子近甲兮魁必侵；妻怀内喜私情有，甲子相生水合金。",
  "jiYingQian": "甲子日第五局干上戌\n课体：重审、炎上、斩关、狡童、寡宿、火局。\n脱上逢脱防虚诈，夫妇芜淫各有私。\n《预见经》曰：占逃亡，日上见天魁，为斩关卦。难追。若追逃女，责玄武阴神，天罡临申为玄武，女必往西南去了；若追逃男，责玄武阴神逆数四神，大吉临巳为阴神，其男必往东南去了。更看生旺刑害何如。\n《玉历钤》云：此课初传空亡，上下夹克，主枉图，百凡有声无实。\n《心镜歌》云：阴阳不备是芜淫，夫妇奸邪有外心。二女争男阳不足，两男共女有单阴。上之克下言夫过，反此诚为妇不仁。阳即不将阴处合，阴来阳处畏刑临。要知其例看正月，甲子时加卯课寻。甲上天魁子传送，甲夫阳也子妻阴。甲将就子忧申克，子近甲时魁必侵。支干上神交互克，是乖和睦失调琴。妻怀内喜私情有，甲子相生水合金。子上见金相生，主妻与南方人有情。\n《毕法》云：干被支上神克，支被干上神克，卦名芜淫。缘既无夫妇好合之情，必有奸邪淫洗之意。《心镜》所言是也。又白虎加午，遁鬼临戌，为祸不小。戌为初传昼夜天将皆乘六合木神夹克戌财，凡占主财不由己费用，又受人驱。木为同类，必朋友、兄弟而为忧也。\n日上生辰上，日克上神，日克用，日生三传，末克初。\n课名：重审、斩关、炎上。自墓传生，事了再发，宜占奏对。然戌既空亡，凡事宜从空散。\n又：此课占，当有喜庆和合之事。孕吉。妇人有小灾，不足忧。财吉。官不吉。婚不成，虽吉难遂。病困重不死。官司了绝再发，有刑名。干为支上神所克，名芜淫卦，占夫妇不宜。用神空亡，为孤辰卦，凡事不成。\n《义》曰：课逢空脱，党类未合。动以思礼，不容暗约。虚耗多端，时逢蹇薄。进德修业，后必裕乐。\n《象》曰：养成附凤攀龙志，动潜飞腾各有时。待得风雷相起蛰，坐看变化跃天池。\n又：此乃重审之卦。传见炎上，事主虚多实少。以未墓临亥生，所占明事，反为暗昧，又主枉图。且重审以下贼上，卑犯尊，贱役贵，事多不顺，起于女人，多是内事。阴小在下者，有悖逆之事。臣未忠，子失孝，事不可遂意而行，必当审察，循乎义理，以免后祸。《经》云：重审者，重而审之也。合后互传，有阴私厌翳不明之义。占者遇之，当见有影无形，多虚少实之象。求谋失意，干用难成，甚不可托人，亦不投谒，官非解散，灾祸不成，有欲脱不脱之义。暴病逢之即瘥，久病遇之必凶。行人未至，失物难寻。远行未利，胎孕俱空。音信不实，逃者无踪。占婚不宜，防有私暗不明。占科第徒劳用力，问身宅破耗致穷。\n占出兵行师：所报事情言辞不的，大宜酌斟研审密察，未可遽以所言为听。亦见众心不一，彼我俱未成功。虽被围绕惊险，终无所害。为将者不可不知其微妙也。大抵此课始终空脱，乃劳而无功之喻。百事不成，惟宜解散忧疑患难。吉不成吉，凶不成凶，守旧则亨利。若九流技艺僧道公门得此，白手求财，无心干事者，庶几或有成也。\n四时占之无益。\n真一山人云：行止由来本在天，功名何必苦劳牵。劝君临事休勉强，观象随时动少愆。\n《无惑钤》云：支干互克，彼各相逐。昼畏中传，亡财失仆。\n《钤解》曰：干上戌克子，支上申克甲，乃互克而相触也。午脱遁庚，昼虎可畏。初戌，财也，仆也，既为旬空，又被二木夹克，仆亡财失，所不免也。此真芜淫体也。凡占值此，不可执为芜淫卦，非专言夫妇而已，未免引此为例。如先有人相允许，后各不相顾接，似乎无情也，犹彼此各怀恶意。午遁旬内之庚，乘虎入传，至凶，纵入空乡，或系旬中空亡，亦不能解，故曰“虎乘遁鬼殃非浅”。财遭夹克，财不由己费用。",
