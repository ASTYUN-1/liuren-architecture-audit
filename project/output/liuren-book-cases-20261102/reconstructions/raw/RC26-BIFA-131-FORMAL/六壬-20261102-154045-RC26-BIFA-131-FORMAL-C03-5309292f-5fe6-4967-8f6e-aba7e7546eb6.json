  "keJing": [
    [
      {
        "key": "重审课 坤卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
      },
      {
        "key": "含义",
        "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
      },
      {
        "key": "注意",
        "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
      },
      {
        "key": "占事",
        "value": "宜后起，祸由内生。"
      },
      {
        "key": "兵事",
        "value": "用兵主胜。"
      },
      {
        "key": "占孕",
        "value": "主生女。"
      },
      {
        "key": "谋望",
        "value": "主先难后成。"
      },
      {
        "key": "诉讼",
        "value": "后者胜，对被告有利。"
      },
      {
        "key": "初传为墓绝，末传为生旺",
        "value": "灾祸消解，事终有成。"
      },
      {
        "key": "初传为生旺，末传为墓绝",
        "value": "先易后难，先得后失。"
      },
      {
        "key": "初传克末传",
        "value": "有凶兆"
      },
      {
        "key": "末传克初传",
        "value": "为吉兆，"
      },
      {
        "key": "末传天将为龙、常、阴。后、",
        "value": ""
      },
      {
        "key": "六合等吉将，或为德、喜等吉神",
        "value": "逢凶化吉。"
      }
    ],
    [
      {
        "key": "二十一、斫轮课 颐卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "卯木发用；卯木必须加庚辛或申酉发用。"
      },
      {
        "key": "含义",
        "value": "孕病凶险，财喜欢欣。禄位加增，官职仟擢。戌印、常绶遇之更乐。卯木逢初末传引从，名轩车格，有升职之喜。总之，此课主成事迟缓，或先经历艰难而后有成。"
      },
      {
        "key": "注意",
        "value": "卯加酉相冲，课逢反吟，吉庆自然大减。卯木乘白虎临申为棺椁；卯木值空亡为朽木难雕；春季名伤斧，秋季名伤轮。如果三传中有墓神，名旧轮再斫，主退失官职，再谋复兴。"
      },
      {
        "key": "官运",
        "value": "节节高升，遇到提拔，再遇戌常便更是吉象。"
      },
      {
        "key": "求财",
        "value": "可得财喜。"
      },
      {
        "key": "孕、病、讼",
        "value": "凶险之象。"
      }
    ],
    [
      {
        "key": "罗网格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干前一位为天罗煞，天罗对冲之位为地网煞。如果课发用逢天网，同时又是地网者，名天罗地网，为祸尤甚。干前一位是天罗，支前一位是地网。如果初传是干前一位，末传是支前一位，也是天罗地网格。辰为天罗，戌为地网。如果初传是辰，末传是戌，也是天罗地网格。"
      },
      {
        "key": "含义",
        "value": "主身宅俱不利，病危讼凶，谋为多拙，传中见丁马更凶。"
      },
      {
        "key": "注意",
        "value": "如果神吉将吉，末传、年命有救，仍以吉论。"
      }
    ]
  ],
  "bifa": "26.水日逢丁财动之.A.财乘丁马格.①财乘丁\n26.水日逢丁财动之.A.财乘丁马格.②财乘驿马\n35.人宅受脱俱招盗.B.鬼脱乘元格.鬼.昼玄\n37.末助初兮三等论.D.自招其祸格\n38.闭口卦体两般推.Ⅰ.玄武临地盘旬首\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干前\n55.所谋多拙逢罗网.互罗网\n69.虎乘遁鬼殃非浅.A.明暗二鬼格.干明支暗\n85.初遭夹克不由己.夜",
  "zhiZhi": "己丑日第六局干上寅\n课体：重审，斫轮，四绝，罗网。\n课义：寅卯两木，灾祸相逐，夜贵入宅，祛殃降福。\n解曰：寅加日上，卯发初传，两木并来克身，灾祸相逐，宜不可逃矣。喜夜贵在申，来临丑宅，于以制寅卯而扶己土。殃不由是而祛，福不由是而降乎。鬼助末传生干，是谓引鬼为生，亦主先凶后吉。昼占帘幕临支，士人得之亦利。\n断曰：重审之卦，格合斫轮，主先历艰难，后得成就。卯为车轮，加申为斧斤斫削。更喜戌工为印，白虎催官，土日得之，亦名流转。仕宦极为佳兆，常人不宜。\n天时：昼占主雨，夜占主风。\n家宅：必有科第，门列旗杆。\n婚姻：未成。\n胎产：不宜。\n功名：大吉，宜正取之。\n求财：不得。\n投谒：未和。\n疾病：大忌，夜虎乘卯鬼，为棺椁之象。\n失脱：远去。\n出行：赴官吉利。\n行人：在道，或遇丧车，或遇轩冕同行。\n争讼：大有忧患。\n兵战：宜慎。\n坟葬：父爻乘昼虎坐墓，主父母墓中生白蚁。\n毕法云：制鬼之位乃良医，常问不应逢吉象。\n指南：庚午年寅将，一县令占人觐考选。课得斫轮，日上天吏官德，坐于空墓，阴神酉制之，必有明暗相攻，不得翰林铨部。卯官乘元武发用，中传朱雀主言路，末传白虎主风力，必得垣中。历迁都宪，巡抚东方。宅上子孙乘帘幕贵人，又作长生学堂，当有贵子，由科甲入翰林也，后皆如言。",
  "jiYingQian": "己丑日第六局干上寅\n课体：重审、斫轮、罗网。\n众鬼虽彰全不畏。\n《玉历钤》云：此课寅申在日辰上相冲，寅中有甲与己合，乃为德神，主人情喜悦，可以用事，凡占所求皆遂。\n《毕法》云：此课干上寅木与初传卯木为日鬼，却生末传巳火以生育日干，鬼固为祸，今却为福，故云“众鬼虽彰全不畏”。又云：干上乘支前一辰谓之地网，支上乘干前一辰谓之天罗，凡得此课，身宅如罗网兜裹，不能亨快也。\n上神克日，辰上克日上，用克日。\n课名：重审、斫轮、四绝。官鬼用，日见寅为劫煞克干，防阴私欺诈官病事，君子不宜妄动、居处忌口舌临门户，恶人不可与交。然寅中有甲，甲与己合，又为德，有和合文字重重，可散忧。虎玄乃死丧、盗贼事。\n《义》曰：功曹临己，暗合为礼。丑上见申，好处生嗔。玄武克宅，盗失不绝。渐渐光亨，必蒙福德。\n《象》曰：仇化为恩祸化祥，兢兢从此自无伤。求官自喜为佳庆，只恐申来没主张。\n又：此重审之卦，一曰斫轮，亦曰天网。夫重审者，重而审之也。利为主，利后动，长有厄，事从内起，起于女人。以下犯上，贱犯贵，卑犯尊，事多不顺。阴小在下者，有悖逆之事。占臣未忠，子失孝，事不可遂意而行，必当审察，循乎义理，庶几以免后患也。传见斫轮，《经》曰：“欲知斫轮，车临斧斤。”又曰：“庚申共处为斤斧，卯木单称立作车。太冲作用来金上，斫削修轮官爵除。”天网者，即天网四张也，《经》曰“天网四张，万物被伤”，为阻滞，为疑难，为灾恼。占者遇之此课，有利求官，以其传见斫轮之谓，宜勉乎忠孝，事以正处方吉，否则难保始终也。见贵投谒，尤虑其主客之未和。占求财难得，得之亦不为美，尤防盗失，小人侵犯，惟教慎可以消弭。占婚姻勿成。占病者先重后轻，九月、十月节内占最忌可畏，年命得申酉可解。占捕盗、逃亡，宜避其凶。不利远行。占讼不吉，忧患难消。\n占出兵行师得此：昼占失物忧愁，夜占贼势猖狂，当以计处，先避其锋。大抵此课，凡占百事，先难后易之象，此又不可不知。\n真一山人云：斫轮最喜士人逢，君子占之运必丰。只为寅申不相合，谋为到处未全通。\n《无惑钤》云：寅卯二木，灾祸相逐。夜贵临宅，祛殃降福。\n《钤解》曰：寅卯并来克身，相逐而为灾祸矣。申乃夜贵临宅，克寅卯而合巳火以生己土，非祛殃除祸而何？《毕法》亦以此为“引鬼为生”。又云：昼占帘幕临宅支。",
