  "keJing": [
    [
      {
        "key": "九、伏吟课 艮卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
      }
    ],
    [
      {
        "key": "伏吟课",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
      },
      {
        "key": "含义",
        "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
      },
      {
        "key": "注意",
        "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
      },
      {
        "key": "科举",
        "value": "必定高中，求名荣归。"
      },
      {
        "key": "疾病",
        "value": "有忧，或起怪异之事。"
      },
      {
        "key": "诉讼",
        "value": "为争夺田产成家宅。"
      },
      {
        "key": "灾祸",
        "value": "春冬较浅，秋夏势危。"
      },
      {
        "key": "行事",
        "value": "律身谨慎，动作无虞。"
      }
    ],
    [
      {
        "key": "二十九、斩关课 井卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "魁罡加日辰发用，乃豹隐南山之课。"
      },
      {
        "key": "含义",
        "value": "关梁逾越，最利逃亡，捕贼难获，出行无殃。病讼凶祸，厌祷吉祥。最利隐遁逃亡。"
      },
      {
        "key": "注意",
        "value": "贵人临亥，为贵登天门。甲戊庚日贵登天门，为神藏煞没。凡占事遇之，主万事顺利，不独斩关课如此。河魁加亥，名魁度天门，主抑塞难通；天罡加寅，名罡塞鬼户，主谋为顺利；"
      },
      {
        "key": "另注",
        "value": "魁罡临日辰，传有虎阴申酉为斩关得逃者，永远不获。若带血支、血忌、呻吟、羊刃、三杀，必伤人而走。"
      },
      {
        "key": "占行",
        "value": "利于出行，逃遁，但捉贼难获。"
      },
      {
        "key": "占病",
        "value": "遇之大凶。"
      },
      {
        "key": "占讼",
        "value": "遇之大凶。"
      },
      {
        "key": "其他",
        "value": "宜于书符、合药，厌祷。"
      },
      {
        "key": "天地独通",
        "value": "逃亡出行，如有神助。"
      }
    ],
    [
      {
        "key": "三十二、三交课 姤卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四仲日占；四仲加干或支；三传皆仲神；发用乘太阴、六合；"
      },
      {
        "key": "含义",
        "value": "主交加连累，奸私隐匿，谋事不明，求财无益。讼犯刑名，兵逢强敌。乘凶将病患尤甚。再遇凶神，男犯重法，女犯私通。初传乘太阴、六合，主门户不利，有隐私事。初传乘天空，主虚诈事。乘玄武，主遗失被盗。乘螣蛇，主惊恐怪异。乘朱雀主口舌是非。乘勾陈，主厮打斗殴。乘白虎，主孝服损伤。"
      },
      {
        "key": "注意",
        "value": "太阴、六合不入传，名三交不交，占事为不及；如年月日时皆仲神，名三交不解。占事为太过。二者之凶，更甚于交。年命乘吉将，日辰发用旺相。或三传为午卯子，为高盖乘轩，皆不得以三交课论。"
      },
      {
        "key": "逃亡",
        "value": "家中隐有奸私，或自身逃匿。"
      },
      {
        "key": "求事",
        "value": "谋事不明。"
      },
      {
        "key": "求财",
        "value": "求财不得。"
      },
      {
        "key": "占诉",
        "value": "犯法而遭刑。"
      },
      {
        "key": "占兵",
        "value": "遇到强敌。"
      },
      {
        "key": "占病",
        "value": "病患更甚。"
      }
    ],
    [
      {
        "key": "五十一、龙战课 离卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "卯酉日占；卯酉（或上神）发用；占人行年立卯酉之上。三者缺一不可。"
      },
      {
        "key": "含义",
        "value": "凡事疑惑，反复不定，乃门户不宁之课也。欲行难行，欲止难止。家室分离，兄弟异居。"
      }
    ]
  ],
  "bifa": "21.交车相合交关利.B.交车合财①交财\n22.上下皆合两心齐\n22.上下皆合两心齐.D.交互六合格\n27.传财化鬼财休觅.B.因财致祸格\n30.屋宅宽广致人衰.B.狮兽冲宅格.夜虎\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n48.鬼乘天乙乃神祗.Ⅲ.昼贵在六处\n49.两贵受克难干贵.B.贵人忌惮格.夜\n52.罡塞鬼户任谋为.A.贵塞鬼户格.夜贵\n64.夫妇芜淫各有私.A.真解离卦\n69.虎乘遁鬼殃非浅.昼虎",
  "zhiZhi": "辛卯日第一局干上戌\n课体：伏吟，龙战，斩关，三交。\n课义：交合幸美，然后无礼，彼既如兹，我亦若此。\n解曰：辛干寄戌，辛即戌也。卯与戌合，上下交互相合，凡事皆美矣。既而卯木发用，传出子水，为无礼之刑。末传午来冲子破卯，彼此相为仇敌矣。毕法以卯子卯为三传。\n断曰：伏吟之卦，有屈而不伸，静而不动之象。支干上下交车相合，并地盘之支干皆作六合，所谓上下皆合两心齐也。最宜交关取财，并交涉诸事。昼占白虎乘亥，上遁丁神为鬼。如年命在亥而占此者，至凶至危，纵空亡亦不能解救。\n天时：火上水下，恐不能雨。\n家宅：夫妇甚和，家道亦丰。\n仕宦：官贵爻空，占官不吉。\n求财：昼占极吉，夜占恐多惊恐。\n婚姻：支干上下皆合，必成。\n胎产：占胎不吉，占产恐多时日。\n疾病：肾家有病，幸有良医，不久自愈。\n出行：人宅相恋，不能速行。\n行人：近者立至。\n兵战：昼占吉，夜占惊。\n毕法云：上下皆合两心齐，胎财生气妻怀孕(四月)，胎财死气损胎推(十月)。\n指南：庚辰三月，戌将戌时占生产曰：此必双胎，主八月戌日辰时产二子。何以为双胎？以月建重叠作胎神。何以为两男？以卯属震为长男。日上河魁，乾宫所属，亦男也。八月生者，酉冲卯胎。戌日辰时者，戌为养神，辰来冲戌故也。",
  "jiYingQian": "辛卯日第一局干上戌\n课体：伏吟、斩关、三交、龙战。\n《玉历钤》云：此课虽是伏吟，与常课不同。日上戌，辰上卯，戌卯为合，发用为日之财，末传为日之官，气象颇顺，凡占所求有成。\n《毕法》云：此课宅上卯木为发用，上有腾蛇，更被对邻酉金上有白虎冲克，凡占对门房屋或有眷兽来冲，或大路直冲，以致宅舍消耗，人生疾病，尤宜镇之获安。\n课名：伏吟。诸神不动。子卯相刑，占事滞中，欲动未能，宜安分。所喜三传为日财，中传为子，三传皆不为大凶。六合又为日财，见官贵吉。门户之内，防不明事，财防暗中有失。\n《义》曰：天地伏吟，暗里防嗔。末中逢解，此力殊深。占吉未吉，求成未成。不惟除病，且免忧惊。\n《象》曰：人情今古不相同，喜守规模保始终。为恶自然招恶报，吉人到底不成凶。\n又：此自信之卦，一曰龙战，亦曰三交。夫自信者，天地伏吟，十二神各归本家，天地如一，四伏未发之象。占事静则宜，动则滞，主事藏匿不动，静中求劳，有屈而不伸之象。况龙战，主人心疑惑，进寸退尺，动有乖离之象。卯酉为天之私门，生杀有限，分杜有期，雷动龙奔，示其有战。传见三交，前不能进，后不能退，交加其象。家匿阴私，或欲自逃隐避，凡事失节阻碍，谋事被人阻破，不能成合也。《经》云：“任信伏吟神，行人立至门。失物家内盗，逃者隐乡邻。病合难言语，占胎聋哑人。访人藏不出，行者却回轮。”况鬼墓加干鬼暗兴，鬼在墓中，危疑者甚，此暗中必人鬼为害，且人不能见之，尤宜谨慎，以防假名借势之侵扰也。占者遇之此课，占婚姻和合，但美中亦见有未足美者，此其子卯之刑也。占求官见贵不顺。占求财宜速取。占远行投谒人者，得失相半。占病讼大势却有解。占失脱宜寻。逃亡终见归。\n占出兵行师得此：防暗中侵袭，宜御防其患。昼占吉，夜占凶。所赖末传入于无用，却能散祸除凶，欲求成事，又未准凭也。\n谨始虑终。\n真一山人云：龙战玄黄二八门，文章未称且归村。吉凶从此浑无用，闲伴渔樵漫话论。\n《无惑钤》云：六合幸美，然后无礼。尔既如然，我亦如此。\n《钤解》曰：卯戌交合甚美，既而卯子发用入传，变为无礼之刑，午又来冲子、破卯，而彼我相为敌矣。又云：《毕法》以卯子卯为传。",
