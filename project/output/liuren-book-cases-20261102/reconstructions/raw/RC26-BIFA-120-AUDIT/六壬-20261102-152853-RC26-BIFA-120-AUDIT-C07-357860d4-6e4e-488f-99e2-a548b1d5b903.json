  "keJing": [
    [
      {
        "key": "重审课 坤卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
      },
      {
        "key": "含义",
        "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
      },
      {
        "key": "注意",
        "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
      },
      {
        "key": "占事",
        "value": "宜后起，祸由内生。"
      },
      {
        "key": "兵事",
        "value": "用兵主胜。"
      },
      {
        "key": "占孕",
        "value": "主生女。"
      },
      {
        "key": "谋望",
        "value": "主先难后成。"
      },
      {
        "key": "诉讼",
        "value": "后者胜，对被告有利。"
      },
      {
        "key": "初传为墓绝，末传为生旺",
        "value": "灾祸消解，事终有成。"
      },
      {
        "key": "初传为生旺，末传为墓绝",
        "value": "先易后难，先得后失。"
      },
      {
        "key": "初传克末传",
        "value": "有凶兆"
      },
      {
        "key": "末传克初传",
        "value": "为吉兆，"
      },
      {
        "key": "末传天将为龙、常、阴。后、",
        "value": ""
      },
      {
        "key": "六合等吉将，或为德、喜等吉神",
        "value": "逢凶化吉。"
      }
    ],
    [
      {
        "key": "六十二、间传课巽卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传相间隔一位递传。"
      },
      {
        "key": "含义",
        "value": "占事得此课，间位相传，事多间阻。"
      },
      {
        "key": "顺间传",
        "value": ""
      },
      {
        "key": "登三天格",
        "value": "三传辰午申"
      },
      {
        "key": "含义",
        "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
      },
      {
        "key": "涉三渊格",
        "value": "三传申戌子"
      },
      {
        "key": "含义",
        "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
      },
      {
        "key": "向三阳格",
        "value": "三传子寅辰"
      },
      {
        "key": "含义",
        "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
      },
      {
        "key": "出三阳格",
        "value": "三传寅辰午"
      },
      {
        "key": "含义",
        "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
      },
      {
        "key": "出户格",
        "value": "三传丑卯巳"
      },
      {
        "key": "含义",
        "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
      },
      {
        "key": "盈阳格",
        "value": "三传卯巳未"
      },
      {
        "key": "含义",
        "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
      },
      {
        "key": "变盈格",
        "value": "三传巳未酉"
      },
      {
        "key": "含义",
        "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
      },
      {
        "key": "入冥格",
        "value": "三传未酉亥"
      },
      {
        "key": "含义",
        "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
      },
      {
        "key": "凝阴格",
        "value": "三传酉亥丑"
      },
      {
        "key": "含义",
        "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
      },
      {
        "key": "溟濛格",
        "value": "三传亥丑卯"
      },
      {
        "key": "含义",
        "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
      },
      {
        "key": "（二）逆间传",
        "value": ""
      },
      {
        "key": "冥阴格",
        "value": "三传寅子戌"
      },
      {
        "key": "含义",
        "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
      },
      {
        "key": "悖戾格",
        "value": "三传戌申午"
      },
      {
        "key": "含义",
        "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
      },
      {
        "key": "顾祖格",
        "value": "三传午辰寅"
      },
      {
        "key": "含义",
        "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
      },
      {
        "key": "极阴格",
        "value": "三传丑亥酉"
      },
      {
        "key": "含义",
        "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
      },
      {
        "key": "时遁格",
        "value": "三传亥酉未"
      },
      {
        "key": "含义",
        "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
      },
      {
        "key": "励明课",
        "value": "三传酉未巳"
      },
      {
        "key": "含义",
        "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
      },
      {
        "key": "回明格",
        "value": "三传未卯巳"
      },
      {
        "key": "含义",
        "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
      },
      {
        "key": "转悖格",
        "value": "三传巳卯丑"
      },
      {
        "key": "含义",
        "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
      },
      {
        "key": "断间传格",
        "value": "三传卯丑亥"
      },
      {
        "key": "含义",
        "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
      }
    ]
  ],
  "bifa": "02.首尾相见始终宜.B.回环格\n06.六阴相继尽昏迷.A.六阴格\n24.我求彼事干传支\n36.干支皆败势倾颓.A.破败神临宅格.在支\n37.末助初兮三等论.Ⅲ.作干财\n43.害贵讼直作屈断.Ⅳ.白虎投朱雀，朱雀投勾陈\n44.课传俱贵转无依.Ⅰ.课俱贵\n44.课传俱贵转无依.Ⅱ.传俱贵\n45.昼夜贵加求两贵\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干前\n48.鬼乘天乙乃神祗.Ⅲ.昼贵在六处\n52.罡塞鬼户任谋为\n69.虎乘遁鬼殃非浅.昼虎",
  "zhiZhi": "丁亥日第十一局干上酉\n课体：重审，间传，极阴。\n课义：自用传辰，礼下于人，财为破碎，妻婢伤身。\n解曰：干传干支，盖我有求于彼，自不得不礼下于人也。干上发用两酉，妻婢之象，乘破碎金煞，且火死于酉，绝于亥。丑加亥为遗泄，必因妻婢以丧败其身也，占者可以知所戒矣。占人年命在申，贵人拱定，必得两贵成就其事。日上见财，主妻不安，财不聚，末助初财，占婚尤的。丑加亥，夜乘太常，凡有求望，必涉水过桥。\n断曰：重审之卦，贵人差迭，凡事少喜多嗔。三传又名极阴，而逢间传，进中有阻，事体不甚明白。\n天时：主晴。\n家宅：间传凝阴，昏滞酒色，若年命上乘阳明之神，便可转凶为吉。\n功名：功名顺利，初时不无所费。\n求财：宜得贵人之财，但有分耗之者。\n谒贵：宜专心归一，莫使尖担两头脱。\n婚姻：可成，美而且贤，且日后家道隆盛。\n胎产：女孕，亦易产。\n求谋：百事可成。\n疾病：泄泻虚痨之症，求西北方医之则吉。\n出行：水陆皆通，前途无碍。\n行人：即归。\n逃亡：自归。\n兵战：无意于争，终归和解。\n毕法云：昼夜贵加求两贵，我求彼事干传支，鬼乘天乙乃神祇。\n古鉴：亥生人，五月申将加午占前程，曰:破碎加干，必因费财得官。九丑在宅，主淫乱。在本命，主贪色。末传又见丑作阴加在官星。太阴者，阴晦也，当因色而死。",
  "jiYingQian": "丁亥日第十一局干上酉\n课体：重审、六阴、凝阴\n又：此课日干丁火克酉金，乃妻也，财也，酉为破碎，大端费财。中传官星，又加破碎之上，三传日辰遍地贵人，主簿此任，须多差使，兼权摄，然贵人多，则委任不一。凡九丑在宅，主淫乱：在本命上，贪色。太阴者，阴晦也，因色而死。末传又见丑，作阴，加在官星上，次任在县令而死。勋（不知是否指程树勋，若是，则此抄本当是清代有程树勋注释的传抄本）曰：“九丑日，必是大吉加干，干支乃为全体，故此云丑字加支，为九丑也。”毛主簿本命亥占官，巨富，受妻恩泽，大有所费，日上破碎，缘此结识四方士大夫。及赴主簿任，尽是家中将钱去用，计会官府求升，费用无限钱，在任委送差使，更不曾停。任满得明州象山县令。其家果淫乱，自幼好色，偏于婢妾。乙卯年赴象山任，得一年零三个月而卒。乙卯年，卯上有巳，却会起巳酉丑，合起破碎、九丑，日上酉为丁日死神，兼与中传亥为丁日绝神相冲，冲起绝神，死与绝会，所以死也。先生每嫌遍地贵人，用事不一，托事不成，又怕年命上会起绝神，况丁亥日有酉有丑，只欠一巳也，行到卯年，则巳全矣，冲亥，所以死也（《壬占汇选》作：戊申年五月初四，丁亥日申将午时，毛主薄乙亥生，三十四岁占前程）。\n《玉历钤》云：此课虽有财神，传中亥水乃丁神所恶，凡事无成。\n《中黄经》占云：此课主阴谋之事，有西北黑妇人，诱引东北一俊俐妇，同来相害。何以言之？盖初传丁上酉，中传亥加酉，末传丑加丁亥，亥水为鬼，故主阴谋之事也。中传亥克今日丁干，亥为妇人，又主邪淫，又临酉为黑丑，上有大吉，亦为妇人，其方东北，上乘卯木，亥临西，西遁有己制亥，却生亥不起，俱自刑，亥又败于酉，自刑自败，黑丑之象。末传大吉，亦为丁盗气，附亥，亦克丁干，大吉无刑破，故俊俐，所以与亥同来害丁也（《中黄经》作：假令正月将，丁亥日酉时）。\n《毕法》云：此课初传从干上起，末传归于支上，为我求彼之象，凡事勉强，不免俯就于人，为人轻藐，不得扬眉吐气以奋伸也，唯君子卑以自守，则卑而不可喻也。\n《神定经》云：此课末传丑土生初传西金，是助初为日干之财，凡占必有以财相助如尧夫者。\n日克上神，辰上生日上，日克用。\n课名：重审、间传。二贵入传，占用必再三方成。丁日西金为财，财自外来，丁西为口舌变异不常，重求再索有利。三传天将若有阴德，助始日中辰两贵，传是喜末菇初合，得圆明有声物。\n《义》曰：贵人差迭，事难安贴。满眼贵人，少喜少嗔。传见极阴，昏暗相侵。意欲明白，未得相临。\n《象》曰：酉亥丑为进间传，进中有隔又缠绵。文书口舌词章见，破碎为财亦可嫌。\n又：此重审之卦。夫重审者，重而审之也。利为主，利后动，长有厄，事从内起，起于女人。以下犯上，贱犯贵，卑犯尊，事多不顺。阴小在下者，有悖逆之事。占臣未忠，占子失孝，事不可遂意而行，必当审察，循乎义理，庶几以免后患也。《经》云：“一下贼上名重审，子逆臣乖弟不恭。事起女人忧稍重，防奴害主起妻纵。万般作事皆难称，灾病相侵恐复重。诉讼对之伸理吉，先讼之人却主凶。”日上见财，妻美而能言，又主不安，财不聚。此进间传，进中有隔，隔而复进，是非口舌文书以应之。夫财为破碎者，言破财之理，或财不聚，或妻婢不安，正如前说。然破财未免不准，亦有失而复得之象。此课多是人来求我之象（当作我去求人之象），或事因外来方准。求官见贵人重叠，事有不一，参差不齐，却因我去干谒他人，号曰“主宾际会两殷勤，暮晏朝欢会无极”也。占病有隔。占失脱者，失此得彼。占逃亡自归。占行人，有信临门。\n占出兵行师得此：举事多言词，虑军戎见耻，或有阻隔，夜占却有开地千里之功。敌使之来，无益于我兵，亦不能害我事。如此之论，又未见其丰功伟绩。\n人情和，事有阻。\n真一山人云：失而后得不须忧，暗里求谋福自优。临课留心宜熟玩，主宾际会乐悠悠。\n《无惑钤》云：自日传辰，礼下求人。财为破碎，妻婢伤身。\n《钤解》曰：自干传支，我求彼事，未免为人抑勒，宜卑屈于人也。干上及发用两酉，是婢妾之象也。况乘破碎金煞，且丁火死于酉，绝于亥。酉为酒，丑为腹，丑加亥为遗泄，必因酒色以伤其身也。《集议》：“我求彼事干传支”内列此日。占人命在申，两贵拱定。丑加亥，夜太常，求望必涉水过桥。昼贵夜贵，加于两贵。末助初财，来意占婚尤的。“末助初兮三等论”内列此日。丁亥日，酉加于丁，为双丁插目煞，大不利争讼，主贵人咄目，反不相悦也。",
