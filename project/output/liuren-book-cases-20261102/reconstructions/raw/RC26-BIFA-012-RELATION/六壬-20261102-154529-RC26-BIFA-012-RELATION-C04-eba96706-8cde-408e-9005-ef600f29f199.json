  "keJing": [
    [
      {
        "key": "九、伏吟课 艮卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
      }
    ],
    [
      {
        "key": "伏吟课",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
      },
      {
        "key": "含义",
        "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
      },
      {
        "key": "注意",
        "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
      },
      {
        "key": "科举",
        "value": "必定高中，求名荣归。"
      },
      {
        "key": "疾病",
        "value": "有忧，或起怪异之事。"
      },
      {
        "key": "诉讼",
        "value": "为争夺田产成家宅。"
      },
      {
        "key": "灾祸",
        "value": "春冬较浅，秋夏势危。"
      },
      {
        "key": "行事",
        "value": "律身谨慎，动作无虞。"
      }
    ],
    [
      {
        "key": "自信格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课无克，日干为阴者，取支上神为初传，名自信格。"
      },
      {
        "key": "含义",
        "value": "诸事动则不成，家庭不安。潜藏隐匿，身不由己。逃亡离家者可在附近寻觅。盗贼为内贼，失物也在附近。占病者不能言语，占行人停止不前。三传见兄弟，逢恶将有别离之兆。"
      },
      {
        "key": "注意",
        "value": "神将凶，日干休囚为凶。神将吉，日干用神旺相则吉。"
      },
      {
        "key": "藏伏",
        "value": "主潜藏伏匿，自身得不到自由。"
      },
      {
        "key": "逃亡",
        "value": "如有逃亡者在近处寻找。黄强动民"
      },
      {
        "key": "盗贼",
        "value": "发生盗贼在内部搜索，失物在附近。"
      },
      {
        "key": "占病",
        "value": "病人声音暗哑。"
      },
      {
        "key": "行人",
        "value": "出门在外淹留停滞。"
      },
      {
        "key": "行事",
        "value": "自身谨慎恪守规则，都会悠然自得。"
      }
    ],
    [
      {
        "key": "杜传格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课无克，自刑发用，名杜传格。阳日中传取支上神，阴日中传取干上神。中传又为自刑者，末传取中传所冲之辰。"
      },
      {
        "key": "含义",
        "value": "居者将移，合者将离，中道而废。三传为纯阳，等人必来；三传纯阴，等人不来。三传见驿马、天马，主静中有动，待人、通讯来速。三传见勾陈，主有屈难伸，动静不宜。三传子午俱全，恐有文章或车祸事。卯酉俱全者，家生变故。"
      },
      {
        "key": "注意",
        "value": "日辰和用神旺相，神将皆吉，亦以吉论。"
      },
      {
        "key": "家宅",
        "value": "主居所变更，相合者将分离。"
      },
      {
        "key": "占事",
        "value": "行道中途而止，事情宜有所变动。"
      },
      {
        "key": "行人",
        "value": "三传为纯阳，等人必来，三传为纯阴，等人未归"
      },
      {
        "key": "走失",
        "value": "下客寻人求物，都在家院之中。"
      }
    ],
    [
      {
        "key": "二十九、斩关课 井卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "魁罡加日辰发用，乃豹隐南山之课。"
      },
      {
        "key": "含义",
        "value": "关梁逾越，最利逃亡，捕贼难获，出行无殃。病讼凶祸，厌祷吉祥。最利隐遁逃亡。"
      },
      {
        "key": "注意",
        "value": "贵人临亥，为贵登天门。甲戊庚日贵登天门，为神藏煞没。凡占事遇之，主万事顺利，不独斩关课如此。河魁加亥，名魁度天门，主抑塞难通；天罡加寅，名罡塞鬼户，主谋为顺利；"
      },
      {
        "key": "另注",
        "value": "魁罡临日辰，传有虎阴申酉为斩关得逃者，永远不获。若带血支、血忌、呻吟、羊刃、三杀，必伤人而走。"
      },
      {
        "key": "占行",
        "value": "利于出行，逃遁，但捉贼难获。"
      },
      {
        "key": "占病",
        "value": "遇之大凶。"
      },
      {
        "key": "占讼",
        "value": "遇之大凶。"
      },
      {
        "key": "其他",
        "value": "宜于书符、合药，厌祷。"
      },
      {
        "key": "天地独通",
        "value": "逃亡出行，如有神助。"
      }
    ]
  ],
  "bifa": "22.上下皆合两心齐\n22.上下皆合两心齐.D.交互六合格\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n49.两贵受克难干贵.A.白虎或乘临丑格.夜\n61.干乘墓虎无占病.昼虎不临干\n66.支坟财并旅程稽\n70.鬼临三四讼灾随\n75.宾主不投刑在上.Ⅰ.一字刑.四课全自刑\n75.宾主不投刑在上.Ⅰ.一字刑.干支全自刑",
  "zhiZhi": "乙酉日第一局干上辰\n课体：伏吟，自信，斩关，杜传。\n课义：可与交关，众鬼相攒，合中有祸，奴婢欺瞒。\n解曰：辰与酉合，干支上下交车相合，彼此齐心，故曰可与交关也。酉居旺地，临宅之阴阳，又入中传，群相攒结，以作日鬼，虽与干合，而合中有克也。酉为婢女，昼乘元武，夜乘天后，末传更入私门，故主奴婢有奸欺之事。\n断曰：此伏吟自信之卦，凡事伏匿不动，隐而未发，自信其柔，以与世接，静以待动也。斩关发用，不获安居。天罡作财，财强身弱。鬼生盗阴，主有重重耗失。反喜末传坐空，事当改变，可于凶中化吉，不必忧怯。\n天时：宿雾重阴，遇风而解。\n家宅：不宁，防有奸私逃拐之事。\n婚姻：不用。\n胎产：主生女。\n功名：非正途，或有官无禄。\n求财：羊刃作财，求之得祸。\n投谒：主客面和心背。\n疾病：绝食者凶，暴病有解。\n失脱：宜寻家中，婢女所窃。\n出行：不利远行。\n行人：未至。\n争讼：宜和息。\n兵战：少快利。\n毕法云：上下相合两心齐，任信丁马须言动。\n课经云：用起自刑，中投支上，复自刑。末取冲，传行杜塞，名杜传格，事主中止改图。\n指南：丁丑年酉将占六甲。宅上酉神，侧室怀孕。双勾乘罡发用，必是双胎，一男一女。酉为兑，作胎鬼死气；卯为震，作支胎生气。男必生，女必死也，果验。",
  "jiYingQian": "乙酉日第一局干上辰\n课体：伏吟、斩关。\n凶神恶将，持刃带刑，蓄而未散。禄逢克害，不足倚势，主家宅暗昧，阴私争竞，病困难安，望事不成，惟宜谨守身财，稍可安济。又干支自刑，妄自尊大。勾陈乘日发用，凡事自寻则自受，勾连牵扯，非干他人也（原抄本无此段文字，今据《玉历钤》补足）。\n日克上神，日克用，末克初。\n又：此课名伏吟。本自诸神不动，但凶神恶将在卯酉门户，持刃带刑，家宅防暗昧争竞。暮贵凶变为喜，龙在末也。但二贵皆凶，而各归位，受日克。传遇合，终和。末卯为日禄，虽为酉冲、害乙辰，毕竞我胜。\n《义》曰：身弱财丰，鬼生盗隆。家宅不利，耗食重重。勾留屈抑，有始无终。凶中化吉，末后传空（旧法辰戌未，用此断）。\n《象》曰：古来澹泊是寻常，勉强贪图重祸殃。知足自然还见足，屈伸从此识柔刚。\n又：此自信之卦，亦曰斩关。夫自信者，天地伏吟，十二神各归本家，天地如一，四伏未发之象。占事静则宜，动则滞，主事藏匿不动，静中求劳，有屈而不伸之象。传见斩关，非安居之象，占者多不自由，暗昧不和，离散口舌，欲隐身避难者，却利乎奔逃也。又主人情暗中不顺，多见更改，事多中止，坟墓破坏，占婚亦强成，难于久远。凡事历遍艰辛，然后可成。占者遇之此课，求官见贵，主客不和，有始无终。占病凶重，幸有解，虽危不妨。占失物宜寻，迟则难获。远行未利。占讼宜和解，勾留缠惹，到底有释，但迟滞未通。逃盗勿捕，虑恐有伤，或生恼不顺。占交易不成。占投谒人者，主多不喜。占宅耗盗，人口不宁，宜更改吉。\n占出兵行师得此：昼夜所占，皆不利乎战事，大宜慎之。况利为主，不利为客，利后动，不利先举。大抵此课，不利占事成，惟利占解散，难于前而易于后。夫兵者，不祥之事，不得已而用之，不过翦除祸乱，安请生民。为将者宜权变，不拘其法，则致胜克敌必矣。\n事防再变。\n真一山人云：回首方知远名利，事当变改莫忧惊。安心顺理终招吉，要识前程与后程。\n《无惑钤》云：可以交关，酉鬼双攒。宅中奴婢，必定欺瞒。\n《钤解》曰：辰合酉，酉合辰，可谓交关和合也。酉日鬼，临宅人传，是谓双攒。酉又婢属，并临支之阴阳，两婢也，乘玄后暗昧之神而克干，其欺瞒又何如其甚也！《集议》：酉鬼自居旺方，干支上全逢自刑。此课如占人年命值亥，乃丁马交加，占身动尤速。",
