  "keJing": [
    [
      {
        "key": "重审课 坤卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
      },
      {
        "key": "含义",
        "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
      },
      {
        "key": "注意",
        "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
      },
      {
        "key": "占事",
        "value": "宜后起，祸由内生。"
      },
      {
        "key": "兵事",
        "value": "用兵主胜。"
      },
      {
        "key": "占孕",
        "value": "主生女。"
      },
      {
        "key": "谋望",
        "value": "主先难后成。"
      },
      {
        "key": "诉讼",
        "value": "后者胜，对被告有利。"
      },
      {
        "key": "初传为墓绝，末传为生旺",
        "value": "灾祸消解，事终有成。"
      },
      {
        "key": "初传为生旺，末传为墓绝",
        "value": "先易后难，先得后失。"
      },
      {
        "key": "初传克末传",
        "value": "有凶兆"
      },
      {
        "key": "末传克初传",
        "value": "为吉兆，"
      },
      {
        "key": "末传天将为龙、常、阴。后、",
        "value": ""
      },
      {
        "key": "六合等吉将，或为德、喜等吉神",
        "value": "逢凶化吉。"
      }
    ],
    [
      {
        "key": "十八、龙德课 萃卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "太岁和月将相同；太岁（月将）乘贵人发用；"
      },
      {
        "key": "含义",
        "value": "君恩及下，万民欢欣。罪囚出狱，财喜临身。名利易遂，争讼休陈。官职拔擢，利见大人。总之利卑下求贵，吉庆重重。"
      },
      {
        "key": "注意",
        "value": "不利尊贵求卑下，再带凶煞、日鬼，决非吉庆。"
      },
      {
        "key": "占事",
        "value": "进财，并有喜事，富贵两全。"
      },
      {
        "key": "占孕",
        "value": "生得贵子。"
      },
      {
        "key": "婚姻",
        "value": "男子娶亲配美丽女子。"
      },
      {
        "key": "诉讼",
        "value": "可占理而先。"
      },
      {
        "key": "谋望",
        "value": "心中谋划之事可遂，谋望更胜于前。"
      }
    ],
    [
      {
        "key": "六十二、间传课巽卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传相间隔一位递传。"
      },
      {
        "key": "含义",
        "value": "占事得此课，间位相传，事多间阻。"
      },
      {
        "key": "顺间传",
        "value": ""
      },
      {
        "key": "登三天格",
        "value": "三传辰午申"
      },
      {
        "key": "含义",
        "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
      },
      {
        "key": "涉三渊格",
        "value": "三传申戌子"
      },
      {
        "key": "含义",
        "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
      },
      {
        "key": "向三阳格",
        "value": "三传子寅辰"
      },
      {
        "key": "含义",
        "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
      },
      {
        "key": "出三阳格",
        "value": "三传寅辰午"
      },
      {
        "key": "含义",
        "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
      },
      {
        "key": "出户格",
        "value": "三传丑卯巳"
      },
      {
        "key": "含义",
        "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
      },
      {
        "key": "盈阳格",
        "value": "三传卯巳未"
      },
      {
        "key": "含义",
        "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
      },
      {
        "key": "变盈格",
        "value": "三传巳未酉"
      },
      {
        "key": "含义",
        "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
      },
      {
        "key": "入冥格",
        "value": "三传未酉亥"
      },
      {
        "key": "含义",
        "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
      },
      {
        "key": "凝阴格",
        "value": "三传酉亥丑"
      },
      {
        "key": "含义",
        "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
      },
      {
        "key": "溟濛格",
        "value": "三传亥丑卯"
      },
      {
        "key": "含义",
        "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
      },
      {
        "key": "（二）逆间传",
        "value": ""
      },
      {
        "key": "冥阴格",
        "value": "三传寅子戌"
      },
      {
        "key": "含义",
        "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
      },
      {
        "key": "悖戾格",
        "value": "三传戌申午"
      },
      {
        "key": "含义",
        "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
      },
      {
        "key": "顾祖格",
        "value": "三传午辰寅"
      },
      {
        "key": "含义",
        "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
      },
      {
        "key": "极阴格",
        "value": "三传丑亥酉"
      },
      {
        "key": "含义",
        "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
      },
      {
        "key": "时遁格",
        "value": "三传亥酉未"
      },
      {
        "key": "含义",
        "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
      },
      {
        "key": "励明课",
        "value": "三传酉未巳"
      },
      {
        "key": "含义",
        "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
      },
      {
        "key": "回明格",
        "value": "三传未卯巳"
      },
      {
        "key": "含义",
        "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
      },
      {
        "key": "转悖格",
        "value": "三传巳卯丑"
      },
      {
        "key": "含义",
        "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
      },
      {
        "key": "断间传格",
        "value": "三传卯丑亥"
      },
      {
        "key": "含义",
        "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
      }
    ]
  ],
  "bifa": "25.金日逢丁凶祸动.A.火鬼蛇雀克宅格.昼\n30.屋宅宽广致人衰.B.狮兽冲宅格.昼虎\n32.三传互克众人欺.C.雀鬼格.①.昼贵\n38.闭口卦体两般推.Ⅰ.玄武临地盘旬首\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n63.彼此全伤防两损\n64.夫妇芜淫各有私\n69.虎乘遁鬼殃非浅.夜虎\n74.空空如也事休追.夜空\n76.彼此猜忌害相随.Ⅴ.干支上下交互作六害",
  "zhiZhi": "戊辰日第三局干上卯\n课体：重审，间传，极阴，龙德。\n课义：彼己受克，丁马身宅，夜传皆陷，静躁无益。\n解曰：卯丁克日，寅马克宅，是为彼己俱伤。虽曰丁马宜动，如此动之，何益也。用神乘天空，中传旬空，末传坐空，三传俱陷，躁固有失，静亦无得。然静守虽无所益，不愈于妄动生灾乎。\n断曰：此重审之卦，又名间传，动多阻滞。所喜初传乘空，譬若阴暗弥漫，忽得好风吹至，拨云雾而睹青天也。\n天时：重阴，得风而解。\n家宅：门户阻塞，丁多而贫。\n婚姻：女长于男，昼占吉。\n胎产：生女不实。\n功名：未遂。\n求财：虚。\n疾病：伤脾胃之症，无妨，久病危。\n交易：须见参差，宜忍。\n出行：东方吉。\n行人：还家。\n争讼：田土口舌，文书惑乱。\n兵战：昼占吉，夜占凶。\n坟墓：局合三奇，发丁发贵，宜多种松楸。\n毕法云：支干全伤防两损，用破身心无所归，夫妇芜淫各有私。\n课经订讹云：鬼临墓为得地，引类呼朋，故名鬼呼。\n古鉴：戊申六月未将酉时，占家宅曰：戊辰干支，丑又为土，加于卯门，主有土塞东边门。干上得卯，支上得寅，寅卯六月入墓，为死木，主壁外有两棺。末传酉加亥为败地，乘太阴为老妇，主以酒病死。丑亥酉名为极阴，惟传空可解。然亦主家道消索，俱验",
  "jiYingQian": "戊辰日第三局干上卯\n课体：重审、极阴、三奇。\n不行传者考初时，彼此全伤防两损。\n又：此课先生云：丑亥酉课名极阴，甲子旬中末皆空亡，不是入阴，不至灾危不测，只是门户事多，子孙繁众，下稍自消折财本，晚年不如意而死。不合用土塞东门，东门之外不合叠棺木板。太阴西加亥，西作酒，亥败处乘空，母主酒病而死。自死之后，家内便退矣。叶宅东边有门，果有泥。乃戊辰支干皆土，丑为土，加于卯门之上，故门有泥塞之。壁外两具棺木，来克戊辰土，故令去之。先生每怕丑亥酉，名极阴，凡事皆主变生灾至，只要中末空亡可解，遂不入亥地极阴之处，虽不至狂灾不测，毕竞阴消财物。看来传内无子孙，末传虽酉乃空亡，却云为子孙繁多者，何也？戊辰一带皆是东方，丑寅卯未得本方之旺气。甲子句中乙丑、丙寅、丁卯真三奇，所以无灾。其势不合退归西北，见酉而土败，本于此绝。三奇本于此而应，日月星辰倾归西北自然消磨也。辛亥年其母酒病而死。男女七人，婚姻所费，道路不行，果消磨其本钱也（《六壬口鉴》作：叶某庚戌生五十九岁占宅，建炎戊申年六月戊辰日未将西时）。\n《玉历钤》云：七百二十课，凡丑加卯为用，天将虽不同，大抵皆不为吉。\n《毕法》云：此课干上卯克戊，支上寅克辰，干支各被克伐，凡占必人宅各有克伤，占身被人欺害，占宅被人损坏。\n上神克日，日上克用。\n课名：重审、间传，又名杜塞。初传闭塞，日辰受伤，中亥虽财乃空亡，末酉与干三合，然又落空无益，所谓吉凶皆无成也。\n又：此课贵人复位，始凶终吉。若谓六壬七百二十课内，凡课遇丑加卯为用，天将虽不凶，亦不为吉课。占病难瘥，其他求望皆不利，惟丙丁日占之稍吉。其说在丙丁日，丑加卯也。日辰三传俱为吉，昼朱雀值日顺，暮勾得生暮鬼，虽生必死。\n《义》曰：当门抬土，动用多阻。所幸逢空，以释愠怒。格名间传，阴暗弥漫。\n《象》曰：贵吏升迁小吏速，吉凶何必问于神。但将心事闲评论，善恶分明不诬人。\n又：此重审之卦，一曰励德，一曰龙战。夫重审者，重而审之也。以下犯上，卑犯尊，贱役贵，事多不顺，起于女人。阴小在下者，有悖逆之事。占臣未忠，子失孝，事不可遂意而行，必当审察，循乎义理，庶几以免后患也。况见励德，阴小在下者有灾，一名关隔神，常人占此，身宅不安，宜谢土神，贵吏则主升迁，要当消息而论。夫龙战者，主人心疑惑，进寸退尺，动有乖离之象。卯酉为天之私门，生杀有限，分杜有期，雷动龙奔，示其有战也。占者遇之，身宅俱有动摇之象，求官见贵未足为佳，初虽得意，终见交加相害。占婚者难得谐老，求财者多费咨嗟。千里求人，徒费粮裹。一生占事，到底虚花。欲问远行，不如不动。若问行人，未见还家。占逃亡，有自归之理，目下未准。占交易，须见争，差忍之和好。大抵此课，占之者当有口舌文书之扰。若占疾病，有伤脾胃，不然则气逆吐呕，防其再发，终无大咎，亦见先重后轻之象，久病危。\n占出兵行师：昼占有开地千里之功，夜占有口舌诡谲欺诈之象，惟其传人脱空之乡，功绩不能全其美也。愚谓正如“苗而不秀，秀而不实”，却利乎解散忧疑患难，其他诸占，有损有益，惟君子贞吉。\n极阴不实，昏暗无成。\n真一山人云：积雪成山儿仞余，美人瞻望未称奇。云开日暖寒风静，和气融融化坦夷。\n《无惑钤》云：人已受克，丁马身宅。夜传皆陷，静躁无益。\n《钤解》曰：卯丁克日，寅马克宅，彼己俱伤，虽曰丁马宜动，动何益也？用神乘空，中末俱陷，三传无气，虽曰极阴宜静，静何益也？然守虽无益，犹愈于动之生祸也。《集议》：雀鬼加干，朝官防遭章劾，上书献策反被责黜。又云：宅上寅为内鬼呼。“彼此全伤”见甲子日第六课。“极阴”义见前丙寅日内。不行传。申乘白虎冲支寅，为对邻兽头冲其本家，以致家道衰替。“芜淫”说见甲子日第五课。",
