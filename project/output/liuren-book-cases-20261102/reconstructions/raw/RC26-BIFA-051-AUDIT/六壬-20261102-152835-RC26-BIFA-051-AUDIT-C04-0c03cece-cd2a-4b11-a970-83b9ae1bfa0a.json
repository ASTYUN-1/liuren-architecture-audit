  "keJing": [
    [
      {
        "key": "九、伏吟课 艮卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
      }
    ],
    [
      {
        "key": "伏吟课",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
      },
      {
        "key": "含义",
        "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
      },
      {
        "key": "注意",
        "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
      },
      {
        "key": "科举",
        "value": "必定高中，求名荣归。"
      },
      {
        "key": "疾病",
        "value": "有忧，或起怪异之事。"
      },
      {
        "key": "诉讼",
        "value": "为争夺田产成家宅。"
      },
      {
        "key": "灾祸",
        "value": "春冬较浅，秋夏势危。"
      },
      {
        "key": "行事",
        "value": "律身谨慎，动作无虞。"
      }
    ],
    [
      {
        "key": "自任格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课，上下无克。日干为阳干，日上神为用，名自任格。"
      },
      {
        "key": "含义",
        "value": "刚愎自用，崭露头角后即有闭塞之兆。凡事过分，易招过失。等人立至，离家逃亡者可在附近寻获。孕产废婴。若占事，祸患会连续发生。三传中见驿马，主待时而动，或不得已而动，亦主动中有成。访人不遇，家中不安，恐有哭泣和离别事。"
      },
      {
        "key": "注意",
        "value": "日辰发用旺相，再乘吉将，仍以吉论。"
      },
      {
        "key": "占事",
        "value": "做事刚烈暴躁，易成过失。"
      },
      {
        "key": "行人",
        "value": "等人将至，逃亡者就在附近。"
      },
      {
        "key": "占孕",
        "value": "不吉，产废晏。"
      },
      {
        "key": "灾锅",
        "value": "祸患留连。"
      },
      {
        "key": "干谒",
        "value": "不宜出门干谒他人，守株待兔方为吉。"
      }
    ],
    [
      {
        "key": "六十、元胎课 家人卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
      },
      {
        "key": "含义",
        "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
      },
      {
        "key": "注意",
        "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
      }
    ],
    [
      {
        "key": "绝胎格",
        "value": "元胎课逢反吟，虽开花但不结子。"
      }
    ],
    [
      {
        "key": "病胎格",
        "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
      }
    ],
    [
      {
        "key": "生胎格",
        "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
      }
    ],
    [
      {
        "key": "蓦越格",
        "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
      }
    ]
  ],
  "bifa": "26.水日逢丁财动之.A.财乘丁马格.②财乘驿马\n38.闭口卦体两般推.Ⅰ.玄武临地盘旬首\n38.闭口卦体两般推.Ⅱ.玄武乘旬首\n40.后合干支岂用媒.Ⅱ.夜.干上后，支上合\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干后\n62.支乘墓虎有伏尸.支墓临支\n69.虎乘遁鬼殃非浅.夜虎\n75.宾主不投刑在上.Ⅲ.三字刑\n89.任信丁马须言动.乘马",
  "zhiZhi": "庚辰日第一局干上申\n课体：伏吟，自任，元胎。\n课义：空禄宜舍，去乘财马，官鬼长生，须分真假。\n解曰：申为日禄，既系旬空，又乘昼虎，不宜守也。舍而之中传，既为日财，又为辰马，足可乘矣。末传巳本长生，然夜乘朱雀，为克我之将，是长生而官鬼也。必昼乘勾陈，实有以生我者，方是长生。中有真假之分，可不辨乎。\n断曰：此伏吟自任之卦，三传皆孟。利上不利下，利远不利近。伏匿不动，触则成咎。占者守正修德则亨。孤辰发用，多虚少实，改动为宜。虎旺金乡，勾陈捧印，螣蛇生角，考试仕宦皆吉。\n天时：有孟雨之状，得风辄散。\n家宅：安静，昼占防虚惊，夜占防妇女口舌。\n婚姻：不宜。\n胎产：占胎，日上神乘虎克胎神，防堕，占产即生。\n功名：申月巳将占者荣贵，余不过虚喜。\n求财：所得细微。\n疾病：不妨，老人及小儿忌。\n失脱：难寻。\n出行：有阻。\n行人：近者即至，远者回轮。\n争讼：惊忧易解，患难易消。\n兵战：有更变失众之象。\n毕法云：宾主不投刑在上，后合占婚岂用媒。\n课经云：丑是旬丁，因父母之墓田而凶动。\n古鉴：丁巳生人，戊申年子将占武职曰：武职主兵，金旺为宜。今天地盘之申俱空，太常不上传，武五位而禄虚，非吉占也。幸寅上青龙入庙，巳上朱雀为本命长生、官星学堂，改文必显，果以己酉庚戌联捷。",
  "jiYingQian": "庚辰日第一局干上申\n课体：伏吟、玄胎、孤辰。\n又：此课先生曰：“将仕之禄虚矣，止可遥受，不宜赴任。夫武职，兵权也，唯要金全盛，倘无威就力，何以武为？但此任必不赴，必改岳庙之职，就岳中却好赴试，必有请解之理，高中可以换文选也。”众人叹曰：“五十二了，不甚读书，尚望助功名乎？”先生又曰：“无武有文，故宜换文，又有学堂，故可助功名耳。”赵遂看文字，次年发解，庚戌年第二甲二十一名也。赵将仕不喜广南任，二月遂换潭州南岳庙，邀故友同看文字。己酉秋国子监中举，庚戌登科。况庚禄在申，甲戌旬禄空，天后主恩泽。所谓宜换文者，乃功曹作青龙是也。太乙为朱雀，一乃长生，二乃官星、学堂，故主科\n第。盖本身天地二盘皆申，申属金，金武职，武职既空，如何用得？宜讨岳庙。宅上见辰为山岗，寅为岳庙，故宜讨岳庙。岳庙中宜取功名，是末传后受长生、学堂也（《壬占汇选》作：已酉年正月初一庚辰日子将子时，赵将仕丁已命，生于六月初七日亥时，五十二岁占武职前程）。\n同日将子时，唐十一承务占一年事。此课乃当日唐承务占岁课，先生曰：“主汝丧妻之后，继得妻，主妻有财，后因店事成讼，凡有四人遭杖责，主尊长争厨屋地基。”其人当年三月丧妻，十一月再娶，乃客人之妻，甚有钱物，遂开店。次年七月，与叔争屋地基。又与原债人相打，官司嗔怪，不合聚集群党，四人各杖一百。其屋基相讼，主上司得理（同年月日时，唐承务占一年事，亦得此课）。\n《玉历钤》云：此课发用空亡，凡百无成，伏吟末克日上，占行人望信即至。上神德日，辰上生日上，末克初。\n课名：伏吟。诸神不动。合禄马互换，凡事静以顺之，不免先费力而后遂，申为空亡，以寄课，申不为空亡论，终亦名浮于实。\n《义》曰：虎到金乡，旺相为强。勾陈捧印，仕宦名扬。更喜腾蛇，变化生角。文章中式，迁官进禄。\n《象》曰：上下俱阳卦相离，孟秋得此反相宜。其他时候皆非取，说与时人仔细推。\n又：此自任之卦，一曰玄胎，亦曰孤辰。夫自任者，乃伏吟之卦。天地伏吟，十二神各归本家，天地如一，四伏未发之象。占事静则宜，动则滞，主事藏匿不动，静中求劳，有屈而不伸之象。况玄胎主婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不通，触则成祸，惟君子守正修德则亨。且孤辰，乃茕茕孑立之象，占人别离桑梓。凡所占课，多虚少实，功名难遂，事业虚花。又曰：“官位遇之须改动，出行防盗拟人侵。所传闻事皆非实，卒病遭官不害身。”占者遇之此课，求官见贵，若七月节内或四月将占者，加官进禄之荣，登科甲第之美，其余自占不过虚喜而矣。婚姻不宜。交易不合。求财轻少。暴病不妨，久病凶重，尤忌占老人小儿病。失物难寻。访谒人不见。近者至远，行者回轮。盗者不出其家，逃者不出邑里。见空宜速寻，迟则有变。公讼自解，惊忧易散，患难易消。\n若出兵行师得此，大概有失众之象，昼占白兽，败绩而祸起，夜占无威而不宁。敌有使来，凡有言辞，其情多诈，尤防奇谋诳惑，慎而勿听。大抵此课，发用逢空，所事难成，凶事易散，被图者亦勿惊惧，自然解之。用兵者，不可不知斯耶。\n变更不一，过旬再图。\n真一山人云：事多变更惹虚声，牵引人情未得宁。机欲事成成未得，每逢惊处却消惊。\n《无惑钤》云：空禄宜舍，去乘财马。官鬼长生，宜分真假。\n《钤解》曰：申禄空虎，不宜守也。中传财马，足可乘也。巳在末传，夜占乘朱，则为官鬼，昼占乘勾，则为长生，真假见矣。",
