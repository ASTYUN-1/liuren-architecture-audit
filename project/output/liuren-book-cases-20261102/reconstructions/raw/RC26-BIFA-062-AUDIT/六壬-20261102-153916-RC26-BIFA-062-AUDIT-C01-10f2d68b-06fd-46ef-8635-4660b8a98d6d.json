  "keJing": [
    [
      {
        "key": "九、伏吟课 艮卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
      }
    ],
    [
      {
        "key": "伏吟课",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
      },
      {
        "key": "含义",
        "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
      },
      {
        "key": "注意",
        "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
      },
      {
        "key": "科举",
        "value": "必定高中，求名荣归。"
      },
      {
        "key": "疾病",
        "value": "有忧，或起怪异之事。"
      },
      {
        "key": "诉讼",
        "value": "为争夺田产成家宅。"
      },
      {
        "key": "灾祸",
        "value": "春冬较浅，秋夏势危。"
      },
      {
        "key": "行事",
        "value": "律身谨慎，动作无虞。"
      }
    ],
    [
      {
        "key": "二十九、斩关课 井卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "魁罡加日辰发用，乃豹隐南山之课。"
      },
      {
        "key": "含义",
        "value": "关梁逾越，最利逃亡，捕贼难获，出行无殃。病讼凶祸，厌祷吉祥。最利隐遁逃亡。"
      },
      {
        "key": "注意",
        "value": "贵人临亥，为贵登天门。甲戊庚日贵登天门，为神藏煞没。凡占事遇之，主万事顺利，不独斩关课如此。河魁加亥，名魁度天门，主抑塞难通；天罡加寅，名罡塞鬼户，主谋为顺利；"
      },
      {
        "key": "另注",
        "value": "魁罡临日辰，传有虎阴申酉为斩关得逃者，永远不获。若带血支、血忌、呻吟、羊刃、三杀，必伤人而走。"
      },
      {
        "key": "占行",
        "value": "利于出行，逃遁，但捉贼难获。"
      },
      {
        "key": "占病",
        "value": "遇之大凶。"
      },
      {
        "key": "占讼",
        "value": "遇之大凶。"
      },
      {
        "key": "其他",
        "value": "宜于书符、合药，厌祷。"
      },
      {
        "key": "天地独通",
        "value": "逃亡出行，如有神助。"
      }
    ],
    [
      {
        "key": "六十、元胎课 家人卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
      },
      {
        "key": "含义",
        "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
      },
      {
        "key": "注意",
        "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
      }
    ],
    [
      {
        "key": "绝胎格",
        "value": "元胎课逢反吟，虽开花但不结子。"
      }
    ],
    [
      {
        "key": "病胎格",
        "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
      }
    ],
    [
      {
        "key": "生胎格",
        "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
      }
    ],
    [
      {
        "key": "蓦越格",
        "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
      }
    ]
  ],
  "bifa": "27.传财化鬼财休觅.B.因财致祸格\n30.屋宅宽广致人衰.B.狮兽冲宅格.昼虎\n31.三传递生人举荐.B.支干相生格\n32.三传互克众人欺\n37.末助初兮三等论.Ⅱ.克干\n37.末助初兮三等论.D.自招其祸格\n43.害贵讼直作屈断.Ⅰ.害夜贵\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n49.两贵受克难干贵.B.贵人忌惮格.夜\n52.罡塞鬼户任谋为.A.贵塞鬼户格.夜贵\n70.鬼临三四讼灾随\n75.宾主不投刑在上.Ⅲ.三字刑",
  "zhiZhi": "辛巳日第一局干上戌\n课体：伏吟，元胎，斩关。\n课义：旅情未已，半路而止，凡事折腰，遇中有滞。\n解曰：伏吟本伏匿而不动，若魁罡加于日辰之上，则为斩关，似有行动之意。末传寅木作日财，必出外而求财也，旅情岂能已乎。中既空亡，所以半路而止。又中空名折腰格，主中间无力，首尾不应，所以相遇之中，尚有阻滞。巳虽日之德禄，三传刑冲破害俱全，总宜不动为妙。\n断曰：伏吟又作元胎，如天地未判，祸福始基，屈而未伸。最宜守之以正，方能致福。按此课，若得年命有吉神相助，最宜求官禄。末传寅木助初传之巳火，作辛金之官星，又兼日德，与六合相并故也。\n天时：水下火上，不动不变，寅木生火，何能有雨。\n家宅：夜占平安，昼占不吉。\n科名：帘幕不见，二场欠利，命乘贵人，中亦可许。\n求财：财神虽见，可望而不可即。\n婚姻：刑害不一，损多益少。\n胎产：课名悬胎，又主腰折，支被寅刑，产母不吉。\n疾病：鬼墓临干，老少不吉；中申空陷，多因腰疾。\n出行：半途必返。\n行人：天罡加罡，不动之象。\n遗失：元武不见，必非贼窃，寻觅可得。\n出师：昼占可忧，夜占稍吉。\n毕法云：末助初兮三等论。\n课经云：辛巳日伏吟，辰上克日，课体本凶。要知金生干巳，巳中有丙，丙与辛合，故辛金不畏巳火，反有相合相助之意。倘命能填实，申金翻成吉课。",
  "jiYingQian": "辛巳日第一局干上戌\n课体：伏吟、玄胎。\n《玉历钤》云：此课夜贵六合发用，主吉，求官见贵遂意，但昼贵腾蛇主凶，又中传空亡，谓之折腰，凡事无成。\n《毕法》云：此课伏吟，中传空亡，不能刑至末传，常占行人，伏吟必至，此却不然，必主行人中路阻隔，前后进退俱有难处，余占亦被蒙人先允许，而后无实惠也。\n上神生日，辰上生日上，用克日又合日。\n课名：伏吟、玄胎。用德，伏而不动。德神为用，可救一切灾危，所占百事，皆享安静和平之福。中申为空亡，但谋用中间无力，首尾不相应耳。\n《义》曰：课传自信，病多沉困。占胎未美，来情不喜。屈而未伸，斯理未真。守之以正，然后忻忻。\n《象》曰：来人占事何灾恼，积德之家天自保。任他使尽百般机，害汝无成犹见好。\n又：此自信之卦，一曰玄胎，亦曰天网。夫自信者，天地伏吟，十二神各归本家，天地如一，四伏未发之象。占事静则宜，动则滞，主事藏阻不动，静中求劳，有屈而不伸之象。况玄胎如婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不通，触则成祸，惟君子守正修德则亨。且天网者，即天网四张也，《经》曰“天网四张，万物被伤”，为阻滞.为疑难，为灾恼。干见鬼墓，防暗中有人侵损谋害。《经》云：“鬼在墓中危疑甚。”又曰：“鬼墓加干鬼暗兴。”鬼若明见，犹可防备，暗中有鬼，岂能见之？鬼者，克害占人者之谓也，幸得见折腰，吉凶之来，中道解散而不成也。占者遇之此课，刑冲六害，本非吉象，若求官得此者，不惟难成，还见惊恐。其他见贵、求谋、婚姻、求财、交易、投谒、远行、望信，凡百所占，先见惊恐、疑惑，然后散释而难成，损多益少。如患难、暴病、遭围、系狱、诉讼之事，始凶而终见解释也。逃盗目下难获。此课不宜占成事，惟利解凶事。\n若出兵行师得此，昼占忧心众畏，警惕不宁也，夜占尤宜获金宝之美利，然虽此论，而中传见空，欲吉而无吉，欲凶而无凶。若敌使之来，未免虚诈，用兵者宜鉴于斯。\n孟秋吉。\n真一山人云：此课分明是折腰，吉凶半道便潜消。能除惊险难成事，阴德相维福愈饶。\n《无惑钤》云：旅情未已，半途而止。凡事折腰，遇中有滞。\n《钤解》曰：伏吟主静，得天魁为斩关，主有动意。末寅日财，必出外求财也，旅情岂能已耶？中传空亡，或行至半途而止也。中空折腰，谋事中间无力，首尾不相应耳，途中亦有阻滞。巳虽日德，三传刑冲破害俱全，不动为妙。辛日禄在酉，乃空亡，不可占病，如久病，必绝食而死。末助初克干，六合发用最吉，求官如意，病难安，行人至，逃盗不获，财无，出人吉。神克日，本凶，缘金生在巳，丙与辛合，故不忧克。昼蛇入巢，暮贵塞鬼门，俱不为灾，亨利和平之福。",
