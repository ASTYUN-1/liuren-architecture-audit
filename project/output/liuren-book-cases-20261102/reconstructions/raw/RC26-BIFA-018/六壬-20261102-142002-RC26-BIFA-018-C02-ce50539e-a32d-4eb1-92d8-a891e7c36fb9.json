  "keJing": [
    [
      {
        "key": "重审课 坤卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
      },
      {
        "key": "含义",
        "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
      },
      {
        "key": "注意",
        "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
      },
      {
        "key": "占事",
        "value": "宜后起，祸由内生。"
      },
      {
        "key": "兵事",
        "value": "用兵主胜。"
      },
      {
        "key": "占孕",
        "value": "主生女。"
      },
      {
        "key": "谋望",
        "value": "主先难后成。"
      },
      {
        "key": "诉讼",
        "value": "后者胜，对被告有利。"
      },
      {
        "key": "初传为墓绝，末传为生旺",
        "value": "灾祸消解，事终有成。"
      },
      {
        "key": "初传为生旺，末传为墓绝",
        "value": "先易后难，先得后失。"
      },
      {
        "key": "初传克末传",
        "value": "有凶兆"
      },
      {
        "key": "末传克初传",
        "value": "为吉兆，"
      },
      {
        "key": "末传天将为龙、常、阴。后、",
        "value": ""
      },
      {
        "key": "六合等吉将，或为德、喜等吉神",
        "value": "逢凶化吉。"
      }
    ],
    [
      {
        "key": "五十七、励德课 随卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "贵人立于地盘卯酉宫上。"
      },
      {
        "key": "含义",
        "value": "利君子，不利小人。事多反复。"
      }
    ],
    [
      {
        "key": "励德格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "（干支）阳神在贵人前，阴神在贵人后；或（干支）阴神在贵人前，阳神居贵人后。"
      },
      {
        "key": "含义",
        "value": "阳神前引，阴神后随，则君子吉，小人危。若阴神前立，阳神后随，小人得意，君子失机。大体君子主迁动官位，平民主身宅不安，若安分循理，亦能获吉。"
      },
      {
        "key": "蹉跎格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支阴阳神都在贵人之前。"
      },
      {
        "key": "含义",
        "value": "主小人迁官，君子退职，利小人不利君子。"
      },
      {
        "key": "微服格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支的阴阳神均在贵人之后。"
      },
      {
        "key": "含义",
        "value": "主君子迁官，小人退职，利君子不利小人。"
      }
    ],
    [
      {
        "key": "六十二、间传课巽卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传相间隔一位递传。"
      },
      {
        "key": "含义",
        "value": "占事得此课，间位相传，事多间阻。"
      },
      {
        "key": "顺间传",
        "value": ""
      },
      {
        "key": "登三天格",
        "value": "三传辰午申"
      },
      {
        "key": "含义",
        "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
      },
      {
        "key": "涉三渊格",
        "value": "三传申戌子"
      },
      {
        "key": "含义",
        "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
      },
      {
        "key": "向三阳格",
        "value": "三传子寅辰"
      },
      {
        "key": "含义",
        "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
      },
      {
        "key": "出三阳格",
        "value": "三传寅辰午"
      },
      {
        "key": "含义",
        "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
      },
      {
        "key": "出户格",
        "value": "三传丑卯巳"
      },
      {
        "key": "含义",
        "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
      },
      {
        "key": "盈阳格",
        "value": "三传卯巳未"
      },
      {
        "key": "含义",
        "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
      },
      {
        "key": "变盈格",
        "value": "三传巳未酉"
      },
      {
        "key": "含义",
        "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
      },
      {
        "key": "入冥格",
        "value": "三传未酉亥"
      },
      {
        "key": "含义",
        "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
      },
      {
        "key": "凝阴格",
        "value": "三传酉亥丑"
      },
      {
        "key": "含义",
        "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
      },
      {
        "key": "溟濛格",
        "value": "三传亥丑卯"
      },
      {
        "key": "含义",
        "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
      },
      {
        "key": "（二）逆间传",
        "value": ""
      },
      {
        "key": "冥阴格",
        "value": "三传寅子戌"
      },
      {
        "key": "含义",
        "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
      },
      {
        "key": "悖戾格",
        "value": "三传戌申午"
      },
      {
        "key": "含义",
        "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
      },
      {
        "key": "顾祖格",
        "value": "三传午辰寅"
      },
      {
        "key": "含义",
        "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
      },
      {
        "key": "极阴格",
        "value": "三传丑亥酉"
      },
      {
        "key": "含义",
        "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
      },
      {
        "key": "时遁格",
        "value": "三传亥酉未"
      },
      {
        "key": "含义",
        "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
      },
      {
        "key": "励明课",
        "value": "三传酉未巳"
      },
      {
        "key": "含义",
        "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
      },
      {
        "key": "回明格",
        "value": "三传未卯巳"
      },
      {
        "key": "含义",
        "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
      },
      {
        "key": "转悖格",
        "value": "三传巳卯丑"
      },
      {
        "key": "含义",
        "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
      },
      {
        "key": "断间传格",
        "value": "三传卯丑亥"
      },
      {
        "key": "含义",
        "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
      }
    ]
  ],
  "bifa": "22.上下皆合两心齐.C.独支干上神作六合格\n26.水日逢丁财动之.A.财乘丁马格.①财乘丁\n38.闭口卦体两般推.Ⅱ.玄武乘旬首\n38.闭口卦体两般推.Ⅵ.禄作闭口\n43.害贵讼直作屈断.Ⅰ.害昼贵\n43.害贵讼直作屈断.Ⅰ.害夜贵\n43.害贵讼直作屈断.Ⅳ.白虎投朱雀，朱雀投勾陈\n45.昼夜贵加求两贵\n46.贵人差迭事参差.夜贵在干前\n52.罡塞鬼户任谋为\n74.空空如也事休追.A.四课全空格",
  "zhiZhi": "壬戌日第十一局干上丑\n课体：重审，励德，间传，向三阳。\n课义：四课初中，总是旬空，独存末克，鬼户纵横。\n解曰：子丑旬空，寅卯陷空，四课皆空。初传子，中传寅，又遇空脱，凡事无踪。独存末传之辰，虽作壬干之墓鬼，却喜罡塞鬼户。六神伏，四煞潜，任意谋为，无所阻碍，故曰鬼户纵横也。\n断曰：重审之卦，事多不顺，况励德为动摇之象。幸鬼加干而值空，墓在传而支破。且面前六合，又三传间传为向三阳格。自暗入明，主先凶后吉，人情皆美。若秋冬占之，休囚之土，不能贼生旺之水，虽有犯上之象，终难遂其犯上之心。微嫌传课陷空，虚声胜而实际少耳。\n天时：向三阳主晴。\n家宅：四课初中俱空，独存墓神，屡空之象，且有病讼盗贼之虞。\n功名：不利。\n求财：无益。\n婚姻：干支上神六合，可结，但空陷不成。\n胎产：三传纯阳，女孕。子母皆空，恐有产厄。\n疾病：病在肾家及膀胱经，初起可愈，久病凶。\n逃盗：宅中武空，难获。\n出行：未必果行，行亦虚名虚利。\n行人：立至。\n兵战：罡塞鬼户，多算则胜。\n毕法云：罡塞鬼户任谋为。\n断验：午命戊戌八月辰加寅占投谒，曰:宾主甚合，但虚文胜而实意少，以支干上神空相合也。年命上马带六合，若投尊长亲戚，大好。然鬼作死气，乘常加干，恐有外来孝服，后俱验。",
  "jiYingQian": "壬戌日第十一局干上丑\n课体：重审、向三阳、孤辰、励德。\n罡塞鬼户任谋为。\n又：此课虽名向三阳，初中空亡，依旧不见阳。四课间隔，支内干外，支刑克日，主有孝服。子为虎刃，虽是空亡，不死人，亦主事多。是旧椁，曾再举，未葬亡者，葬后亡者不安。子息在空亡，此是进课在空亡，才生下一子息便死，须是换去此空亡之椁，不害现在子息也。现在子息临宅，加于犬地而见虎，若见鼠咬衣服，必有大灾及于小儿。宅内不合蓄水，更无水路，若不开导，监仓自损身，亦难保寿（《壬占汇选》作：韩监仓修职癸酉生，三十七岁占平生，己酉年六月十五壬戌日未将巳时）。\n《玉历钤》云：此课空亡发用，末又克初，凡百一无所成。上神克日，日上克辰上，日上克用，末克初。\n课名：重审、孤辰。此课发用空亡，末鬼克日，凡占无始终，只可散忧，不可望吉。\n《义》曰：你来侵我，何以见之？徒劳心志，事多废弛。凶者不凶，吉者未吉。变更不同，斯理默识。\n《象》曰：东谋西虑未成功，何必留心去捕风。好恶一场闲笑话，惟嫌辰土暗为凶。\n又：此重审之卦，一曰孤辰。夫重审者，重而审之也。利为主，利后动，长有厄，事从内起，起于女人。以下犯上，贱犯贵，卑犯尊，事多不顺。阴小在下者，有悖逆之事。占臣未忠，子失孝，事不可遂意而行，必当审察，循乎义理，庶几以免后患也。况孤辰有茕茕孑立之象，占人别离桑梓，自立门户，财物虚耗，僧道宜之，俗不宜也。凡所占谋，多虚少实，功名难遂，事业虚花。事多起于不实，闻事虚声，或传闻不的，或彼以欺诈而来诳惑，目下闻言，虽极有悚动人者，及惊骇众人而不安，宜静正以待之，不久则其言自化也。课议所行，必有欺负、受制，亦不足畏也。子寅辰，向三阳也，进间隔之象，进而复退，进退不一。占者遇之此课，占求官未遂。占见贵难逢，事不能成，虽见何益？占婚姻得此，非二姓之真缘。占财得之，徒一场之着力。占暴病不畏，久病堪叹。其他谋望，有影无形，狱讼忧愁，自今宽解，乃闻忧不忧，闻喜而不喜也。\n占出兵行师：惊报不可遽信，不可遽行，恐不的而误事，却有失众之理，不然吉凶俱不成也。\n真一山人云：子寅辰乃向三阳，何事初中没主张？吉者未成凶亦散，到头又恐惹惊惶。\n《无惑钤》云：四课初中，总是旬空。独存辰土，鬼尸横充。\n《钤解》曰：子丑旬空，寅卯落空，四课已空，初子、中寅又空，凡占皆无实迹也。独存辰土，为干墓鬼，常人病讼深畏，但罡塞鬼户，任意谋为，而无阻矣。《集议》：“罡塞鬼户任谋为”谓辰为天罡，寅为鬼门，凡辰加寅，不论在传不在传，皆名罡塞鬼户。用空夜玄，主失脱。临宅被克，必因起盖宅屋而失其禄也，难以权摄论（此当以禄临支论之为是）。四课无形。",
