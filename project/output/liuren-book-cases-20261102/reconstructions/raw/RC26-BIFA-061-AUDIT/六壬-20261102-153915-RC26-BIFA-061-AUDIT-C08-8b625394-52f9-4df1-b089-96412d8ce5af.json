  "keJing": [
    [
      {
        "key": "九、伏吟课 艮卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
      }
    ],
    [
      {
        "key": "伏吟课",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
      },
      {
        "key": "含义",
        "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
      },
      {
        "key": "注意",
        "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
      },
      {
        "key": "科举",
        "value": "必定高中，求名荣归。"
      },
      {
        "key": "疾病",
        "value": "有忧，或起怪异之事。"
      },
      {
        "key": "诉讼",
        "value": "为争夺田产成家宅。"
      },
      {
        "key": "灾祸",
        "value": "春冬较浅，秋夏势危。"
      },
      {
        "key": "行事",
        "value": "律身谨慎，动作无虞。"
      }
    ],
    [
      {
        "key": "六十、元胎课 家人卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
      },
      {
        "key": "含义",
        "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
      },
      {
        "key": "注意",
        "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
      }
    ],
    [
      {
        "key": "绝胎格",
        "value": "元胎课逢反吟，虽开花但不结子。"
      }
    ],
    [
      {
        "key": "病胎格",
        "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
      }
    ],
    [
      {
        "key": "生胎格",
        "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
      }
    ],
    [
      {
        "key": "蓦越格",
        "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
      }
    ]
  ],
  "bifa": "21.交车相合交关利.A.交车长生\n22.上下皆合两心齐\n22.上下皆合两心齐.D.交互六合格\n31.三传递生人举荐.C.两面刀格.①\n32.三传互克众人欺\n37.末助初兮三等论.Ⅰ.生干\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n75.宾主不投刑在上.Ⅲ.三字刑\n89.任信丁马须言动.乘马",
  "zhiZhi": "戊申日第一局干上巳\n课体：伏吟，元胎。\n课义：迤逦不利，败也萧何，末助初生，成也萧何。\n解曰：寅在末传，能成能败，故以萧何喻之。败者初克中，中克末，末克干。成则末助初传，而能生干也。\n断曰：干支上下，交车相合。德禄发用，中传长生，末传驿马，明助巳火为生气。虽三刑互克，而一德足以消万忧。诸占鹹吉，凡事人来暗助。然能助我，又能克我，是为两面刀也。须开诚布公，乃为善用。课中城吏全逢，禄马交动，求官最利。但寅属旬空，春占方吉。\n天时：火爻发用，大晴。\n家宅：课名元胎，家有妊人，干支生合，人宅安宁。\n功名：德禄临身，夜占龙官乘马，未仕者得官，现任者升转。\n求财：合本营生，春占则吉。\n婚姻：吉而难成。\n胎产：男孕产速。\n疾病：肺家受病，不妨，虽危有救。\n出行：驿马生德扶干，水陆皆吉。\n行人：夜占朱雀发用，先有信，旋当得意而归。\n捕获：不出邑里，当是健奴军吏。\n兵战：利客不利主。\n坟葬：支乘长生，上下六合，兴旺之地，且出长寿。\n毕法云：交车相合交关利，宾主不投刑在上，上下皆合两心齐，三传互克众人欺。\n课经云：交车长生，大宜合本营生。\n纂要云：昼占三重白虎作长生，乃不幸中幸。夜占三重青龙作日鬼，乃幸中不幸。\n又云：六戊伏吟，三传递克，全无和气，不可作甲戊庚三奇。",
  "jiYingQian": "戊申日第一局干上巳\n课体：伏吟、玄胎。\n《玉历钤》云：此课三传入鬼乡，全无和气，凡占所求，皆凶否不成。\n《毕法》云：此课乃初传生日，然初克中，中克末，末克日干，虽得巳火生戊土，不觉迤逦克至日干，谚云“成也萧何，败也萧何”。占者必被工匠，或干办人，或自生人，作两面刀伤害。\n《灵辖经》云：此课干支上下俱作六合，凡占必彼此齐气相合。又云：昼占三重白虎作长生，乃不幸中之幸；夜占青龙作日鬼，乃幸中之不幸。\n上神德日，日上克辰上。\n课名：伏吟。诸神不动。巳带德禄为用，凡占有凶无吉，旦时虽恶不凶，雀勾有文字荐。\n《义》曰：刑中之合，欲和未和。求官最吉，福禄春波。先难后易，吉少凶多。逢寅岁月，满面呵呵。\n《象》曰：勾留迟滞水天然，达士知微理不偏。疑惑忧愁终见解，功名谋望未两全。\n又：此自任之卦，一曰玄胎。夫自任者，乃天地伏吟，十二神各归本家，天地如一，四伏未发之象。占事静则宜，动则滞，主事藏匿不动，静中求劳，有屈而不伸之象。况玄胎如婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不通，触则成祸，惟君子守正修德则亨。《经》云：“任信伏吟神，行人立至门。失物家内盗，逃者隐乡邻。病合难言语，占胎聋哑人。访人藏不出，行者却回轮。”玄胎不宜占老人小儿病。三传互克众人欺，得此主有人迤逦克害，遂致众口相攻，中有两面是非之人，幸巳火相生，成败萧何之喻。寅鬼逢空，有声无实，又何足虑？占者遇之此课，举动未遂，凡事勾留迟滞，有屈而不伸之象。占求官，迁官捧印，白虎入庙，腾蛇生角，将以成龙变化，最宜，惜乎末传少力，须待木旺，新春年月方可有成。占见贵未顺。占婚姻难成。占财利轻。病不妨，凶有救。忧疑逃亡，访亲友得信。行人将到。交易难合。远行投谒者，徒费粮裹。\n占出兵行师得此：昼占勾留失利，夜占口舌文词，终见有解也。有始无终。春吉。\n真一山人云：何事人情未足量，是非得失任更张。凶中变吉浑无虑，若有阴功福愈昌。《无惑钤》云：迤逦不和，败也萧何。末助初生，成也萧何。\n《钤解》曰：《集议》：“三传互克众人欺”内有此日例，谓生变克，翻为两面刀占者必被工匠，或干办人，或巳作两面刀。惟戊戌伏吟，巳空不足畏，好恶俱无。交车长生，宜合本作营生。“乐里悲”内列此日，长生乘虎，幸中不幸；日鬼乘蛇，不幸中幸。“宾主不投刑在上”内，谓此三刑未免无恩之意，凡占恩反怨也。人犹巳德遁乙，寅在末传，能成能败，故以萧何喻之。败则自初递来克干，成则末助初传生干是也。",
