  "keyi": "",
  "keJing": [
    [
      {
        "key": "元首课 乾卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "一上克下，余课无克，为元首课。"
      },
      {
        "key": "含义",
        "value": "尊制卑，贵制贱。占事多顺，忧喜皆实。事从外来，事起男子，宜主动。"
      },
      {
        "key": "注意",
        "value": "遇凶神恶将，上恶而下受欺；或上休囚而下得势，则下强而上受欺。"
      },
      {
        "key": "君王占得",
        "value": "有伊尹之臣"
      },
      {
        "key": "大臣占得",
        "value": "遇唐虞之右"
      },
      {
        "key": "常人占得",
        "value": "万事顺利"
      }
    ],
    [
      {
        "key": "三十、闭口课 遁卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "旬尾加旬首发用；旬首乘玄武发用；旬首上神乘玄武发用；三者有其一，即为真闭口课。"
      },
      {
        "key": "含义",
        "value": "主禁口闭缄，机关莫测，事机难明，逃亡难寻。失物人见而不肯言，纵乘贵告贵也不允。占讼有冤莫诉，有屈难伸。占孕生喑哑之儿。"
      },
      {
        "key": "注意",
        "value": "乘白虎占病，主痰气阻塞，喉肿舌禁。若兼无禄课体，主绝食而死。"
      },
      {
        "key": "求事",
        "value": "机关难测，事情的迹象难以明晰。"
      },
      {
        "key": "寻人",
        "value": "将没有踪影。"
      },
      {
        "key": "寻物",
        "value": "丢失物品别人看见也不肯说出来。"
      },
      {
        "key": "告贵",
        "value": "纵然乘责人，告贵也不得应允。"
      },
      {
        "key": "占孕",
        "value": "生喑哑之子。"
      },
      {
        "key": "占病",
        "value": "为痰塞气堵，喑哑之症，或者生口痢，或者喉塞不能进食。"
      },
      {
        "key": "占讼",
        "value": "有屈不能伸，有冤无处诉。"
      }
    ],
    [
      {
        "key": "六十二、间传课巽卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传相间隔一位递传。"
      },
      {
        "key": "含义",
        "value": "占事得此课，间位相传，事多间阻。"
      },
      {
        "key": "顺间传",
        "value": ""
      },
      {
        "key": "登三天格",
        "value": "三传辰午申"
      },
      {
        "key": "含义",
        "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
      },
      {
        "key": "涉三渊格",
        "value": "三传申戌子"
      },
      {
        "key": "含义",
        "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
      },
      {
        "key": "向三阳格",
        "value": "三传子寅辰"
      },
      {
        "key": "含义",
        "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
      },
      {
        "key": "出三阳格",
        "value": "三传寅辰午"
      },
      {
        "key": "含义",
        "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
      },
      {
        "key": "出户格",
        "value": "三传丑卯巳"
      },
      {
        "key": "含义",
        "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
      },
      {
        "key": "盈阳格",
        "value": "三传卯巳未"
      },
      {
        "key": "含义",
        "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
      },
      {
        "key": "变盈格",
        "value": "三传巳未酉"
      },
      {
        "key": "含义",
        "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
      },
      {
        "key": "入冥格",
        "value": "三传未酉亥"
      },
      {
        "key": "含义",
        "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
      },
      {
        "key": "凝阴格",
        "value": "三传酉亥丑"
      },
      {
        "key": "含义",
        "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
      },
      {
        "key": "溟濛格",
        "value": "三传亥丑卯"
      },
      {
        "key": "含义",
        "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
      },
      {
        "key": "（二）逆间传",
        "value": ""
      },
      {
        "key": "冥阴格",
        "value": "三传寅子戌"
      },
      {
        "key": "含义",
        "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
      },
      {
        "key": "悖戾格",
        "value": "三传戌申午"
      },
      {
        "key": "含义",
        "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
      },
      {
        "key": "顾祖格",
        "value": "三传午辰寅"
      },
      {
        "key": "含义",
        "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
      },
      {
        "key": "极阴格",
        "value": "三传丑亥酉"
      },
      {
        "key": "含义",
        "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
      },
      {
        "key": "时遁格",
        "value": "三传亥酉未"
      },
      {
        "key": "含义",
        "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
      },
      {
        "key": "励明课",
        "value": "三传酉未巳"
      },
      {
        "key": "含义",
        "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
      },
      {
        "key": "回明格",
        "value": "三传未卯巳"
      },
      {
        "key": "含义",
        "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
      },
      {
        "key": "转悖格",
        "value": "三传巳卯丑"
      },
      {
        "key": "含义",
        "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
      },
      {
        "key": "断间传格",
        "value": "三传卯丑亥"
      },
      {
        "key": "含义",
        "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
      }
    ]
  ],
  "bifa": "06.六阴相继尽昏迷.A.六阴格\n15.脱上逢脱防虚诈.Ⅱ.夜贵\n26.水日逢丁财动之.A.财乘丁马格.②财乘驿马\n30.屋宅宽广致人衰.B.狮兽冲宅格.昼虎\n35.人宅受脱俱招盗.Ⅰ.干支上脱\n43.害贵讼直作屈断.Ⅳ.白虎投朱雀，朱雀投勾陈\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干前\n47.贵虽在狱宜临干\n49.两贵受克难干贵\n49.两贵受克难干贵.A.白虎或乘临丑格.夜\n52.罡塞鬼户任谋为\n69.虎乘遁鬼殃非浅.昼虎\n75.宾主不投刑在上.Ⅰ.一字刑.干支全自刑",
  "zhiZhi": "己酉日第十一局干上酉\n课体：元首，不备，间传，闭口，出产。\n课义：阴私叠有，独存闭口，昼虎遁鬼，两贵皆丑。\n解曰：传课纯阴，而后合元武叠见，定主阴私之事，不一而足。中末皆空，独存初传癸丑。闭口之卦，事有难言。如用昼将，末传巳火，遁乙乘虎，灾殃必重，纵空难解。昼贵入狱，夜贵临午，两贵皆伤，俱不可干，所以丑也。\n断曰：间传之课，进步艰难。五阴相继，不利公干。酉支脱己干之气，却生所乘之亥水，而己土反取以为财，是即毕法所谓取还魂债也。占者得此，索取旧逋为宜。但既脱又空，耗失之事，亦不能免。\n天时：纯阴课，主阴。\n家宅：干支各乘脱气，元武又动，防虚耗及盗贼。\n功名：不利，且宜谨言。\n求财：索债可得，但须费力。\n婚姻：后合重叠入传，不吉。\n胎产：孕防损，产不利。\n疾病：闭口卦，又为出户，甚凶，若昼占虎乘遁鬼，禄复乘空，必不能愈。\n争讼：可以讲和。\n出行：不利。\n行人：驿马入宅，即至；远者酉亥月到。\n捕获：夜占在北方武臣贵家。\n兵战：利诡诈，不利声讨。\n毕法云：两贵受克难干贵，虎乘遁鬼殃非浅，脱上逢脱防虚诈。酉从魁也，为亚魁星。天盘酉临年命日干，占试必中。\n指撑赋云：丑卯巳为出户，春雷震蛰。\n秘要云：诸占于酉日取应。",
  "jiYingQian": "己酉日第十一局干上酉\n课体：元首、出户、六阴、不备、泆女、闭口、不行传。\n二贵受克难干贵，脱上逢脱防虚诈。\n《玉历钤》云：此课四位不备，中传空亡，凡占事必不足，亦不成就，妄费心力。上神盗日，日上生辰上。\n课名：元首。辰加日，进退不自由。阳不备，又空亡，所占有始无终，有虚无实，此必他人来见我求事，然亦吉凶无成。\n《义》曰：既脱又空，耗盗须逢。无少补益，难建其功。泆女不正，婚姻无用。病者惊凶，作福为胜。\n《象》曰：进入空乡退步高，如还黾勉枉徒劳。安居坐守生余福，婷看将来好事饶。\n又：此元首之卦，一曰洪女。夫元首者，尊制卑，贵役贱之象。占事多顺，利于先举，事多起于男子。为臣忠，为子孝，正大光明而无邪僻之行，德业已著而乾乾进修，常怀危惧，惕励而无咎也。夫泆女乃不正之象，占男女有阴私暗昧之理，占家宅防阴小\n越礼犯分者，占婚姻媒妁不明，惟能以礼自防者可化之，宜谨于闺门而后自化也。日生上神，虚费不足，盗失损财，人口衰残，休囚尤重，又为子孙脱漏之事。此课凡占，彼此互相脱赚，喻合“你哄我，我哄你”之意。占者遇之此课，占求官见贵，和而难济，未遂心志。占财难得。占病者不吉，久病愈凶。占失物难寻。占远行投谒人者，徒费粮裹。其他交易、谋望之事，惟利春占，夏秋得之，有声无实。占惊恐、患难、遭围、被禁者，先忧而后喜也。\n占出兵行师得此：彼此各怀计谋，昼占无威，夜占不利。大抵此课，凡占凶中有救矣，美中不足，吉不成吉，而凶不成凶也。\n忙忙不信。\n真一山人云：近来谋事未如心，虚耗财源赚脱寻。惟有哲人能预鉴，随时斟酌纵豪吟。\n《无惑钤》曰：阴私叠有，独存闭口。昼虎遁鬼，两贵皆丑。\n《钤解》曰：课传纯阴，而后合玄虎重见，定主阴私重叠也。卯巳空陷，丑乃闭口为发用，独存此耳。巳遁旬乙，畏昼占乘虎。昼贵人狱，夜贵受克，俱不可干也。《集议》：“虎乘遁鬼殃非浅”内列此日，谓凡占皆畏，其咎弥深难消，纵空亡亦不能救。出户：“出户逢明日，欲求干望时。君子升阳渐，小人尚危疑。”还魂债，己干上酉，支脱干也，却不知酉上原见亥水，已自受脱。亥上又见丑土克，丑上又见卯木克，卯木之上反生巳火，巳火却来育己土，但卯空，则其势弱也。",
