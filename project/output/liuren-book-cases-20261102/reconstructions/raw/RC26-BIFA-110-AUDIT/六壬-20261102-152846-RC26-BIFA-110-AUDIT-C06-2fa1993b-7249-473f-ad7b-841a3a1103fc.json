  "keJing": [
    [
      {
        "key": "八专课 同人卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "凡别责课遇到干支同位，如甲寅、丁未、庚申、己未四日排课，阳日以干上神顺数两位作初传，阴日以第四课上神逆数两位作初传，中末传俱取干上神。"
      },
      {
        "key": "含义",
        "value": "神将吉，为同心协力，专一之象。刚日八专为尊长欺负幼卑，或男人有喜，凡事速成。阴日八专为妻背夫，女人犯淫，诸事退缩迟缓。将兵多胜，失物多在家中。占婚主有口舌分离，如果六合、太阴临日辰则吉。"
      },
      {
        "key": "注意",
        "value": "三传见吉神，又乘吉将为众人协力之象，主吉。三传见凶神，又乘凶将逢凶煞，则以凶论。"
      },
      {
        "key": "另注",
        "value": "八专课虽缺二课，如果有上下克，则以常法取用。"
      },
      {
        "key": "占事",
        "value": "二人同心协力。其利断金。."
      },
      {
        "key": "兵事",
        "value": "统领兵士，多取胜。"
      },
      {
        "key": "失物",
        "value": "失物多在家中。."
      },
      {
        "key": "婚姻",
        "value": "有口舌分离，如果见吉将、善神，则为吉。"
      },
      {
        "key": "尊卑",
        "value": "刚日八专为尊长欺卑幼，男人有喜，凡事速成。."
      },
      {
        "key": "女子",
        "value": "阴日八专为妻背夫，女人犯淫，诸事退缩迟缓。"
      }
    ],
    [
      {
        "key": "二十九、斩关课 井卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "魁罡加日辰发用，乃豹隐南山之课。"
      },
      {
        "key": "含义",
        "value": "关梁逾越，最利逃亡，捕贼难获，出行无殃。病讼凶祸，厌祷吉祥。最利隐遁逃亡。"
      },
      {
        "key": "注意",
        "value": "贵人临亥，为贵登天门。甲戊庚日贵登天门，为神藏煞没。凡占事遇之，主万事顺利，不独斩关课如此。河魁加亥，名魁度天门，主抑塞难通；天罡加寅，名罡塞鬼户，主谋为顺利；"
      },
      {
        "key": "另注",
        "value": "魁罡临日辰，传有虎阴申酉为斩关得逃者，永远不获。若带血支、血忌、呻吟、羊刃、三杀，必伤人而走。"
      },
      {
        "key": "占行",
        "value": "利于出行，逃遁，但捉贼难获。"
      },
      {
        "key": "占病",
        "value": "遇之大凶。"
      },
      {
        "key": "占讼",
        "value": "遇之大凶。"
      },
      {
        "key": "其他",
        "value": "宜于书符、合药，厌祷。"
      },
      {
        "key": "天地独通",
        "value": "逃亡出行，如有神助。"
      }
    ],
    [
      {
        "key": "五十七、励德课 随卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "贵人立于地盘卯酉宫上。"
      },
      {
        "key": "含义",
        "value": "利君子，不利小人。事多反复。"
      }
    ],
    [
      {
        "key": "励德格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "（干支）阳神在贵人前，阴神在贵人后；或（干支）阴神在贵人前，阳神居贵人后。"
      },
      {
        "key": "含义",
        "value": "阳神前引，阴神后随，则君子吉，小人危。若阴神前立，阳神后随，小人得意，君子失机。大体君子主迁动官位，平民主身宅不安，若安分循理，亦能获吉。"
      },
      {
        "key": "蹉跎格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支阴阳神都在贵人之前。"
      },
      {
        "key": "含义",
        "value": "主小人迁官，君子退职，利小人不利君子。"
      },
      {
        "key": "微服格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支的阴阳神均在贵人之后。"
      },
      {
        "key": "含义",
        "value": "主君子迁官，小人退职，利君子不利小人。"
      }
    ]
