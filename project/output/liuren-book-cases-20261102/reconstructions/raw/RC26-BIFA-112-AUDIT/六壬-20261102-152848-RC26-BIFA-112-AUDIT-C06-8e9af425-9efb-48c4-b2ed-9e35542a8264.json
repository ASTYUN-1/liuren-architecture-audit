  "keyi": "",
  "keJing": [
    [
      {
        "key": "见机格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "当受害深浅一样时，先以四孟（寅申巳亥）上神取用者，为见机格。"
      },
      {
        "key": "含义",
        "value": "事之初起，祸福随之，见事必须见机而行。疑事须急改，犹豫必有失，因此也主事多反覆。多算胜少算不胜，将涉水不轻进之象。名利难遂，胎孕未实。"
      },
      {
        "key": "注意",
        "value": "神将吉以吉言，凶以凶论。"
      },
      {
        "key": "占事",
        "value": "有疑难急迫处，必须改变，否则有失。"
      },
      {
        "key": "占行",
        "value": "利涉大川，有孚贞吉。"
      },
      {
        "key": "名利",
        "value": "名利难递。"
      },
      {
        "key": "占孕",
        "value": "胎孕未实。"
      }
    ],
    [
      {
        "key": "十、反吟课 震卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "月将与占时为六冲之辰，天盘与地盘相冲，亦名返吟课。"
      },
      {
        "key": "占事",
        "value": "高岸为谷，深谷为陵，变化不定。"
      },
      {
        "key": "得失",
        "value": "得物必失，败物反成，成败难凭。"
      },
      {
        "key": "兵事",
        "value": "安营离散，出阵虚惊。"
      },
      {
        "key": "利害",
        "value": "得生于外，害人者反受其害。"
      },
      {
        "key": "三传",
        "value": "1.已亥已多主改动，索取财物和文章等事。2.卯酉卯占家宅门户道路等事。3.寅申寅占远行移动争执诉讼事。"
      }
    ],
    [
      {
        "key": "二十九、斩关课 井卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "魁罡加日辰发用，乃豹隐南山之课。"
      },
      {
        "key": "含义",
        "value": "关梁逾越，最利逃亡，捕贼难获，出行无殃。病讼凶祸，厌祷吉祥。最利隐遁逃亡。"
      },
      {
        "key": "注意",
        "value": "贵人临亥，为贵登天门。甲戊庚日贵登天门，为神藏煞没。凡占事遇之，主万事顺利，不独斩关课如此。河魁加亥，名魁度天门，主抑塞难通；天罡加寅，名罡塞鬼户，主谋为顺利；"
      },
      {
        "key": "另注",
        "value": "魁罡临日辰，传有虎阴申酉为斩关得逃者，永远不获。若带血支、血忌、呻吟、羊刃、三杀，必伤人而走。"
      },
      {
        "key": "占行",
        "value": "利于出行，逃遁，但捉贼难获。"
      },
      {
        "key": "占病",
        "value": "遇之大凶。"
      },
      {
        "key": "占讼",
        "value": "遇之大凶。"
      },
      {
        "key": "其他",
        "value": "宜于书符、合药，厌祷。"
      },
      {
        "key": "天地独通",
        "value": "逃亡出行，如有神助。"
      }
    ],
    [
      {
        "key": "六十、元胎课 家人卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
      },
      {
        "key": "含义",
        "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
      },
      {
        "key": "注意",
        "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
      }
    ],
    [
      {
        "key": "绝胎格",
        "value": "元胎课逢反吟，虽开花但不结子。"
      }
    ],
    [
      {
        "key": "病胎格",
        "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
      }
    ],
    [
      {
        "key": "生胎格",
        "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
      }
    ],
    [
      {
        "key": "蓦越格",
        "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
      }
    ]
  ],
  "bifa": "02.首尾相见始终宜.B.回环格\n28.传鬼化财钱险危.B.求财急取格.干上克寄宫\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n49.两贵受克难干贵.B.贵人忌惮格.昼\n74.空空如也事休追.昼空\n74.空空如也事休追.夜空\n74.空空如也事休追.A.四课全空格\n86.将逢内战所谋危.夜\n90.来去俱空岂动移\n91.虎乘干鬼凶速速.A.马载虎鬼格.夜",
  "zhiZhi": "戊辰日第七局干上亥\n开发者提示：此课三传有争议，陈公献的案例中用巳亥巳并且又用亥巳亥，诸公善用者用之\n课体：反吟，元胎，见机，斩关。\n课义：课传俱空，行住无踪，我去彼绝，久病须凶。\n解曰：戌亥旬空，巳又坐空，辰亦落空，是四课三传无一不空也。反吟空作往来，是行住无踪也。巳亥俱临绝地，以占久病极凶，未丑月占长上病尤不吉。\n断曰：此无依之卦，又兼传课俱空，所谓孤辰寡宿，乃十干不到之地，五行脱空之乡。吉固消亡，凶亦解散。占主事带两途，远近系心，往返无常，有疑莫决。惟宜复理旧事，兼利避祸潜逃。反吟统震之体，孤寡统革之体，君子总以恐惧修省，改旧图新为要。\n天时：占处忽阴忽晴，有雨多在远处。\n家宅：不利家长。\n婚姻：不成，若系下人，一鳏一寡则合。\n胎产：防摇动堕落，若产后占病反宜。\n功名：反覆求谋，恐归无益。\n求财：近财有，远财无。\n投谒：频往不遇。\n疾病：怔仲虚脱暴病，醮祭吉，久病及尊长病凶。\n失脱：无踪，防再失。\n出行：有离乡漂泊之象。\n行人：不得归。\n争讼：屡讼不成。\n兵战：得敌空营，军实空乏，宜罢兵息众为吉。\n毕法云：来去俱空岂动移。\n袖中金云：元胎事主四人共谋，终见灾异。反吟四孟为绝元胎也。\n指南：甲戌年二月戌将辰时占科名，德入天门，两贵加魁罡，冲克生空，必中高魁。发榜果验。",
  "jiYingQian": "戊辰日第七局干上亥\n课体：反吟、玄胎、孤辰、斩关、空空如也、来去俱空。\n空上乘空事莫追，二贵差跌事参差。\n《玉历钤》云：此课两传俱下克上，空亡在中，凡百俱无可成。\n《毕法》云：此课中传亥为空亡，初末俱坐空亡之地，占喜则虚，占忧则散，占病则解。\n日克上神，辰上克日上，日上克用。\n课名：反吟，亥巳往来，宜屈己下人方成。有同类人败事，觉而去之吉。贵人昼夜相聚，日德可用动高尊，但日德就克绝所，亥为旬空，吉凶无成。\n又：此课占见贵、求财、求婚、谋望，一切无成。病必死。官事无灾。产动未生。盗逃不远。望信不来。两传克日上空亡，占讼无凶病者压。胎动未生逃窜远，求谋更改总乖张。\n《义》曰：空里雷鸣，知闻其声。定睛睁觑，无影无形。释家有言，指空话空。不识斯理，枉用其功。\n《象》曰：海鹤凌空万里遥，乘风直上九重霄。从今何处寻踪迹，放下身心且莫劳。\n又：此无依之课，一曰玄胎。夫无依者，即反吟也。《经》曰：“无依是反吟，逃者远追寻。合者应分散，安巢别改林。守官须易位，结友也分襟。所为多反复，占病数般侵。”反吟刑冲，事主迟滞，远近系心，更相仇怨，且反复而呻吟，是无予夺而难息也。况传见下贼上，利为主，利后动，长有厄，事从内起，起于女人。以下犯上，贱犯贵，卑犯尊，事多不顺。阴小在下者，有悖逆之事。占臣未忠，子失孝，事不可遂意而行，必当审察，循平义理，庶儿以免后患也。事防再举，病防再发。且玄胎如婴儿隐伏之状，事主远而多伏，喑味不通，触则成祸，惟君子守正修德则亨。传见寡宿，《经》云：“寡宿孤辰，值此尤妨骨肉。”占人孤穷失业，别离桑梓，财物多虚，亲者不亲。课传俱阴，所占暗昧不实，事起于虚声。占者遇之此课，求官见贵，反复难成。占婚求财，终始无益。暴病者醮祭即安，久病者凶危难疗。逃亡难获。官讼不成。投谒人者，主客无心。占出行者，徒劳跋涉。\n占出兵行师：终难成功，还见失众之象。或转报不实，或虚张声势，此理必然也。大抵此课，惟利解散凶殃。不能成事。《经》云“三传俱空，万事无踪”，此之谓也。\n真一山人云：谁识玄机道理深，得君一语重千金。忧惊许久浑无事，说与知音放下心。\n《无惑钤》云：传课俱空，行往无踪。我去彼绝，久病须凶。\n《钤解》曰：德人天门为用，空了。亥空，巳又落空，戌空，辰又落空，是传课俱空也。巳亥巳，行往无踪又空也。巳亥彼此俱临绝地，久病值空，绝其凶也。《集议》：“空空如也事休追”，占事皆指空话空，全无实迹，惟宜解散忧疑，欲成事而不可也。鬼空妙、如占久病者死，新病者安。如望事成合，须待改旬再谋之，方可必，吉神良将乃如此论也。夜贵加昼，宜暗求关节。四课无形，事不出名。纵然出名，也是虚声。四课俱空，年命又乘空亡，但非我事，或替人占事。",
