  "keJing": [
    [
      {
        "key": "九、伏吟课 艮卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
      }
    ],
    [
      {
        "key": "伏吟课",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
      },
      {
        "key": "含义",
        "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
      },
      {
        "key": "注意",
        "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
      },
      {
        "key": "科举",
        "value": "必定高中，求名荣归。"
      },
      {
        "key": "疾病",
        "value": "有忧，或起怪异之事。"
      },
      {
        "key": "诉讼",
        "value": "为争夺田产成家宅。"
      },
      {
        "key": "灾祸",
        "value": "春冬较浅，秋夏势危。"
      },
      {
        "key": "行事",
        "value": "律身谨慎，动作无虞。"
      }
    ],
    [
      {
        "key": "杜传格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课无克，自刑发用，名杜传格。阳日中传取支上神，阴日中传取干上神。中传又为自刑者，末传取中传所冲之辰。"
      },
      {
        "key": "含义",
        "value": "居者将移，合者将离，中道而废。三传为纯阳，等人必来；三传纯阴，等人不来。三传见驿马、天马，主静中有动，待人、通讯来速。三传见勾陈，主有屈难伸，动静不宜。三传子午俱全，恐有文章或车祸事。卯酉俱全者，家生变故。"
      },
      {
        "key": "注意",
        "value": "日辰和用神旺相，神将皆吉，亦以吉论。"
      },
      {
        "key": "家宅",
        "value": "主居所变更，相合者将分离。"
      },
      {
        "key": "占事",
        "value": "行道中途而止，事情宜有所变动。"
      },
      {
        "key": "行人",
        "value": "三传为纯阳，等人必来，三传为纯阴，等人未归"
      },
      {
        "key": "走失",
        "value": "下客寻人求物，都在家院之中。"
      }
    ],
    [
      {
        "key": "十三、三奇课 豫卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "旬奇发用发用或者入传。（除旬奇外，还有天上三奇乙丙丁，地上三奇甲戊庚）"
      },
      {
        "key": "含义",
        "value": "凡事吉利，百祸消散。男人求婚，可配淑女。女人怀孕，能产贵儿。仕有奇遇，病获良医。凡事逢凶化吉，不忌刑杀。"
      },
      {
        "key": "注",
        "value": "甲子、甲戌旬奇在丑，甲申、甲午旬奇在子，甲寅、甲辰旬奇在亥。"
      },
      {
        "key": "注意",
        "value": "如果三奇空亡，精力不足，其福减半。先明后暗，吉凶无成。"
      },
      {
        "key": "占事",
        "value": "万事和合，千殃解除。"
      },
      {
        "key": "婚姻",
        "value": "男子求婚得淑女。"
      },
      {
        "key": "占孕",
        "value": "孕有贵儿。"
      },
      {
        "key": "求士",
        "value": "求士有奇遇。"
      },
      {
        "key": "占病",
        "value": "病获良医。"
      }
    ],
    [
      {
        "key": "五十七、励德课 随卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "贵人立于地盘卯酉宫上。"
      },
      {
        "key": "含义",
        "value": "利君子，不利小人。事多反复。"
      }
    ],
    [
      {
        "key": "励德格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "（干支）阳神在贵人前，阴神在贵人后；或（干支）阴神在贵人前，阳神居贵人后。"
      },
      {
        "key": "含义",
        "value": "阳神前引，阴神后随，则君子吉，小人危。若阴神前立，阳神后随，小人得意，君子失机。大体君子主迁动官位，平民主身宅不安，若安分循理，亦能获吉。"
      },
      {
        "key": "蹉跎格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支阴阳神都在贵人之前。"
      },
      {
        "key": "含义",
        "value": "主小人迁官，君子退职，利小人不利君子。"
      },
      {
        "key": "微服格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支的阴阳神均在贵人之后。"
      },
      {
        "key": "含义",
        "value": "主君子迁官，小人退职，利君子不利小人。"
      }
    ]
  ],
  "bifa": "46.贵人差迭事参差.夜贵在干前",
  "zhiZhi": "壬子日第一局干上亥\n课体：伏吟，励德，三奇，杜传。\n课义：德禄幸临，贪心再成，孟其兴旺，无礼遭刑。\n解曰：亥为德禄，临干发用，何其幸也。如不守其禄，而贪心未已，前就中传之子，以冀兴旺，则末传卯子无礼相刑，刑狱之遭，其能免乎。\n断曰：卦得三奇，祸消福长之象。况传课皆逢旺禄，凡谋俱吉。惟归计值空，事恐更变难成。且课体伏吟，宜静而不宜动耳。\n天时：晴占则晴，雨占更甚。\n家宅：德禄临干，旺神坐支，人宅鹹亨。\n功名：传课重逢旺禄，大利。\n求财：干支同类，恐有争夺。\n婚姻：支干比和，且乘旺禄，大吉。\n胎产：男子之祥，伏吟，占产尚迟。\n疾病：病属肾经，未能即愈。\n争讼：田庐致讼，可和。\n出行：不果。\n行人：未动。\n捕获：夜占即家中人作贼。\n兵战：防诈。\n毕法云：旺禄临身徒妄作。\n古鉴：辛卯人，戊申十一月卯加卯占家宅。\n曰：宅上帝旺，财物兴隆。中传是子，子边作亥似孙字，今年子及孙当进学。末传门户上有不宁，乃是户役事。门上不合安符，主不时吵闹。财禄甚稳，家当大发。但身有胸胱疝气，及阴肿水气之忧。尚有四四一十六年寿，当以阴肿而亡。盖亥数四，身与初传重见，旺则相倍之故也。其家果挂一天师，时有怪异，去之即安，余亦皆验。",
  "jiYingQian": "壬子日第一局干上亥\n课体：伏吟、三奇、夜励德（四课贵后为微服，凡事阴私利干贵）。\n又：此课先生曰：“此课财禄甚稳，但身有膀胱气，及阴肿水气之扰。宅上帝旺，财物兴隆。今年进子又进孙，中传及宅皆子也。子边著亥，乃孩字也。末传门户上有不宁，乃是户役事，门户不安。堂上不合安符，主家中无一时安静。而家势得池塘之利，必然大发。尚有四四一十六年，寿终时主阴肿而亡也。”王德卿乃是士人，善能治家，正值长旺，只是被膀胱病。其年三月进子，十二月进孙，又为户役所扰。堂中挂一天师符，自是梦寐不安，怪异影响，即却之，果无事。至辛酉年，王德卿死，寿六十一。自戊申年至辛酉年，一十六年，其家池塘最盛，一年有数万斤鱼利，盖缘壬子日亥子甚盛之乡，亥子为江湖所居，壬禄居亥而旺于子也。亥主四数，身与初传是两个四，所以言四四十六寿也。（《壬占汇选》作：王德卿辛西生，四十八岁占宅，戊申年十月壬子日卯时卯将）\n《玉历钤》云：课虽伏吟，中传青龙颇吉，占官不为用也。《赋》云：“青龙人海，宜求汗漫之财。”\n上神德日。\n课名：伏吟。诸神不动。壬得亥，为上下得禄，秋冬占大吉，须有事稍迟亦称，久久通利，虽中末子卯相刑，不为凶，但卯为空亡，吉不十全，忧可解。\n《义》曰：守之自足，仲冬纳福。有始无终，劳劳碌碌。病凶有解，谋望变更。机关万种，多失少成。\n《象》曰：莫厌人生处世难，穷通造化谩相看。成中又见无终始，勉强由来未保全。\n又：此自任之卦。夫自任者，乃天地伏吟，十二神各归本家，天地如一，四伏未发之象。占事静则宜，动则滞，主事藏匿不动，静中求劳，有屈而不伸之象。《经》云：“任信伏吟神，行人立至门。失物家内盗，逃者隐乡邻。病合难言语，占胎聋哑人。访人藏不出，行者却回轮。”占遇三奇，百事咸吉，三奇消除万祸，此之谓也。吉事愈吉，凶事即解，冬占为旺禄临身，不可舍禄而他求，恐不如意也。夜占为励德，大吏升迁，小吏速否。贵临二八，摇动迁移，修整而应。又谓之关格不通，下状多不理。占者遇之此课，占求官虽吉，不可太过用心，恐招不足，若有官守者，惟宜守于本等，加之公勤，则福禄自荣，不必他望也。占见贵者，始终有变。占婚姻勿成。占交易比和。占远行不利而有害，幸有维持。占求财难得，得之不能为用。占病者不妨，但倦言或不进饮食，先凶而后吉也，久病可忧，有德庶几。狱讼者，屈而后伸。行动不宜向西北戌方，避之免忧。逃亡纵得难用，忧惊渐解，甚勿畏之。\n占出兵行师得此：昼占防欺诈，夜占稍吉，有始而无终也。\n真一山人云：绿杨影里系扁舟，明月芦花满眼秋。看尽世间多少事，一蓑烟雨任遨游。\n《无惑钤》云：德禄幸临，贪心再成。欲其兴旺，无礼遭刑。\n《钤解》曰：亥乃日干之德禄，既幸临干，最宜坐守，亦自亨快。壬乃贪心不止，又援初传之德禄以成再成。欲就中传子水以冀兴旺，末传卯却刑子，遂为无礼，则刑狱之祸，不能免也。微服卦，《观月经》曰：“君子赐衣冠进秩，小人退位有灾忧。”",
