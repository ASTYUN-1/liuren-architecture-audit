  "keyi": "",
  "keJing": [
    [
      {
        "key": "元首课 乾卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "一上克下，余课无克，为元首课。"
      },
      {
        "key": "含义",
        "value": "尊制卑，贵制贱。占事多顺，忧喜皆实。事从外来，事起男子，宜主动。"
      },
      {
        "key": "注意",
        "value": "遇凶神恶将，上恶而下受欺；或上休囚而下得势，则下强而上受欺。"
      },
      {
        "key": "君王占得",
        "value": "有伊尹之臣"
      },
      {
        "key": "大臣占得",
        "value": "遇唐虞之右"
      },
      {
        "key": "常人占得",
        "value": "万事顺利"
      }
    ],
    [
      {
        "key": "三十、闭口课 遁卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "旬尾加旬首发用；旬首乘玄武发用；旬首上神乘玄武发用；三者有其一，即为真闭口课。"
      },
      {
        "key": "含义",
        "value": "主禁口闭缄，机关莫测，事机难明，逃亡难寻。失物人见而不肯言，纵乘贵告贵也不允。占讼有冤莫诉，有屈难伸。占孕生喑哑之儿。"
      },
      {
        "key": "注意",
        "value": "乘白虎占病，主痰气阻塞，喉肿舌禁。若兼无禄课体，主绝食而死。"
      },
      {
        "key": "求事",
        "value": "机关难测，事情的迹象难以明晰。"
      },
      {
        "key": "寻人",
        "value": "将没有踪影。"
      },
      {
        "key": "寻物",
        "value": "丢失物品别人看见也不肯说出来。"
      },
      {
        "key": "告贵",
        "value": "纵然乘责人，告贵也不得应允。"
      },
      {
        "key": "占孕",
        "value": "生喑哑之子。"
      },
      {
        "key": "占病",
        "value": "为痰塞气堵，喑哑之症，或者生口痢，或者喉塞不能进食。"
      },
      {
        "key": "占讼",
        "value": "有屈不能伸，有冤无处诉。"
      }
    ],
    [
      {
        "key": "五十七、励德课 随卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "贵人立于地盘卯酉宫上。"
      },
      {
        "key": "含义",
        "value": "利君子，不利小人。事多反复。"
      }
    ],
    [
      {
        "key": "励德格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "（干支）阳神在贵人前，阴神在贵人后；或（干支）阴神在贵人前，阳神居贵人后。"
      },
      {
        "key": "含义",
        "value": "阳神前引，阴神后随，则君子吉，小人危。若阴神前立，阳神后随，小人得意，君子失机。大体君子主迁动官位，平民主身宅不安，若安分循理，亦能获吉。"
      },
      {
        "key": "蹉跎格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支阴阳神都在贵人之前。"
      },
      {
        "key": "含义",
        "value": "主小人迁官，君子退职，利小人不利君子。"
      },
      {
        "key": "微服格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支的阴阳神均在贵人之后。"
      },
      {
        "key": "含义",
        "value": "主君子迁官，小人退职，利君子不利小人。"
      }
    ],
    [
      {
        "key": "六十二、间传课巽卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传相间隔一位递传。"
      },
      {
        "key": "含义",
        "value": "占事得此课，间位相传，事多间阻。"
      },
      {
        "key": "顺间传",
        "value": ""
      },
      {
        "key": "登三天格",
        "value": "三传辰午申"
      },
      {
        "key": "含义",
        "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
      },
      {
        "key": "涉三渊格",
        "value": "三传申戌子"
      },
      {
        "key": "含义",
        "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
      },
      {
        "key": "向三阳格",
        "value": "三传子寅辰"
      },
      {
        "key": "含义",
        "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
      },
      {
        "key": "出三阳格",
        "value": "三传寅辰午"
      },
      {
        "key": "含义",
        "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
      },
      {
        "key": "出户格",
        "value": "三传丑卯巳"
      },
      {
        "key": "含义",
        "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
      },
      {
        "key": "盈阳格",
        "value": "三传卯巳未"
      },
      {
        "key": "含义",
        "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
      },
      {
        "key": "变盈格",
        "value": "三传巳未酉"
      },
      {
        "key": "含义",
        "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
      },
      {
        "key": "入冥格",
        "value": "三传未酉亥"
      },
      {
        "key": "含义",
        "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
      },
      {
        "key": "凝阴格",
        "value": "三传酉亥丑"
      },
      {
        "key": "含义",
        "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
      },
      {
        "key": "溟濛格",
        "value": "三传亥丑卯"
      },
      {
        "key": "含义",
        "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
      },
      {
        "key": "（二）逆间传",
        "value": ""
      },
      {
        "key": "冥阴格",
        "value": "三传寅子戌"
      },
      {
        "key": "含义",
        "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
      },
      {
        "key": "悖戾格",
        "value": "三传戌申午"
      },
      {
        "key": "含义",
        "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
      },
      {
        "key": "顾祖格",
        "value": "三传午辰寅"
      },
      {
        "key": "含义",
        "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
      },
      {
        "key": "极阴格",
        "value": "三传丑亥酉"
      },
      {
        "key": "含义",
        "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
      },
      {
        "key": "时遁格",
        "value": "三传亥酉未"
      },
      {
        "key": "含义",
        "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
      },
      {
        "key": "励明课",
        "value": "三传酉未巳"
      },
      {
        "key": "含义",
        "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
      },
      {
        "key": "回明格",
        "value": "三传未卯巳"
      },
      {
        "key": "含义",
        "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
      },
      {
        "key": "转悖格",
        "value": "三传巳卯丑"
      },
      {
        "key": "含义",
        "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
      },
      {
        "key": "断间传格",
        "value": "三传卯丑亥"
      },
      {
        "key": "含义",
        "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
      }
