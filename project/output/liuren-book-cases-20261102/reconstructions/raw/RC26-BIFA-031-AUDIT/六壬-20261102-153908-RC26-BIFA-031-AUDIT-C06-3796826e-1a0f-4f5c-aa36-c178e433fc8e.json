  "keti": [
    "涉害",
    "见机",
    "间传",
    "顾祖"
  ],
  "keyi": "",
  "keJing": [
    [
      {
        "key": "涉害课 坎卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课之中同时出现多组上克下或下克上神，且同为阴神或阳神时，则以上神顺行回归地盘本宫，沿途被克的次数做比较。以涉害深（被克次数多）者作为初传。"
      },
      {
        "key": "含义",
        "value": "风波险恶，度涉艰难。舍轻就重，趋安避危之象，事宜见机而作。谋为利名，多费机关；婚姻有阻，疾病难安；胎孕迟滞，行人未还。失物还在家内，逃亡不远隐亲友家。"
      },
      {
        "key": "注意",
        "value": "神将凶，三四克，灾深难解；我克他，日辰旺，神将吉，受克浅，则忧浅易解。"
      },
      {
        "key": "占事",
        "value": "风波险恶，渡沙艰难。"
      },
      {
        "key": "谋事",
        "value": "先难而后可名成利遂，诸事多费苦心而后成，灾难消解较迟。"
      },
      {
        "key": "婚姻",
        "value": "婚姻有阻。"
      },
      {
        "key": "疾病",
        "value": "疾病难安。"
      },
      {
        "key": "逃亡",
        "value": "隐匿于朋友之家。"
      },
      {
        "key": "占孕",
        "value": "伤胎，胎孕迟滞。"
      },
      {
        "key": "占行",
        "value": "待人不来。"
      },
      {
        "key": "失物",
        "value": "物在家内。"
      }
    ],
    [
      {
        "key": "见机格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "当受害深浅一样时，先以四孟（寅申巳亥）上神取用者，为见机格。"
      },
      {
        "key": "含义",
        "value": "事之初起，祸福随之，见事必须见机而行。疑事须急改，犹豫必有失，因此也主事多反覆。多算胜少算不胜，将涉水不轻进之象。名利难遂，胎孕未实。"
      },
      {
        "key": "注意",
        "value": "神将吉以吉言，凶以凶论。"
      },
      {
        "key": "占事",
        "value": "有疑难急迫处，必须改变，否则有失。"
      },
      {
        "key": "占行",
        "value": "利涉大川，有孚贞吉。"
      },
      {
        "key": "名利",
        "value": "名利难递。"
      },
      {
        "key": "占孕",
        "value": "胎孕未实。"
      }
    ],
    [
      {
        "key": "六十二、间传课巽卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传相间隔一位递传。"
      },
      {
        "key": "含义",
        "value": "占事得此课，间位相传，事多间阻。"
      },
      {
        "key": "顺间传",
        "value": ""
      },
      {
        "key": "登三天格",
        "value": "三传辰午申"
      },
      {
        "key": "含义",
        "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
      },
      {
        "key": "涉三渊格",
        "value": "三传申戌子"
      },
      {
        "key": "含义",
        "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
      },
      {
        "key": "向三阳格",
        "value": "三传子寅辰"
      },
      {
        "key": "含义",
        "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
      },
      {
        "key": "出三阳格",
        "value": "三传寅辰午"
      },
      {
        "key": "含义",
        "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
      },
      {
        "key": "出户格",
        "value": "三传丑卯巳"
      },
      {
        "key": "含义",
        "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
      },
      {
        "key": "盈阳格",
        "value": "三传卯巳未"
      },
      {
        "key": "含义",
        "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
      },
      {
        "key": "变盈格",
        "value": "三传巳未酉"
      },
      {
        "key": "含义",
        "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
      },
      {
        "key": "入冥格",
        "value": "三传未酉亥"
      },
      {
        "key": "含义",
        "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
      },
      {
        "key": "凝阴格",
        "value": "三传酉亥丑"
      },
      {
        "key": "含义",
        "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
      },
      {
        "key": "溟濛格",
        "value": "三传亥丑卯"
      },
      {
        "key": "含义",
        "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
      },
      {
        "key": "（二）逆间传",
        "value": ""
      },
      {
        "key": "冥阴格",
        "value": "三传寅子戌"
      },
      {
        "key": "含义",
        "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
      },
      {
        "key": "悖戾格",
        "value": "三传戌申午"
      },
      {
        "key": "含义",
        "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
      },
      {
        "key": "顾祖格",
        "value": "三传午辰寅"
      },
      {
        "key": "含义",
        "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
      },
      {
        "key": "极阴格",
        "value": "三传丑亥酉"
      },
      {
        "key": "含义",
        "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
      },
      {
        "key": "时遁格",
        "value": "三传亥酉未"
      },
      {
        "key": "含义",
        "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
      },
      {
        "key": "励明课",
        "value": "三传酉未巳"
      },
      {
        "key": "含义",
        "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
      },
      {
        "key": "回明格",
        "value": "三传未卯巳"
      },
      {
        "key": "含义",
        "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
      },
      {
        "key": "转悖格",
        "value": "三传巳卯丑"
      },
      {
        "key": "含义",
        "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
      },
      {
        "key": "断间传格",
        "value": "三传卯丑亥"
      },
      {
        "key": "含义",
        "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
      }
    ]
  ],
  "bifa": "02.首尾相见始终宜.B.回环格\n05.六阳数足须公用.A.六阳格\n24.我求彼事干传支\n25.金日逢丁凶祸动.A.火鬼蛇雀克宅格.昼\n26.水日逢丁财动之.A.财乘丁马格.②财乘驿马\n30.屋宅宽广致人衰.B.狮兽冲宅格.昼虎\n37.末助初兮三等论.Ⅱ.克干\n37.末助初兮三等论.A.抱鸡不斗格\n37.末助初兮三等论.C.谒求祸出格\n37.末助初兮三等论.D.自招其祸格\n38.闭口卦体两般推.Ⅱ.玄武乘旬首\n43.害贵讼直作屈断.Ⅰ.害昼贵\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干后\n63.彼此全伤防两损\n69.虎乘遁鬼殃非浅.夜虎",
  "zhiZhi": "庚辰日第三局干上午\n课体：涉害，见机，间传，顾祖。\n课义：彼此不和，寅来教唆，尊求卑下，莫被财魔。\n解曰：干被午克，支被寅克，彼此皆受克制，不能和美。而寅为日财，乃助初克日，有如教唆词讼之人，若取此财，必生灾悔矣。自干传支，是谓以尊求卑，谦下乃宜也。末传寅财来冲庚位，当视如魔怪，不可为其所惑。\n断曰：此见机之卦，事多阻滞，虚声无实，吉不成吉，凶不成凶。改变动移，贵乎得中守正。又贵人立卯酉，大位者占之，必主升迁荣庆，常人则身宅不安也。\n天时：占晴未晴，占雨未雨，必待出旬。\n家宅：不安，宜谢土神，或有孕女借歇。\n婚姻：不宜。\n胎产：占胎安，占产不宜。\n功名：官禄空亡不利，惟五月昼占吉，可得科名。\n求财：防因财而致祸。\n投谒：主宾客会集。\n疾病：月内见凶。\n失脱：宜寻，逃亡自归。\n出行：不利。\n行人：即至。\n争讼：主有教唆之人，或为吏曹，或为道士，或有胡须人，或姓从木旁人，或属虎人。\n兵战：昼占大胜，夜占众心不宁。\n毕法云：干支全伤防两损，我求彼事干传支。\n精蕴云：末虽助初而坐空乡，无力克干，为抱鸡不斗之象。又午辰寅为顾祖格，盖午为寅之子孙，寅乃午之长生，自午传寅有复旧庐之象。凡谋皆吉，惟庚日占病凶也。",
  "jiYingQian": "庚辰日第三局干上午\n课体：涉害、顾祖、励德、六阳。\n又：此课日上发传，退入支上，又是顾祖，末又见本命入宅，必是差出，经过仙里，而有是非，不然，须有甚不到处。不合日上退归本命而人宅，为蛇所扰，又是共屋人之事。主簿大族，现被诸房分多，遂经台部文字下，令知县差人押归本家，分析了，即令赴任。主簿被押归家，分未平，又占获房分，又人状监司，奏罢下狱，方始分成。日上午为堂，同居人为鬼，青龙在申，欢中生悲，退鳞甲，失财损身之兆。午是初传，已自是不好，不合中传辰又归午上，愈增其畏。末传寅木，生起午火，只管克庚金。命是戊寅生，是我倒去生火，毕竞是我自不是，致令得他如此。况在任，只要升，便有迁转之意。今传自上降下，又却自日回辰，是自外回家，岂不倒退？兼又是顾祖课，自然如是，何疑之有？况庚日以寅为财，是争财也。本命作财，是我与彼争也。腾蛇在寅，是我自被扰也。行年夜贵人作天空而闭口，是所生之官勿可告也，夜贵人废职无用也。未为眷属，天空主有争竞，是因眷属而争，而贵人在夜，无用而闭口也。续后主簿回任，宅居相隔不远，不知后面事物如何也（《壬占汇选》作：己酉年十月庚辰日寅将辰时，陈主簿戊寅生三十二岁，占官任吉凶及问升迁）。\n《玉历钤》云：此课初传克日，末传教唆，主官司牢狱不测之忧。见贵、求望、求婚、求财，一切不成。青龙作官，却宜求名。产即生，有灾。逃盗可获。行人将至。出入不利。\n又有刘监仓，本年庚午，三十九岁，已酉年正月初一日占年内之事，亦得此。先生曰：“此课日鬼传归宅，宅上神又生鬼，一防仓库有火灾，二防值事人或走或非理致死，三防妻有暴风暴病之惊。正月小子非灾，防有退失，二月因省墓起山林之扰，三月妻忧，四月官长追迫，五月当值人有失，六月、七月防火，八月因闲贵内扰，九月横财，财中有失，十月婢妾阴私酒色上有失，十一月仆走，十二月媳妇有服。”本年七月二十三日，邻仓火发，遂烧仓。《经》云：“火鬼春归午，夏月逐鸡飞。三秋寻鼠穴，冬与兔相期。”本身值火星，又传从火上起，末传寅木，木又生火。五月十四日夜，一当值人差去捉人，遂暗里堕于深坑中死。三月七日，妻偶中风，遂成重病，几不可救。其余十二月分，并依前断，祸福皆应。又况午为仓库，火鬼来乘克身，身便是本职。至九月，其妻家兄弟争分，他又在官上请假半月与分，得田产钱物二千余缗，却遣人赍此前往行在处卖木（当作买米），为贼人所劫。信造物虽注定，又见先生之言分毫不差矣（《壬占汇选》作：己酉年正月初一庚辰日子将寅时，刘监仓庚午生三十九岁，生于庚午年四月二十九日，占年内事）。\n《毕法》云：此课初传午从干上起，末传寅归于支上，凡事勉强，不免俯就于人，亦为人抑勒，难自伸屈，最宜谨恭卑下可也。又云：久动思静，欲得干传归支，盖干常动、支常静故也。\n上神克日，辰上生日上，用克日。\n课名：涉害、间传。用日上，中辰上，又三合。初火末木，末助初鬼，末传财，凡占先难后易，先破后成。\n《义》曰：事多虚惊，徒自未宁。有声无实，岂得为凭？进退不定，见机而用。事有先期，惟宜守正。\n《象》曰：顾祖迎亲复旧庐，求财谋望始堪图。惟有庚日不宜见，鬼来又入鬼乡居。\n又：此见机之卦，一曰天网，亦曰励德。夫见机者，察其微，见其机，谓两比两不比，当以涉害为用。涉害有浅深，欲用不用，欲言不言，事有两而取一，所作稽留，迟疑艰难，进退不定，忧患难消，怀孕伤胎，难于前而易于后。且天网者，即天网四张也，《经》曰“天网四张，万物被伤”，为阻滞，为疑难，为灾恼。况励德，阴小有灾，此名关隔神。常人占此，身宅不安，宜谢土神，贵吏则主升迁，要当消息而论也。以此发用，乃近于真腾蛇，占者有大惊恐。午辰寅退间传也，格名顾祖，事有间隔。上神克日，利先讼，要有气，常人不利，或被人欺负。占者遇之此课，求官宜大位者，须见阻滞。婚姻不宜。交易合而未遂。投谒人者，“主宾际会两殷勤，暮宴朝欢会无极”也。求财者，恐因财而致祸。占病者，胸中主隔塞不通。失物勿寻。逃者自归。讼不吉，有教唆之人，宜为和好。远行不宜。\n若出兵行师得此，昼占大胜犹可深谋，夜占众畏而忧惊不宁。大抵此课，吉中隐凶，凶中隐吉，若晴雨之象，兼奸强之相伴也。用兵者如此，须见机察微，以取战胜之功可也。\n事多阻隔。\n真一山人云：吉非吉象又非凶，改变之时贵得中。多少惊忧从此散，谁知谋事更无功。\n《无惑钤》云：彼己不利，寅来教唆。尊求卑下，暮取财疴。\n《钤解》曰：干被午克，支被寅克，则彼己不利也矣。寅乃日财，助初克干，如教唆词讼之人也，若取此财，则必有祸矣。自干传支，以尊求卑也，谦下乃宜。寅为教唆人，或为官吏曹，为道士，有胡须，或属虎人，或姓从木旁人，皆是，详天将逐类而言之。或年命自助其初传而克日干者，乃自招其祸，名曰放火自焚。",
