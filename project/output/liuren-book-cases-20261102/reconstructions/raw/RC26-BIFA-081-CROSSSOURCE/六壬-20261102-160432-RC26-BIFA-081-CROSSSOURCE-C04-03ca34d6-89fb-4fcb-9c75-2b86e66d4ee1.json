  "keJing": [
    [
      {
        "key": "涉害课 坎卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课之中同时出现多组上克下或下克上神，且同为阴神或阳神时，则以上神顺行回归地盘本宫，沿途被克的次数做比较。以涉害深（被克次数多）者作为初传。"
      },
      {
        "key": "含义",
        "value": "风波险恶，度涉艰难。舍轻就重，趋安避危之象，事宜见机而作。谋为利名，多费机关；婚姻有阻，疾病难安；胎孕迟滞，行人未还。失物还在家内，逃亡不远隐亲友家。"
      },
      {
        "key": "注意",
        "value": "神将凶，三四克，灾深难解；我克他，日辰旺，神将吉，受克浅，则忧浅易解。"
      },
      {
        "key": "占事",
        "value": "风波险恶，渡沙艰难。"
      },
      {
        "key": "谋事",
        "value": "先难而后可名成利遂，诸事多费苦心而后成，灾难消解较迟。"
      },
      {
        "key": "婚姻",
        "value": "婚姻有阻。"
      },
      {
        "key": "疾病",
        "value": "疾病难安。"
      },
      {
        "key": "逃亡",
        "value": "隐匿于朋友之家。"
      },
      {
        "key": "占孕",
        "value": "伤胎，胎孕迟滞。"
      },
      {
        "key": "占行",
        "value": "待人不来。"
      },
      {
        "key": "失物",
        "value": "物在家内。"
      }
    ],
    [
      {
        "key": "三十四、赘婿课 旅卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "有两种，干加支上克支；支加干上受干之克；"
      },
      {
        "key": "含义",
        "value": "主曲意从人，事多牵连。胎孕迟延，行人淹滞。财名可成，病讼未济。兵利为客，先动多胜。"
      },
      {
        "key": "注意",
        "value": "如果年命得吉神吉将，又名赘婿当权，或末传有救亦是，仍可摆脱牵制，任意所为。"
      }
    ],
    [
      {
        "key": "曲直格（曲直课）",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传亥卯未，合为木局。或者寅卯辰属东方一气，也属此格。"
      },
      {
        "key": "含义",
        "value": "冬春占吉。占事主进退未决，动则如意，不动多不安宁，先难后易，先曲后伸之象。自下传上则直，未加亥是也。自上传下则曲，亥加未是也。卯加亥先曲后直，卯加未先直后曲。先曲后直者，始难终易，先直后曲者，有始无终。木主风，风传事多不实，病因风肝症，宜托人求贵暗祷。凡亥加未作雀，望信未来，雀内战也。亥加未作蛇内战，主失财。卯加未作虎身灾，克命尤应。未加卯作后，阴人灾病，有离哭之兆。失物藏茂林木器中。曲直作鬼，讼主枷杻。己日根固者，木得土为根也。丁日枝枯者，火脱木也。此以成局论也。若以日干论，则干己为官鬼，干丁为父母矣。大约君子吉小人凶。"
      },
      {
        "key": "占事",
        "value": "主进退未决，动则如意，不动则不宁。利则作舟车、修营、栽植。."
      },
      {
        "key": "占病",
        "value": "为风肝之症。"
      },
      {
        "key": "求事",
        "value": "宜于托人、求贵、暗祷。"
      },
      {
        "key": "占讼",
        "value": "宜求和，否则有枷相之灾。"
      }
    ]
  ],
  "bifa": "02.首尾相见始终宜.B.回环格\n06.六阴相继尽昏迷.A.六阴格\n28.传鬼化财钱险危\n28.传鬼化财钱险危.D.危中取财格\n29.眷属丰盈居狭宅.B.赘婿卦.①脱支\n43.害贵讼直作屈断.Ⅰ.害昼贵\n43.害贵讼直作屈断.Ⅰ.害夜贵\n43.害贵讼直作屈断.Ⅱ.先曲后直\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干前\n47.贵虽在狱宜临干\n49.两贵受克难干贵.A.白虎或乘临丑格.昼\n85.初遭夹克不由己.昼\n86.将逢内战所谋危.夜",
  "zhiZhi": "己亥日第九局干上亥\n课体：涉害，曲直，不备，赘婿。\n课义：财就身宫，恋则为凶，只宜早弃，免被贼通。\n解曰：支财临干，财临身也。取之本无不可，但亥之上神为卯，乃是日干之鬼。若不急弃，则支上之卯，会成木局伤身，祸不免矣。况卯为太冲，上乘元武，皆贼象也。亥卯未一经作合，是与贼通，所得之财，岂能享乎。\n断曰：赘婿之卦，又四课不备，支上乘脱，必无正屋可居，亦俯首于人之象。课传回环，吉凶俱成，最不利于解散忧疑之事。木局传鬼乘财，只可携财告贵，纳粟奏名。\n天时：青龙发用，但水被日克，三传木局，雨少风多。\n家宅：满盘官局，而身受制，却宜胥役。\n仕宦：官星甚旺，再得文书，方为全美。\n求财：禁止贪心，庶可远害。\n婚姻：神吉将凶，成而不美。\n胎产：课传纯阴，又曰不备，产必弄瓦。\n疾病：夜虎乘卯，脾胃受伤，课传皆鬼，病笃难瘥。\n出行：陆路稍可，水路不吉。\n行人：天罡加仲，尚在中途。\n遗失：元武脱宅，盗失难免，贼众太旺，难于捕获。兵战；迭为宾主，名有所伤。\n毕法云：初遭夹克不由己(昼占)。\n指南：癸未正月亥将未时，有客来占，曰:龙神发用，课传结成官局，来意必占今岁功名，六月即有钦召之应。盖木遇春旺，夏则密茂，将来事业远大。缘岁建皇恩发用，中传天诏，故六月定有佳音也。果于是月奉诏进京，授京营提督，复升戎政。",
  "jiYingQian": "己亥日第九局干上亥\n课体：沙害、曲直、不备、赘婿。\n《玉历钤》云：此课青龙吉神为官，临日发用，求官颇吉，余占不遂。\n《毕法》云：此课干克支亥为财，亥之本家，上乘干鬼，此财乃至险至危之财，贪者取之，必致鬼来为害。又云：支亥加干，而被干克，乃赘婿也。支辰上又乘脱气，凡占必无正屋可居，寄身于人，虽仕宜亦借赁也，然又有招赘寄养之象。\n日克上神，日上生辰上，用克日上，末克初。\n课名：涉害、曲直、芜淫、不备、无阳。事主委曲托人，重重不能如意，且有鬼贼，稍可求官、费力后成，谋望更改，利君子，不利小人。\n《义》曰：德变为仇，恩化为怨。合中有煞，藏刀笑面。君子知机，宽正为福。用心防范，犹见不足。\n《象》曰：对面人心有虎狼，谁知好里恶心肠。事将成就连他破，蜜里含砒有祸殃。\n又：此见机之卦，一日龙战，亦曰曲直，一曰洗女。夫见机者，察其微，见其机，谓两比两不比，当以涉害为用。涉害有浅深，欲用不用，欲言不言，事有两而取一，所作稽留，迟疑艰难，进退不定，忧患难消，怀孕伤胎，难于前而易于后。况龙战，主人心疑惑，进寸退尺，动有乖离之象。卯酉为天之私门，生杀有限，分杜有期，雷动龙奔，示其有战。况曲直者，先曲而后直也，象木之谓。此乃五行正气人十干杂糅之乡，三合异方乃生旺慕之神，事主丛杂不一，主关众人共谋，不然两三处干事，委曲托人与人相合之类。且洗女，《经》云：“天后常为厌翳神，须知六合是私门。二将取名称洗女，夫妇失友异情恩。”夫洗女乃不正之课，占男女有阴私暗昧之理，占家宅防阴小有越礼犯分者，占婚姻媒妁不明，惟能以礼自防者，谨于闺门而自化也。占者遇之此课，若占求官见贵，凡百虽吉，但防笑里刀、密中砒，恩变为仇。病者重。但占事忧释惊散。其他所占，皆美中不足。\n占出兵行师得此：昼占大胜，夜占无威。敌使之来，有益于我，事见两家相和，而无斗战之意也。\n春吉。恩中致怨。\n真一山人云：莫讶人心隐祸殃，平生点检自行藏。自心无恶从他恶，天理循环报应彰。\n《无惑钤》云：财临身宫，恋则为凶。只宜早弃，免致贼攻。\n《钤解》曰：亥来临干，财临身也，宜急取即得，若少缓，支上之卯随即而至，凶祸不能免也。况卯为太冲，上乘玄武，皆贼也。亥卯未相合而聚，则通矣，所得之财，恐不能享。贪而吝惜，能无患乎？《集议》：占讼先曲后直，且“害贵讼直遭屈断”内，曲直作鬼，主枷扭。回还格。“传财化鬼财休觅”内列此日。“眷属丰盈居狭宅”内列此日，谓支加干被克，又为上神所脱，占人必无正屋可居。上传下则曲，亥加未也，占讼枷扭。卯加亥，先曲后直。",
