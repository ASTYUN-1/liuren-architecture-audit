  "keJing": [
    [
      {
        "key": "九、伏吟课 艮卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
      }
    ],
    [
      {
        "key": "伏吟课",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
      },
      {
        "key": "含义",
        "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
      },
      {
        "key": "注意",
        "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
      },
      {
        "key": "科举",
        "value": "必定高中，求名荣归。"
      },
      {
        "key": "疾病",
        "value": "有忧，或起怪异之事。"
      },
      {
        "key": "诉讼",
        "value": "为争夺田产成家宅。"
      },
      {
        "key": "灾祸",
        "value": "春冬较浅，秋夏势危。"
      },
      {
        "key": "行事",
        "value": "律身谨慎，动作无虞。"
      }
    ],
    [
      {
        "key": "自任格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课，上下无克。日干为阳干，日上神为用，名自任格。"
      },
      {
        "key": "含义",
        "value": "刚愎自用，崭露头角后即有闭塞之兆。凡事过分，易招过失。等人立至，离家逃亡者可在附近寻获。孕产废婴。若占事，祸患会连续发生。三传中见驿马，主待时而动，或不得已而动，亦主动中有成。访人不遇，家中不安，恐有哭泣和离别事。"
      },
      {
        "key": "注意",
        "value": "日辰发用旺相，再乘吉将，仍以吉论。"
      },
      {
        "key": "占事",
        "value": "做事刚烈暴躁，易成过失。"
      },
      {
        "key": "行人",
        "value": "等人将至，逃亡者就在附近。"
      },
      {
        "key": "占孕",
        "value": "不吉，产废晏。"
      },
      {
        "key": "灾锅",
        "value": "祸患留连。"
      },
      {
        "key": "干谒",
        "value": "不宜出门干谒他人，守株待兔方为吉。"
      }
    ],
    [
      {
        "key": "六十、元胎课 家人卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
      },
      {
        "key": "含义",
        "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
      },
      {
        "key": "注意",
        "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
      }
    ],
    [
      {
        "key": "绝胎格",
        "value": "元胎课逢反吟，虽开花但不结子。"
      }
    ],
    [
      {
        "key": "病胎格",
        "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
      }
    ],
    [
      {
        "key": "生胎格",
        "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
      }
    ],
    [
      {
        "key": "蓦越格",
        "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
      }
    ]
  ],
  "bifa": "24.我求彼事干传支\n30.屋宅宽广致人衰.B.狮兽冲宅格.昼虎\n31.三传递生人举荐.B.支干相生格\n31.三传递生人举荐.C.两面刀格.①\n32.三传互克众人欺\n37.末助初兮三等论.Ⅰ.生干\n38.闭口卦体两般推.Ⅰ.玄武临地盘旬首\n38.闭口卦体两般推.Ⅱ.玄武乘旬首\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n70.鬼临三四讼灾随\n75.宾主不投刑在上.Ⅲ.三字刑\n76.彼此猜忌害相随.Ⅱ.干支上神作六害\n76.彼此猜忌害相随.Ⅲ.干支天盘、地盘皆作六害\n76.彼此猜忌害相随.Ⅳ.干支三传作六害\n76.彼此猜忌害相随.Ⅴ.干支上下交互作六害\n89.任信丁马须言动.乘马",
  "zhiZhi": "戊寅日第一局干上巳\n课体：伏吟，自任，元胎。\n课义：连名状论，台阁上言，我求于彼，顺受和焉。\n解曰：初克中，中克末，末克干，三传递克，平日所为凶横，被人连名攻讦也。仕途则防台阁上言，宜自检束。自干传支，为我有求于彼，虽彼递相克制而来，我惟顺以受之。末助初生，终归于和而后已焉。\n断曰：此自任之卦，课传皆孟，格合元胎，有屈而不伸，伏而未发之象。事多暗昧，守正而静则亨，妄为而动则滞。又三传自内向外，迤逦递克，直至于干，其势可畏。喜中传折腰，末助初生，祸或中止，而反得阴助也。\n天时：昼占无雨，夜占有雨而尚远。\n家宅：昼占有火烛惊怪，夜占安稳。\n婚姻：夜占可成，防女不永。\n胎产：昼占有惊，夜占生男。\n功名：宜荫职，余防被劾。\n求财：艰难，夜占可得。\n投谒：半途而废。\n疾病：猝病凶，久病无妨。\n失脱：家内人盗窃，逃者隐乡邻。\n出行：夜占及申年月宜。\n行人：中路被阻，出旬始至。\n争讼：始干众怒，终得解。\n兵战：不利，宜静以待动。\n毕法云：我求彼事干传支，三传互克众人欺。\n秘要云：寅能助初生干，亦能克干，是两面刀。\n指南：癸酉六月未时，占官曰：斗罡居支前，传课刑克，蛇鬼入宅，龙神伤岁，当防弹章，人秋果被劾解任。",
  "jiYingQian": "戊寅日第一局干上巳\n课体：伏吟、玄胎、折腰。\n三传互克众人欺（幸日上神生日，中传折腰）。\n《玉历钤》云：此课惟求官颇吉，他事有阻。\n《毕法》云：此课初传从干上起，末传归于支上，凡事勉强，不免俯就于人，亦为人抑勒，难自伸展，只宜谦卑逊顺，斯免咎矣，若气高志傲，百事不举。又云：初传虽生日，初却克末，末克日干。始者巳火生戊土，是成事者巳也，次后迤逦克戊土，是败事者亦巳也，谚云“成也萧何，败也萧何”。然中间最害戊者是寅，此寅却有好意存焉。巳火之生戊，全赖寅木之助，此寅木又始则攻之，终则荐之，又非巳之比矣。又云：昼占三重白虎，却助巳，作戊之长生，此不幸中遇幸也。夜占吉神青龙，却作戊之鬼贼，此幸中之不幸也。\n上神德日，辰上生日上。\n课名：伏吟。神各归方，勾雀并临日，有招乎信至。无恩刑，彼此相制，凡事止而复行，重求轻得，终始是日辰，不可失也，中有小阻耳。\n《义》曰：自内向外，迤逦克伐。知者见机，勿为亵狎。屈而不伸，此理最真。昼夜得此，未免生嗔。\n《象》曰：迁官捧印沐恩光，拜舞枫宸喜气扬。头角峥嵘生变化，追风破足漫消详。\n又：此自任之课，一曰玄胎。夫自任者，乃伏吟之课，天地伏吟，十二神各归本家，天地如一，四伏未发之象。占者静则宜，动则滞，主事藏匿不动，静中求劳，有屈而不伸之象。况玄胎如婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不通，触则成祸，惟君子守正修德则亨。又曰：“占遇玄胎，室孕婴孩”，不利占老人小儿病，谓之再投胎。《经》云：“任信伏吟神，行人立至门。失物家内盗，逃者隐乡邻。病合难言语，占胎聋哑人。访人藏不出，行者却回轮。”占者遇之此课，必有人递互而相来克害，遂使众口一词，若常人平日所为不合于礼，遂被邻友雷攻论诉，有位者宜自检束，不然合台上言之意，幸中传空亡为解散，不可不知也。占求官见贵者，虽见日禄、日马，惜者中传折腰，若年月在申，或用申将，庶几有成，余皆未美。婚姻、求财、交易、投谒、谋干、远行、望信者，难必矣。惟利占暴病、患难、诉讼、惊恐之事，难中生易而有解也。占逃亡，终见自归。\n占出兵行师得此：最忌伏吟未美，况昼夜天将皆凶可畏，所幸中传为解。若不得已而用之，须密加详审，深谋远虑，庶几以全。兵家之道，尤防欺诈不实之事。\n中道而废，诚恐又发。\n真一山人云：吉凶易理自分明，好事中间又未成。善恶两般勿足论，半途而废听虚声。\n《无惑钤》云：连名状论，合台上言。我求于彼，顺受和焉。\n《钤解》曰：三传互克众人欺，谓初克中、中克末、末克干。常人若平日所为凶横，被人攻讦；朝官防合台上言，宜自检束。自干传支，我求于彼，占讼顺受讲和为妙。《集议》：末助初生，翻为两面刀，又为萧何之喻。",
