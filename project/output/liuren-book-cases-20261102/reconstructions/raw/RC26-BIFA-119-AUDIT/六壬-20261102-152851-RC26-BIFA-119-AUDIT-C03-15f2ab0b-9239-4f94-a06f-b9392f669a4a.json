  "keJing": [
    [
      {
        "key": "重审课 坤卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
      },
      {
        "key": "含义",
        "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
      },
      {
        "key": "注意",
        "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
      },
      {
        "key": "占事",
        "value": "宜后起，祸由内生。"
      },
      {
        "key": "兵事",
        "value": "用兵主胜。"
      },
      {
        "key": "占孕",
        "value": "主生女。"
      },
      {
        "key": "谋望",
        "value": "主先难后成。"
      },
      {
        "key": "诉讼",
        "value": "后者胜，对被告有利。"
      },
      {
        "key": "初传为墓绝，末传为生旺",
        "value": "灾祸消解，事终有成。"
      },
      {
        "key": "初传为生旺，末传为墓绝",
        "value": "先易后难，先得后失。"
      },
      {
        "key": "初传克末传",
        "value": "有凶兆"
      },
      {
        "key": "末传克初传",
        "value": "为吉兆，"
      },
      {
        "key": "末传天将为龙、常、阴。后、",
        "value": ""
      },
      {
        "key": "六合等吉将，或为德、喜等吉神",
        "value": "逢凶化吉。"
      }
    ],
    [
      {
        "key": "三十四、赘婿课 旅卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "有两种，干加支上克支；支加干上受干之克；"
      },
      {
        "key": "含义",
        "value": "主曲意从人，事多牵连。胎孕迟延，行人淹滞。财名可成，病讼未济。兵利为客，先动多胜。"
      },
      {
        "key": "注意",
        "value": "如果年命得吉神吉将，又名赘婿当权，或末传有救亦是，仍可摆脱牵制，任意所为。"
      }
    ],
    [
      {
        "key": "六十二、间传课巽卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传相间隔一位递传。"
      },
      {
        "key": "含义",
        "value": "占事得此课，间位相传，事多间阻。"
      },
      {
        "key": "顺间传",
        "value": ""
      },
      {
        "key": "登三天格",
        "value": "三传辰午申"
      },
      {
        "key": "含义",
        "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
      },
      {
        "key": "涉三渊格",
        "value": "三传申戌子"
      },
      {
        "key": "含义",
        "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
      },
      {
        "key": "向三阳格",
        "value": "三传子寅辰"
      },
      {
        "key": "含义",
        "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
      },
      {
        "key": "出三阳格",
        "value": "三传寅辰午"
      },
      {
        "key": "含义",
        "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
      },
      {
        "key": "出户格",
        "value": "三传丑卯巳"
      },
      {
        "key": "含义",
        "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
      },
      {
        "key": "盈阳格",
        "value": "三传卯巳未"
      },
      {
        "key": "含义",
        "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
      },
      {
        "key": "变盈格",
        "value": "三传巳未酉"
      },
      {
        "key": "含义",
        "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
      },
      {
        "key": "入冥格",
        "value": "三传未酉亥"
      },
      {
        "key": "含义",
        "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
      },
      {
        "key": "凝阴格",
        "value": "三传酉亥丑"
      },
      {
        "key": "含义",
        "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
      },
      {
        "key": "溟濛格",
        "value": "三传亥丑卯"
      },
      {
        "key": "含义",
        "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
      },
      {
        "key": "（二）逆间传",
        "value": ""
      },
      {
        "key": "冥阴格",
        "value": "三传寅子戌"
      },
      {
        "key": "含义",
        "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
      },
      {
        "key": "悖戾格",
        "value": "三传戌申午"
      },
      {
        "key": "含义",
        "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
      },
      {
        "key": "顾祖格",
        "value": "三传午辰寅"
      },
      {
        "key": "含义",
        "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
      },
      {
        "key": "极阴格",
        "value": "三传丑亥酉"
      },
      {
        "key": "含义",
        "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
      },
      {
        "key": "时遁格",
        "value": "三传亥酉未"
      },
      {
        "key": "含义",
        "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
      },
      {
        "key": "励明课",
        "value": "三传酉未巳"
      },
      {
        "key": "含义",
        "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
      },
      {
        "key": "回明格",
        "value": "三传未卯巳"
      },
      {
        "key": "含义",
        "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
      },
      {
        "key": "转悖格",
        "value": "三传巳卯丑"
      },
      {
        "key": "含义",
        "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
      },
      {
        "key": "断间传格",
        "value": "三传卯丑亥"
      },
      {
        "key": "含义",
        "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
      }
    ]
  ],
  "bifa": "06.六阴相继尽昏迷.A.六阴格\n38.闭口卦体两般推.Ⅴ.旬尾加旬首\n44.课传俱贵转无依.Ⅱ.传俱贵\n45.昼夜贵加求两贵\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干前\n48.鬼乘天乙乃神祗.Ⅲ.昼贵在六处\n52.罡塞鬼户任谋为.B.神藏煞没格.夜贵",
  "zhiZhi": "丁巳日第三局干上巳\n课体：重审，不备，间传，极阴，寡宿，赘婿。\n课义：丁马俱现，人宅相恋，亥水全亏，两贵相见。\n解曰：干上巳为旬丁，中传亥为日马，课传俱见，动不容己。本日之支来加干上，又乘生气，是人宅相恋也。发用空脱，亥贵落空，而又上下受克，全然无气矣。末虽两贵相加，但五阴相继，利私而不利公，虽有动意，亦不甚发皇耳。\n断曰：课名极阴，诸占昏晦，又名间传，进步艰难。赘婿不能自由，寡宿不能作实。三传空二，独存一酉。唯夜占财贵为相宜也。\n天时：课传六阴，浓阴之象。\n家宅：败气临宅，日渐衰微。\n功名：贵人坐空临绝，不吉。\n求财：宜得阴贵人之财。\n婚姻：课名赘婿，以女就男则吉。\n胎产：阴极阳生，孕男，难产。\n疾病：肝胆受病，或大小肠之疾。\n出行：人宅眷恋不行。\n行人：未至。\n捕获：难擒。\n兵战：夜占可畏，劳师无益。\n毕法云：昼夜贵加求两贵。\n古鉴：丁巳五十二岁，戊申六月未将酉时，占家宅，曰:丁火自旺方逆归死绝之地，宅上之卯，末传之酉，皆六数，主六年败尽产业，兼退人口。宅前有大朽木，宜急去之，否则生事。缘卯有乙木，上乘天空，故主朽也。又阁后作猪栏，猪盛克人，四年败坏，六年尽废矣。盖五为后阁，亥为猪也。酉为婢，为今日之死神，主本年十月婢死厕中。缘亥为日干绝神，又为污秽之地故也，悉验。",
  "jiYingQian": "丁巳日第三局干上巳\n课体：重审、极阴、寡宿、六阴。\n昼夜贵加求两贵。\n又：此课六阴相继，更无阳神，兼六月占，又是阴月，丁巳土命，又是阴命，从此衰败不振，兼不测，退人口。丁巳之火，上自旺方逆归死绝湮没之地。宅前有大朽之树，急宜去之，若不去之生事。有一子，患腹气。又不合将后阁为猪栏养猪，猪盛克人，主四年败，六年尽废也。童保义因地方寇发，遂得名目，自后成家延盛。及邵先生占云“四年败退，六年败尽”，彼不甚信。当年十月，一婢因上厕，不知觉死于厕中，是不测，退人口也。宅前果有二百余年大枫树，已朽大半，系族人亲坟。十二月，外乡一人来枫树上自缢。更第二子常患痹气，次年二月亡。其人家屋阔，兄弟分出去了，无人居，遂将后阁养猪。第四年拆四畔闲屋，六年果败尽，见存止有五口，移出店屋歇矣。凡丑亥酉卯此四支，邵先生皆以为极阴课，那又丁巳日，遂退归幽阴之地、死绝之方。宅上卯、末传酉，皆六数，故主六年败尽。加于巳亥上，四数，主四年败。卯来加宅，甲寅旬有乙卯真木，故有大树在门前，天空主朽。丑为阁，亥加丑上，故阁养猪。酉加亥，为今日死神，故婢死于厕中（《壬占汇选》作：建炎戊申年六月初七，丁巳日未将酉时，童保仪丁巳生，五十二岁占宅）。\n《玉历钤》云：此课发用空亡，幸得中传日德，末传日财，凡占虽有小成，多虚诈不实。\n辰上生日上，日生用。\n课名：重审。旦占太阴不正之象，暮作贵人，口舌疾病之非，入宅不宁。初中空亡，辰往加日，为退课，又不备，凡事皆滞，所喜中德末财，二贵并见。占事宜重谋再进，近贵进望，俱难人头。\n《义》曰：有所见闻，未可遽信。仔细审详，便见斜正。当忧不忧，闻喜不喜。谋望何如？亦斯而已。\n《象》曰：善恶从今且罢休，免教闲事系心头。所图富贵真如意，好事来时不用求。\n又：此重审之卦，一曰龙战，亦曰寡宿。夫重审者，重而审之也。利为主，利后动，长有厄，事从内起，起于女人。以下犯上，贱犯贵，卑犯尊，事多不顺。阴小在下者，有悖逆之事。占臣未忠，子失孝，事不可遂意而行，必当审察，循乎义理，庶几以免后患也。况龙战，主人心疑惑，进寸退尺，动有乖离之象。卯酉为天之私门，生杀有限，分杜有期，雷动龙奔，示其有战。传见寡宿孤辰，值此尤妨骨肉。若占身得此，主见孤独，别离乡井，自立门户，财物虚耗，僧道宜之，俗不宜也。丑亥西，退间传也，占事退而有隔，隔而后进，多系隔越，又为极阴之象。不备，宅盛人衰，君子道消，小人道长，然居无力之乡，亦不堪为用，亦无足畏者。占者遇之此课，发用无力，闻事不实，谋望不遂，干事难成，假使用尽心机，不过弄巧成拙，枉费精神，到底终归无益，若图成而卒不能成。占忧惊之事，却有解散。得此课者，当知进止，不可妄动，惟正以德则利。\n占出兵行师得此：失众无益之象，夜占犹可畏。谨之！谨之！\n待价沽诸。\n真一山人云：寄与痴人莫望为，自然理数不须疑。事逢更变非由己，天道昭昭不教亏。\n《无惑钤》云：丁马俱现，人宅相恋。亥酉全亏，两贵相见。\n《钤解》曰：干上巳丁、中传亥马俱现，动摇不容已也。巳支求就于干，人宅眷恋。亥水酉金，昼夜贵人，并入传内，且夜贵临于昼贵之家，是两贵相见也。酉贵受日克，亥贵落空受克，是全亏矣，干则无力。酉贵却作日财，远动以求贵财乃可。《集议》：“踏脚空亡进用宜”内有此法，谓之三旬空亡，向后全无实义，尽无所就。极阴：“极阴之课丑亥酉，百事逢之悉皆丑。占讼省部方端的，病死定为不长久。”",
