  "keJing": [
    [
      {
        "key": "九、伏吟课 艮卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
      }
    ],
    [
      {
        "key": "伏吟课",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
      },
      {
        "key": "含义",
        "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
      },
      {
        "key": "注意",
        "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
      },
      {
        "key": "科举",
        "value": "必定高中，求名荣归。"
      },
      {
        "key": "疾病",
        "value": "有忧，或起怪异之事。"
      },
      {
        "key": "诉讼",
        "value": "为争夺田产成家宅。"
      },
      {
        "key": "灾祸",
        "value": "春冬较浅，秋夏势危。"
      },
      {
        "key": "行事",
        "value": "律身谨慎，动作无虞。"
      }
    ],
    [
      {
        "key": "自任格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "伏吟课，上下无克。日干为阳干，日上神为用，名自任格。"
      },
      {
        "key": "含义",
        "value": "刚愎自用，崭露头角后即有闭塞之兆。凡事过分，易招过失。等人立至，离家逃亡者可在附近寻获。孕产废婴。若占事，祸患会连续发生。三传中见驿马，主待时而动，或不得已而动，亦主动中有成。访人不遇，家中不安，恐有哭泣和离别事。"
      },
      {
        "key": "注意",
        "value": "日辰发用旺相，再乘吉将，仍以吉论。"
      },
      {
        "key": "占事",
        "value": "做事刚烈暴躁，易成过失。"
      },
      {
        "key": "行人",
        "value": "等人将至，逃亡者就在附近。"
      },
      {
        "key": "占孕",
        "value": "不吉，产废晏。"
      },
      {
        "key": "灾锅",
        "value": "祸患留连。"
      },
      {
        "key": "干谒",
        "value": "不宜出门干谒他人，守株待兔方为吉。"
      }
    ],
    [
      {
        "key": "五十七、励德课 随卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "贵人立于地盘卯酉宫上。"
      },
      {
        "key": "含义",
        "value": "利君子，不利小人。事多反复。"
      }
    ],
    [
      {
        "key": "励德格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "（干支）阳神在贵人前，阴神在贵人后；或（干支）阴神在贵人前，阳神居贵人后。"
      },
      {
        "key": "含义",
        "value": "阳神前引，阴神后随，则君子吉，小人危。若阴神前立，阳神后随，小人得意，君子失机。大体君子主迁动官位，平民主身宅不安，若安分循理，亦能获吉。"
      },
      {
        "key": "蹉跎格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支阴阳神都在贵人之前。"
      },
      {
        "key": "含义",
        "value": "主小人迁官，君子退职，利小人不利君子。"
      },
      {
        "key": "微服格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支的阴阳神均在贵人之后。"
      },
      {
        "key": "含义",
        "value": "主君子迁官，小人退职，利君子不利小人。"
      }
    ],
    [
      {
        "key": "六十、元胎课 家人卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
      },
      {
        "key": "含义",
        "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
      },
      {
        "key": "注意",
        "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
      }
    ],
    [
      {
        "key": "绝胎格",
        "value": "元胎课逢反吟，虽开花但不结子。"
      }
    ],
    [
      {
        "key": "病胎格",
        "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
      }
    ],
    [
      {
        "key": "生胎格",
        "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
      }
    ],
    [
      {
        "key": "蓦越格",
        "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
      }
    ]
  ],
  "bifa": "24.我求彼事干传支\n26.水日逢丁财动之.A.财乘丁马格.②财乘驿马\n32.三传互克众人欺\n38.闭口卦体两般推.Ⅴ.旬尾加旬首\n38.闭口卦体两般推.Ⅶ.财作闭口或食神空亡\n43.害贵讼直作屈断.Ⅰ.害昼贵\n46.贵人差迭事参差.夜贵在干前\n52.罡塞鬼户任谋为.B.神藏煞没格.昼贵\n75.宾主不投刑在上.Ⅲ.三字刑\n76.彼此猜忌害相随.Ⅱ.干支上神作六害\n76.彼此猜忌害相随.Ⅲ.干支天盘、地盘皆作六害\n76.彼此猜忌害相随.Ⅳ.干支三传作六害\n76.彼此猜忌害相随.Ⅴ.干支上下交互作六害\n89.任信丁马须言动.乘马",
  "zhiZhi": "丙寅日第一局干上巳\n课体：伏吟，元胎，自任，临官，励德。\n课义：干传入支，行人远归，禄财生聚，所卜皆宜。\n解曰：初从干上，末归支上，乃我托人干事也。支马在申，传归支上，行人虽远，必至。禄马长生，与财相聚于三传，所求无不遂意。但课体刑冲，善始保终为吉。\n断曰：此自任之卦，又名元胎励德。占事静则宜，动则滞。事主藏匿，屈而不伸，君子守正修德则亨。求官见贵，喜逢禄马，但不脱刑冲，美中未美也。凡占遇励德之课，当思致君泽民之意，自然有泰无否。春夏吉，秋平，冬忌。年命在戌亥者，不利。\n天时：主先晴后雨，见虹电，刮风。\n家宅：人财兴旺，不利六畜。\n婚姻：难成；昼占子多，夜占女性悍。\n胎产：易产，胎防犯聋哑。\n疾病：主脉紧滴，寒热，不进饮食，然末传生干，易愈。\n求财：未称意。\n失物：不出其家。\n捕获：不出邑里，动中得获。\n出行：不果，在路安。\n行人：远行回轮，近行将至，应在亥戌日。\n争讼：和息则吉，不然招刑险。\n征伐：防诈，又不动之象。\n毕法云：我求彼事干传支(有礼下求人之意，旺相吉；凡伏吟，惟六丙日吉，缘初传为德禄，中传为财，末传为长生也，各忌空亡)。风后元经：丙辛日，寅为游都敌主帅，冲为鲁都敌偏帅。若临于日辰之上，敌帅当日即至。\n玉成歌云：伏吟举动心无遂，刚主行人到户庭。",
  "jiYingQian": "丙寅日第一局干上巳\n课体：伏吟、玄胎、励德、自任、闭口。\n我求彼事干传支，彼此猜忌害相随。\n《玉历钤》云：此课旦暮贵人皆不可用，文字迟阻，见贵徒劳，出入辛勤不遂，门户动摇不宁，凡占诸事不顺。\n《毕法》云：此课伏吟，地盘句首上加玄武，谓之闭口卦，止宜捕盗贼、追逃亡，余无用也。又曰伏吟之课，六丙日颇吉，缘初传为德神，中传为财，末传为长生，所以吉也。\n上神德日，辰上生日上。\n课名：伏吟、玄胎。诸神各归本方所在，日德禄用，三刑递制支，驿马在中刑不妨，末传加在支上，事主向后可十全。\n又：此课占人，望信不至，产未生，婚不成，见贵人徒劳无成，文字迟无决，出行罔辛苦，门户动摇不安，一切皆同。日辰人传，又且恃势相刑，气象不合不可用，皆凶。昼暮贵人皆不吉，占财罔遂利名轻。\n《义》曰：禄马长生，求官大利。富贵荣华，无不称遂。课体刑冲，善保始终。如临深渊，如履薄冰。\n《象》曰：春日雍和夏日长，时当春夏自荣昌。立身伟矣存忠孝，拜舞恩光姓字香。\n又：此自任之卦，一曰玄胎，又曰励德。夫自任者，乃伏吟之卦，天地伏吟，十二神各归本身，天地如一，四伏未发之象。占事静则宜，动则滞，主事藏匿不动，静中求劳，有屈而不伸之象。况玄胎如婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不明，触则成祸，惟君子守正修德则亨。凡占得此，皆是彼来求我之象。求官见贵，喜见禄马为吉，但见刑害，乃美中未美，事虽有成，必有动摇侵损。投谒人虽得喜美，尤见未合。婚姻未利。占孕易产。占胎聋哑。远行回轮，近行将至。求财未称。交易不顺。盗者不出其家，逃者不出邑里。二六十月占，不利远行。访人虽有相助之理，但有隐避不欲见人之义。论讼相和则吉，不然则有刑祸之扰。春占凡事解散。占宅，人财兴旺。占逃亡，动中得获。占病不进饮食，或多不语，亦见凶危，作福庶解。\n占出兵行师：防欺诈非毁，传见刑冲，虽有战斗，又有各守不动之象，宜另为选卜，故曰“反吟伏吟，涕泣淋淋”，此之谓也。大抵此课，有德有禄有马，惟利仕宦占之，惜其刑冲，仍未免否泰相淆，能以己之心推之于物，恒思致君泽民之意，又何患乎否也？\n春夏吉，秋平，冬忌。\n真一山人云：无心过恶可消禳，事到凶终也吉昌。若是有心行过恶，前程只恐有余殃。\n《无惑钤》云：干传入支，行人速归。禄财生聚，所卜皆宜。\n《钤解》曰：初从干上，末归支上，乃我托人干事。若占行人，虽远必至也。禄马财生并众，可以坐得，凡卜宜矣。《集议》：伏吟惟六丙日吉，初德禄，中财马，末得长生，各忌空亡。此三刑在传，未免无恩之意，凡占恩反怨也。上下俱作六害，此等戾害尤甚。",
