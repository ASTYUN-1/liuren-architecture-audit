  "keJing": [
    [
      {
        "key": "涉害课 坎卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课之中同时出现多组上克下或下克上神，且同为阴神或阳神时，则以上神顺行回归地盘本宫，沿途被克的次数做比较。以涉害深（被克次数多）者作为初传。"
      },
      {
        "key": "含义",
        "value": "风波险恶，度涉艰难。舍轻就重，趋安避危之象，事宜见机而作。谋为利名，多费机关；婚姻有阻，疾病难安；胎孕迟滞，行人未还。失物还在家内，逃亡不远隐亲友家。"
      },
      {
        "key": "注意",
        "value": "神将凶，三四克，灾深难解；我克他，日辰旺，神将吉，受克浅，则忧浅易解。"
      },
      {
        "key": "占事",
        "value": "风波险恶，渡沙艰难。"
      },
      {
        "key": "谋事",
        "value": "先难而后可名成利遂，诸事多费苦心而后成，灾难消解较迟。"
      },
      {
        "key": "婚姻",
        "value": "婚姻有阻。"
      },
      {
        "key": "疾病",
        "value": "疾病难安。"
      },
      {
        "key": "逃亡",
        "value": "隐匿于朋友之家。"
      },
      {
        "key": "占孕",
        "value": "伤胎，胎孕迟滞。"
      },
      {
        "key": "占行",
        "value": "待人不来。"
      },
      {
        "key": "失物",
        "value": "物在家内。"
      }
    ],
    [
      {
        "key": "十四、六仪课 兑卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "旬仪发用或者入传。"
      },
      {
        "key": "含义",
        "value": "动无阻隔，家集千祥。兆多吉庆，求财相宜。有罪可逢赦减，有病能遇良医。如果旬仪、支仪皆入传，且乘天乙吉将，为富贵六仪，再加奇仪同会，妙不可言，吉庆无比。"
      },
      {
        "key": "注意",
        "value": "如果仪神发用克行年，则凶。"
      },
      {
        "key": "占事",
        "value": "多为吉庆之兆，宜求财。"
      },
      {
        "key": "刑囚",
        "value": "有罪者可逢赦宥。此特"
      },
      {
        "key": "疾病",
        "value": "有病者可遇良医。"
      },
      {
        "key": "干谒",
        "value": "投书见喜，干贵逢时。"
      }
    ],
    [
      {
        "key": "五十七、励德课 随卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "贵人立于地盘卯酉宫上。"
      },
      {
        "key": "含义",
        "value": "利君子，不利小人。事多反复。"
      }
    ],
    [
      {
        "key": "励德格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "（干支）阳神在贵人前，阴神在贵人后；或（干支）阴神在贵人前，阳神居贵人后。"
      },
      {
        "key": "含义",
        "value": "阳神前引，阴神后随，则君子吉，小人危。若阴神前立，阳神后随，小人得意，君子失机。大体君子主迁动官位，平民主身宅不安，若安分循理，亦能获吉。"
      },
      {
        "key": "蹉跎格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支阴阳神都在贵人之前。"
      },
      {
        "key": "含义",
        "value": "主小人迁官，君子退职，利小人不利君子。"
      },
      {
        "key": "微服格",
        "value": ""
      },
      {
        "key": "特征",
        "value": "干支的阴阳神均在贵人之后。"
      },
      {
        "key": "含义",
        "value": "主君子迁官，小人退职，利君子不利小人。"
      }
    ],
    [
      {
        "key": "润下格（润下课）",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传申子辰，合为水局。或者亥子丑北方水气，也属此格。"
      },
      {
        "key": "含义",
        "value": "占主悠悠长久，事不急迫，亦主迟留屈伏。然终不能静也，浮游不安。惟智者乐水，兼有润泽之象，宜施惠于人。秋冬占吉。孕生女，占天雨，病凶，以天罡作墓故也，宜祷水神。占宅虽不凶，亦不振。占文书不利，为克雀也。寻常水将水神多者，亦欠吉。三传水性喜顺，逆则主事逆迟。乘后合，有奸情。元武并，定主盗。性就下，吉凶多下贱人当之，占讼亦牵连下人。大约君子凶小人吉。"
      }
    ]
  ],
  "bifa": "02.首尾相见始终宜.B.回环格\n05.六阳数足须公用.A.六阳格\n15.脱上逢脱防虚诈.Ⅱ.夜贵\n26.水日逢丁财动之.A.财乘丁马格.④财乘日本.昼常\n30.屋宅宽广致人衰.C.血厌克宅格.昼后\n31.三传递生人举荐\n38.闭口卦体两般推.Ⅱ.玄武乘旬首\n43.害贵讼直作屈断.Ⅰ.害夜贵\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干后\n49.两贵受克难干贵.B.贵人忌惮格.昼\n62.支乘墓虎有伏尸.A.虎鬼克支格.夜\n64.夫妇芜淫各有私.A.真解离卦\n69.虎乘遁鬼殃非浅.昼虎",
  "zhiZhi": "庚戌日第九局干上子\n课体：涉害，润下，励德，六仪。\n课义：被子息坏，性多懒懈，动坐生方，索还魂债。\n解曰：庚金被水局脱气，且生起寅木克戌，是身与家皆被子息所坏，以致气虚力疲，作事懒懈。然庚动而加辰，坐于生方，三传虽盗干，却生寅木作财。如人先曾有施于人，今却不意而得，是谓索取还魂债也。\n断曰：六仪之课，本为吉征，又系三合，事有成局。贵人立二八为励德，利君子而不利小人。传课纯乎六阳，利公事而不利私事。庚金上生子水，子水复上生青龙，脱上逢脱，虚诈宜防。干上乘蛇，惊疑不免。\n天时：润下，主雨。\n家宅：人多怯弱，宅主虚耗。\n功名：仪神发用，中传日德禄马交驰，甚吉；但三传克官，不可妄动。\n求财：宜索旧债。\n婚姻：佳偶可谐，但恐难成。\n胎产：胎坐长生，占孕大宜，占产不利。\n疾病：病属虚症，或脾家受风，初起即愈，久难痊。\n谋望：事主迟滞忧患之事，难释。\n争讼：三合，当讲和。\n出行：六仪课又马带德禄，利有攸往。\n行人：在途将归。\n捕获：贼在西方道路旁，或金铁之场。\n兵战：不利。\n毕法云：六阳数足须公用，脱上逢脱防虚诈。\n课经云：庚戌日辰加子发用，曰察微格。占者恐人不仁，或小人有谋害之意，思患预防，庶几无虑。\n指掌赋云：辰申子为呈斗，玩阴阳于天象。",
  "jiYingQian": "庚戌日第九局干上子\n课体：涉害、润下、六仪、励德。\n脱上逢脱防虚诈，夫妇芜淫各有私。\n《玉历钤》云：此课润下水局，发用辰加子，上见玄武，常占必主失脱财物，不明之象，所求不得，所期不遂。\n《毕法》云：此课干上乘青龙，脱上生脱，又更三传皆生，并来脱盗日干庚金，凡占虚耗迭出，脱盗无穷。盖世事多更变，乃天理如此，人见目前荣盛，以为无虑，不旋踵而衰败至矣，其造物者使之然欤？\n上神盗日，日上生辰上，日生三传，初克末。\n课名：涉害、润下、励德、芜淫。子母相生，秋冬得时旺相，春夏占上下隔断，为事悠缓，牵连无灾，有口舌，末却终在日上，为事终成。\n《义》曰：相逢脱盗，至生暗耗。自叹不足，无所为靠。虽然有喜，事不能已。病虚官改，散财流水。\n《象》曰：不能鸡口徒牛后，知此机微贵自量。阅尽眼前难着力，看他更变机千场。\n又：此见机之卦，一曰润下。夫见机者，察其微，见其机，谓两比两不比，当以涉害为用。涉害有浅深，欲用不用，欲言不言，事有两而取一，所作稽留，迟疑艰难，进退不定，忧患难消，怀孕伤胎，难于前而易于后。且润下，事主沟渠、水利、舟楫、渔网之类，动而不息之象，流而必清，滞则不竭，宜动不宜静，事主关众，亲朋相识之务，克应多是过月，牵连疑二，利占成合，不利占解散。此乃五行正气入十干杂糅之乡，异方三合乃生旺墓之神，事主丛杂不一，主关众人共谋，不然两三处干事，委曲托人与人相合之类。又如推磨，转去转来，非一遍也。日生上神，泄气虚耗不足，谋干难成，盗失损财，人口衰残，休囚尤重，又为子孙脱漏之事。当旺相犹可，休囚尤重，防人作伙来脱赚，以致其虚耗，不遂心志也。占者遇之此课，凡百占谋，动望难也。占求官不遂。占见贵，和而未济。占婚姻，合而不宜。占求财得，不如意。占病虚损难痊。失物得而复失。逃者欲回。忧疑欲脱而不脱，惊恐将散而未散。此课无益有损。\n占出兵行师：大防失脱奸诈、粮储不足、人心懈惰，宜加密察而详审，甚勿忽之！泄气之象。\n真一山人云：对面人情恐未真，人心未与道心纯。这回认得真消息，敌若来时不可亲。《无惑钤》云：彼此皆坏，性又懒懈。动坐生方，索还魂债。\n《钤解》曰：水乃庚金之子息也，三传水局，昼夜天将皆水中之兽，脱盗滋甚，是为子息所坏矣。夜占又为脱上逢脱，庚金力惫气疲，其性慵懒，凡事不能前为也。幸动而坐于辰土生方，结成水局，生起支上寅木为财，始则为子息所坏，终则赖子息生财，非还魂债而何？《集议》：此“脱上逢脱防虚诈”内有此日，说甚详。“传鬼化财钱险危”内有此法，谓三传初脱干气，却生起支上寅财，亦谓之索还魂债。寅乃支鬼，夜占乘虎。交车克，乃蜜里砒，喻笑里藏刀之意，匿怨而友其人，如相交涉，必至争讼。解离，夫妇行年值此尤的。",
