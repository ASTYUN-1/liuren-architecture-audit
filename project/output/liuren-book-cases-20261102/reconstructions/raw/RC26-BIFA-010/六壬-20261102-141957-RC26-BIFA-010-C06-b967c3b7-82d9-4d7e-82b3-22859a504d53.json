  "keJing": [
    [
      {
        "key": "重审课 坤卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
      },
      {
        "key": "含义",
        "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
      },
      {
        "key": "注意",
        "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
      },
      {
        "key": "占事",
        "value": "宜后起，祸由内生。"
      },
      {
        "key": "兵事",
        "value": "用兵主胜。"
      },
      {
        "key": "占孕",
        "value": "主生女。"
      },
      {
        "key": "谋望",
        "value": "主先难后成。"
      },
      {
        "key": "诉讼",
        "value": "后者胜，对被告有利。"
      },
      {
        "key": "初传为墓绝，末传为生旺",
        "value": "灾祸消解，事终有成。"
      },
      {
        "key": "初传为生旺，末传为墓绝",
        "value": "先易后难，先得后失。"
      },
      {
        "key": "初传克末传",
        "value": "有凶兆"
      },
      {
        "key": "末传克初传",
        "value": "为吉兆，"
      },
      {
        "key": "末传天将为龙、常、阴。后、",
        "value": ""
      },
      {
        "key": "六合等吉将，或为德、喜等吉神",
        "value": "逢凶化吉。"
      }
    ],
    [
      {
        "key": "十八、龙德课 萃卦",
        "value": ""
      },
      {
        "key": "特征",
        "value": "太岁和月将相同；太岁（月将）乘贵人发用；"
      },
      {
        "key": "含义",
        "value": "君恩及下，万民欢欣。罪囚出狱，财喜临身。名利易遂，争讼休陈。官职拔擢，利见大人。总之利卑下求贵，吉庆重重。"
      },
      {
        "key": "注意",
        "value": "不利尊贵求卑下，再带凶煞、日鬼，决非吉庆。"
      },
      {
        "key": "占事",
        "value": "进财，并有喜事，富贵两全。"
      },
      {
        "key": "占孕",
        "value": "生得贵子。"
      },
      {
        "key": "婚姻",
        "value": "男子娶亲配美丽女子。"
      },
      {
        "key": "诉讼",
        "value": "可占理而先。"
      },
      {
        "key": "谋望",
        "value": "心中谋划之事可遂，谋望更胜于前。"
      }
    ],
    [
      {
        "key": "从革格（从革课）",
        "value": ""
      },
      {
        "key": "特征",
        "value": "三传巳酉丑，合为金局。或者申酉戌属西方一气，也是此格。"
      },
      {
        "key": "含义",
        "value": "秋占吉，利求财、寻远行人。占主变动革故鼎新。事先阻后就。若遇旺相气，吉将并，主革变富贵。遇岁月破及蛇虎，主死丧兵革。日干囚死，有西行之兆。巳酉丑为顺，有气则革而进，无气则革而退。酉巳丑主萌芽，欲就而又被隔。巳丑酉变而不顺，又主革。酉加巳为愁课，盖酉为秋令肃杀，万物愁苦。巳加酉，仕人差遣，改易；常人道路门户，改革不宁，或有阴人离别之象，占婚大忌，仍以衰旺神将言之。大都从革与金鬼并，遇秋作游都，定主金革血光逃亡。寻人遇从革藏山石道途之处，远行隐避最宜。病在肺、在筋骨。求财获珍宝，讼有罪，三传见劫杀故也。此课虽宜改动更新，然值酉加巳、巳加酉，方孚改革之应。若火多金少，火旺金囚，或将得武后盗金气，即名从革不革，来意主事欲动未能。将得六合，亦主欲动不动。丙丁日虽为财，若丑发用，将见贵常勾，乃为降气，却主父母灾，被恃势力之人强抑而不得伸也。"
      }
    ]
  ],
  "bifa": "02.首尾相见始终宜.B.回环格\n26.水日逢丁财动之.A.财乘丁马格.②财乘驿马\n27.传财化鬼财休觅.C.财遁鬼格\n28.传鬼化财钱险危.C.空财格\n31.三传递生人举荐.A.将生财神格\n32.三传互克众人欺.B.土将助财格\n38.闭口卦体两般推.Ⅶ.财作闭口或食神空亡\n46.贵人差迭事参差.夜贵在干前\n49.两贵受克难干贵\n75.宾主不投刑在上.Ⅰ.一字刑.干支全自刑",
  "zhiZhi": "丙寅日第九局干上酉\n课体：重审，从革，地网，龙德。\n课义：守死赔钱，夜将助焉，所得一贯，家费万千。\n解曰：酉虽为丙之财，而丙火死于酉，况夜将皆土，脱干之气，为耗无穷。三传虽会成财局，难供宅上午火之费，是所人者一贯，而所出者万千也。\n断曰：此卦合中有破，笑中有刃先天后革，变金成铁。事防再举，病防再发。大忌命上乘水，乃为自招其殃。求官见贵，多不喜悦。凡百谋为，成而有变。惟文明之象，足以应之。可得去旧生新，以合从革之义。\n天时：多晴少雨。\n家宅：人口不宁，兄弟不和。\n婚姻：合中有破。\n胎产：午加寅，主正妻有孕。\n科名：文字改变从新，可得高捷。\n求财：得少去多，且有口舌。\n疾病：隔塞中风，或禁口痢，或伤筋骨，皆有凶象。\n失脱：有见贼人，却不肯说。\n出行：不利西南，防破财。\n行人：书信浮沉，盘费不继。\n争讼：不得伸理，须防人暗害。\n兵战：宜偃旗息鼓，屯积粮草。\n毕法云：两贵受克难干贵，传财太旺反财亏；宾主不投刑在上，合中犯煞蜜中砒。\n袖中金云：旬尾加旬首为闭口，凡占多主秘密，不能测其机关，告贵不允，枉狱不伸。\n观月经云：一下贼其上，顺行忧浅，逆行忧深。入墓有害，传生可避。",
  "jiYingQian": "丙寅日第九局干上酉\n课体：重审、从革、闭口、金局。\n合中犯煞蜜中砒，两贵受克难干贵。\n《玉历钤》云：初传日之财，又丙与辛合，日上见财合，求望称遂。\n《毕法》曰：此课干上酉，支上午，各乘死气。占者止宜休息存省，不利动谋。占\n病大凶。又旬尾加干发用，为闭口之卦，止宜捕盗贼而追逃亡，余无所用。又干上重逢自刑，非吉课也。\n日克上神，辰上克日上，日克用，末克初。\n课名：重审、从革。始德终德禄，日克三传为财，尽与日合，此乃吉课。凡事利更革，秋占尤获。只是支上见午，家宅不安，寅生人不利。巳加丑为喜，不利占长上。末克初可成。\n又：此课出入更改如意，止不利占家宅，并阴人、奴婢，且喜有太阴、天空，主奴婢为恼为疑。行人有归，产并逃盗、婚姻不利也。火日金局是财多，兼辰上神克日上神，极费力。\n初传日财丙辛合，酉为辛禄福繁昌。占贵利宜文字吉，行人有信渐还乡。不利宅婚产盗贼，旦治阴人奴仆阳。更改出入应如意，求财初阻再求良。\n《义》曰：合中有破，笑中有刀。财多不任，枉力徒劳。先从后隔，金变成铁。欲得安吉，应多积德。\n《象》曰：欲面当从麦里求，磨推来往几周流。知音对语无人会，好把工夫向德修。\n又：此重审之卦，又为从革。夫从革者，先从而后革也。为兵刃，为金铁，为肃杀之气，乃三合金局也。此五行正气入十干杂糅之乡，异方三合乃生旺墓之神，事主丛杂不一，主关众人共谋，不然两三处干事，委曲托人与人相合之类。又如推磨之象，转去转来非一遍也。凡百阻隔，有气则隔而增进，无气则隔而退失。况重审，有卑犯尊，贱役贵之象。阴小在下者，有悖逆之事。占臣未忠，占子失孝，事不可遂意而行，必当审察，循乎义理，庶免后祸也。传见破碎，三传财局，有得失相半之义。其财俯就他人，不得自由，又可笑也。事防再举，病防再发，有伤筋骨肺痨心之谓，主气逆或呕吐恶心。大忌年命上乘水神，乃为自招其祸也。此课求官见贵多不喜悦，婚姻合而见破。凡百占谋，皆于成合之中被人隔破，或先见允而后改变。\n占出兵行师：昼占虑多言词，恐军戎之见耻，夜占有开地千里之美，最忌暗中不足，亦见兵之交接也。得此课者，法主口舌、音信、财帛、文字之象，未免革故而鼎新也。\n春夏吉，秋冬不宜。\n真一山人云：人情险易未前知，大忌防他蜜里砒。要紧一言千两重，神仙今日露天机。\n《无惑钤》云：守死陪钱，夜将助焉。所得一贯，实费数千。\n《钤解》曰：酉虽丙财，丙火死于酉，况夜将皆土脱干，三传虽日财，难供宅上火午之费，是所得一贯而家费万千也。若推所费之内，必同类兄弟。《集议》：四胜煞各逞其能，邀功逞俊之意。又干上重逢之自刑之酉也，人宅皆死，宜休息万事，不利动谋。此人多贪横发，财入墓，旬尾发用为闭口，此闭口财也。“三传递生人荐举”内有此例，谓三传土天将又生其财神，大宜取财。“三传互克”内亦有此例，大宜取财，尤宜成合万事，却不利父母，必营作，占病死，兼此人不义，多贪横发。两贵受克难干贵。",
