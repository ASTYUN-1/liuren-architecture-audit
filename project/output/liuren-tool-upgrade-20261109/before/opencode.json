{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "references": {
    "liuren-cases": {
      "path": "案例项目库",
      "description": "本机六壬案例库；按子问短词检索并实际阅读原档，保留来源、条件、相似与差异。同卦追问续用有效资料，prepare/read/check仅可选审计，不是回答门禁。"
    },
    "liuren-index": {
      "path": "案例项目库/_metadata_index.md",
      "description": "旧案例索引，只作兼容定位；日常使用search-cases.py定位原档，说明实际查询与未读范围。"
    },
    "jingyan-log": {
      "path": "经验日志",
      "description": "六壬经验与来源方法；仅为条件候选，先核对原文、反例和来源身份，来源称验不等于本案验证。"
    },
    "liuren-guji": {
      "path": "书籍库",
      "description": "六壬古籍原文与速查资料库（只读）：古籍蒸馏、断法查阅时使用"
    },
    "liuren-sucha": {
      "path": "书籍库/解课速查",
      "description": "六壬速查表（课体、干支关系、天将、神煞、占类等）：断课快速查表"
    },
    "paipan-archive": {
      "path": "排盘存档",
      "description": "六壬程序排盘归档；同卦复用可靠程序盘，需要新盘时用本机直接排盘。facts与解释断语分别核对，不为追问强制prepare。"
    },
    "liuren-research": {
      "path": "knowledge/liuren-research/20261102",
      "description": "带来源与条件的审读规则。默认过滤暂停项；来源方法与可迁移规则区分，统一会话检查不证明术理正确。"
    }
  },
  "instructions": [
    "docs/本机OpenCode完整输出规则.md",
    "docs/本机六壬高效执行.md",
    "docs/本机六壬资料检索范围.md"
  ],
  "permission": {
    "skill": {
      "wenheng-public-output": "deny"
    }
  },
  "default_agent": "liuren",
  "agent": {
    "liuren": {
      "mode": "primary",
      "description": "本机大六壬精简主线；可信程序盘，按问取用，独立裁决与完整交付。",
      "prompt": "本机大六壬占事：加载当前daliuren，先读judgment-core及本问domain，详细方法和原书按具体缺口查。可信程序盘→按问取用及有效作用→核心交接→独立裁决→核对交付。准备阶段读adjudication，facts不复述整盘，observations只放必要观察，不先完成裁决；原书交精确handoff备查。裁决者读完整核心，参考按material_id/module查证，不把来源索引当必读清单。返回只核事实/引用/问项覆盖/一致性，读report后忠实交付。普通研判不调用案例/经验库或旧缓存；正常年命/行年保留，时间数量按实际tasks。参数不明查tool_help，按next_call；开发排障切Build。\n采用活动judgment-core的U01—U11。准备时将已确认口径与真实未知分开，已定规则不重新作两派争点，focus_issues只留本问真实未知条件或同条件仍互斥的矛盾，不机械列历史C编号；子智能体按同版规则独立裁。返回核事实、引用、覆盖及U口径一致性；具体违规定位原文、U编号及绑定证据，依一次补核协议处理，不自行折中或以不同意结果重派。\n矛盾登记执行33版U11：只有同一对象、同一位置关系、同一时段气态、同一占类及判断目标下，完整上下文仍给出互不相容的结论，才登记真正矛盾；须附双方原句、条件和直接跳转。对象、层次、阶段或条件不同而原书已有明确解释的，模型自行理解并执行，不留作用户确认。资料覆盖不足、OCR校勘、程序取法差异分别登记，不冒充理论矛盾。 贪生停用按类神对我的作用解释（财难得、父母难生、鬼难害）；通类/分类分层；胎爻依北海（干支胎同重、土胎子午两处），应期视用/末依原文明示阶段。历史C01—C11不是待确认清单，不能机械填入focus_issues。\n34版单宫旺衰：默认分数仅为单宫直接关系的旺衰，5/2.5均非失用阈值，弱仍可作用。明确取用和跨宫作用依据后，必须调用liuren_compute(action=strength)补算，不自行加减、不重复扣空、不全盘五行联算。先读共用judgment-core，接口见deterministic-tools；三合/半合/三会数值继续暂缓。",
      "permission": {
