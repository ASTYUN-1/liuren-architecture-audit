    "keJing": [
      [
        {
          "key": "元首课 乾卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "一上克下，余课无克，为元首课。"
        },
        {
          "key": "含义",
          "value": "尊制卑，贵制贱。占事多顺，忧喜皆实。事从外来，事起男子，宜主动。"
        },
        {
          "key": "注意",
          "value": "遇凶神恶将，上恶而下受欺；或上休囚而下得势，则下强而上受欺。"
        },
        {
          "key": "君王占得",
          "value": "有伊尹之臣"
        },
        {
          "key": "大臣占得",
          "value": "遇唐虞之右"
        },
        {
          "key": "常人占得",
          "value": "万事顺利"
        }
      ],
      [
        {
          "key": "三十三、乱首课 师卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "干加支，被支克，名自取乱首；支加干上克干，叫上门乱首，其祸尤重。"
        },
        {
          "key": "含义",
          "value": "子忤其父，弟背其兄。君骄臣逆，尊卑不分。以下犯上，悖逆重重。"
        },
        {
          "key": "注意",
          "value": "初传若逢官鬼，凶祸尤速；三传吉神吉将，年命处有克制凶神、生我之神名患门有解。"
        }
      ],
      [
        {
          "key": "六十、元胎课 家人卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
        },
        {
          "key": "含义",
          "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
        },
        {
          "key": "注意",
          "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
        }
      ],
      [
        {
          "key": "绝胎格",
          "value": "元胎课逢反吟，虽开花但不结子。"
        }
      ],
      [
        {
          "key": "病胎格",
          "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
        }
      ],
      [
        {
          "key": "生胎格",
          "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
        }
      ],
      [
        {
          "key": "蓦越格",
          "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
        }
      ]
    ],
    "bifa": "02.首尾相见始终宜.B.回环格\n22.上下皆合两心齐.C.独支干上神作六合格\n22.上下皆合两心齐.E.外好里槎丫格\n37.末助初兮三等论.C.谒求祸出格\n37.末助初兮三等论.D.自招其祸格\n38.闭口卦体两般推.Ⅱ.玄武乘旬首\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n47.贵虽在狱宜临干\n69.虎乘遁鬼殃非浅.A.明暗二鬼格.干明支暗\n76.彼此猜忌害相随.Ⅳ.干支三传作六害\n76.彼此猜忌害相随.A.人喜我忧格.干上六害，支上六合",
    "zhiZhi": "戊寅日第四局干上寅\n课体：元首，元胎，不备，乱首。\n课义：两位空申，岂胜四寅，守动皆祸，昼夜贵嗔。\n解曰：支临干而克干，乃是上门乱首，所恃者申金为救耳。然寅聚四鬼为朋，虽有两申却值旬空，以两位之空神，岂能胜四寅之实鬼耶。守之固坐受其殃，动则又逢初传之克，皆不免于祸患也。昼夜贵人临于罡魁，谓之入狱，干之必生嗔怒。\n断曰：此元首之卦。四孟出传，格合元胎，合中有破，日遭辰克，有俯就他人之象。\n天时：先风后雨，冬占有雪霰。\n家宅：宅旺人弱。\n婚姻：夜占町用，主赘婿他家。\n胎产：平安，昼占生男。\n功名：申年月占者有成。\n求财：有得，不能安享。\n投谒：始虽交欢，终必吴越。\n疾病：主惊恐老人、小儿甚凶。\n失脱：难得，逃亡不返。\n出行：不果，出亦不利。\n行人：未动身，申年月占在道。\n争讼：中有人两地指唆。\n兵战：昼占不利，夜占吉。\n毕法云：合中犯煞蜜中砒。吴越春秋：吴王孟赦越王，越王喜，范蠡占曰：戊，囚日也，功曹为螣蛇临戊，青龙在胜光临酉，死气也。时克其日，用又助之，天网四张，万物尽伤，王何喜焉。子胥果谏，复囚石室。\n精蕴：寅加巳，占婚曰：四课虽是互合，却不喜末传之申作天后来克日上之寅。寅鬼，夫也。青龙亦为夫，受后之克，夫妻不睦之象，且阳不备，必然克夫。",
    "jiYingQian": "戊寅日第四局干上寅\n课体：元首、乱首、玄胎、不备、闭口。\n《玉历钤》云：此课初传寅加日，中末皆被日辰冲破，主气象乖戾，人情不和，见贵、求财、求婚、出入、动望，皆无所成。\n《毕法》云：此课面是心非，俗谓之“外好内恶”，盖以干支上神虽作六合，地盘干支却是六害，凡占吉中有凶，老子云“福兮祸所伏”，此之谓也。\n上神克日，辰上生日上，末克初。\n课名：元首。辰就日克日，作用带刑，申金又空亡不能制，凡事只宜守静，若动则悔吝生焉。空亡在末，吉凶从空而散。\n《义》曰：彼此喜合，既合且破。赖有终传，以解其祸。自不得已，俯就他人。欲就未就，久屈还伸。\n《象》曰：金风初动雁初来，好把胸襟大敞开。惟有此时谋干好，春夏犹未得和谐。\n又：此元首之卦，一曰玄胎，亦曰天网、乱首。夫元首者，尊制卑，贵役贱，凡事多顺，利于先举，事多起于男子。为臣忠，为子孝，正大光明而无邪僻之行，德业已著而乾乾进修，常怀危惧，惕励而无咎也。况玄胎如婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不通，触则成祸，惟君子守正修德则亨。一曰玄胎，不宜老人小儿病，为再投胎也。且天网，为阻滞，为灾恼。又见于刑，夫刑者，伤残也。发用逢之，祸无不至。又曰：刑必动摇。凡上门乱首更凶，臣反君，子害父，妻背夫，弟侮兄，奴欺主，下人病或奴婢生事，累其主人，空亡稍解。况上神克日，又恐外勾里连，被人欺负，幸传终解也。占者遇之此课，求官腾蛇生角，将以成就变化，惟惜终传无力，若七月节或申年占，庶几有成，夜占犹吉。见贵、婚姻、投谒、交易、托干、求财，始如秦晋交欢，终似吴越反目。占病大有惊恐，小儿甚凶。失脱难得。逃者自归，盗者可获，目下皆未如意。\n若出兵行师得此，昼占忧心众畏，防备侵袭暗攻，乃为凶象也，夜占大胜，或见相和好之理。大抵此课，皆有始而无终，能散忧释虑，谋事未许有准，成亦见更改而未久远也。\n有花无果。\n真一山人云：对面相逢不识心，看来那个是知音。使机还被机关失，何必劳劳刻意深。\n《无惑钤》云：两位空申，岂胜五寅？守动皆祸，昼夜贵嗔。\n《钤解》曰：支临干克干，乃上门乱首。况寅聚五鬼为朋，所恃两位申金为救，系是旬空，不能胜五寅之实鬼也。守之坐受其殃，动则又逢初传之克，守动皆不能免祸也。昼夜贵人入狱，干之必生嗔怒也。支上生干上神作日鬼，申克寅救戊，又生亥助鬼，作两面刀（占官，寅喜其旺，夜占青常聚会，惜末传减力。申，长生也，空则不生，奈何？）。",
