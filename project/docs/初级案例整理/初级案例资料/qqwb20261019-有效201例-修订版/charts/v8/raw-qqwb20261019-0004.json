    "keJing": [
      [
        {
          "key": "重审课 坤卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
        },
        {
          "key": "含义",
          "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
        },
        {
          "key": "注意",
          "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
        },
        {
          "key": "占事",
          "value": "宜后起，祸由内生。"
        },
        {
          "key": "兵事",
          "value": "用兵主胜。"
        },
        {
          "key": "占孕",
          "value": "主生女。"
        },
        {
          "key": "谋望",
          "value": "主先难后成。"
        },
        {
          "key": "诉讼",
          "value": "后者胜，对被告有利。"
        },
        {
          "key": "初传为墓绝，末传为生旺",
          "value": "灾祸消解，事终有成。"
        },
        {
          "key": "初传为生旺，末传为墓绝",
          "value": "先易后难，先得后失。"
        },
        {
          "key": "初传克末传",
          "value": "有凶兆"
        },
        {
          "key": "末传克初传",
          "value": "为吉兆，"
        },
        {
          "key": "末传天将为龙、常、阴。后、",
          "value": ""
        },
        {
          "key": "六合等吉将，或为德、喜等吉神",
          "value": "逢凶化吉。"
        }
      ],
      [
        {
          "key": "二十九、斩关课 井卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "魁罡加日辰发用，乃豹隐南山之课。"
        },
        {
          "key": "含义",
          "value": "关梁逾越，最利逃亡，捕贼难获，出行无殃。病讼凶祸，厌祷吉祥。最利隐遁逃亡。"
        },
        {
          "key": "注意",
          "value": "贵人临亥，为贵登天门。甲戊庚日贵登天门，为神藏煞没。凡占事遇之，主万事顺利，不独斩关课如此。河魁加亥，名魁度天门，主抑塞难通；天罡加寅，名罡塞鬼户，主谋为顺利；"
        },
        {
          "key": "另注",
          "value": "魁罡临日辰，传有虎阴申酉为斩关得逃者，永远不获。若带血支、血忌、呻吟、羊刃、三杀，必伤人而走。"
        },
        {
          "key": "占行",
          "value": "利于出行，逃遁，但捉贼难获。"
        },
        {
          "key": "占病",
          "value": "遇之大凶。"
        },
        {
          "key": "占讼",
          "value": "遇之大凶。"
        },
        {
          "key": "其他",
          "value": "宜于书符、合药，厌祷。"
        },
        {
          "key": "天地独通",
          "value": "逃亡出行，如有神助。"
        }
      ],
      [
        {
          "key": "润下格（润下课）",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传申子辰，合为水局。或者亥子丑北方水气，也属此格。"
        },
        {
          "key": "含义",
          "value": "占主悠悠长久，事不急迫，亦主迟留屈伏。然终不能静也，浮游不安。惟智者乐水，兼有润泽之象，宜施惠于人。秋冬占吉。孕生女，占天雨，病凶，以天罡作墓故也，宜祷水神。占宅虽不凶，亦不振。占文书不利，为克雀也。寻常水将水神多者，亦欠吉。三传水性喜顺，逆则主事逆迟。乘后合，有奸情。元武并，定主盗。性就下，吉凶多下贱人当之，占讼亦牵连下人。大约君子凶小人吉。"
        }
      ]
    ],
    "bifa": "02.首尾相见始终宜.B.回环格\n05.六阳数足须公用.A.六阳格\n26.水日逢丁财动之.A.财乘丁马格.②财乘驿马\n26.水日逢丁财动之.A.财乘丁马格.④财乘日本.昼常\n43.害贵讼直作屈断.Ⅰ.害夜贵\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干后\n49.两贵受克难干贵.B.贵人忌惮格.昼\n52.罡塞鬼户任谋为.B.神藏煞没格.夜贵\n75.宾主不投刑在上.Ⅰ.一字刑.干支全自刑\n77.互生俱生凡事益.A.互生格\n77.互生俱生凡事益.B.俱生格\n86.将逢内战所谋危.昼",
    "zhiZhi": "庚申日第五局干上辰\n课体：重审，润下，斩关。\n课义：盗气传逢，初中幸空，独有辰土，生气无穷。\n解曰：申子辰会成水局，以盗干气。初传子水逢空，中传申金落陷，是水局已破。独存辰土，坐于长生之上而生干，则生生不已，宁有穷尽耶。\n断曰：润下之课，有动而不息之形；孤神发用，有茕茕孑处之象。占者家有虚耗，子不成业，凡事皆有损无益。辰土属于父母，昼夜乘元，失脱不免。总宜静守，生意盎然。若或妄动，即名泉源涸竭，虚费百出矣。\n天时：龙神昼夜皆空，出旬方雨。\n家宅：干支各自受生，人宅两旺。\n功名：龙禄皆空，官星不现，占名不吉。\n求财：宜守家财。\n婚姻：支干自刑，占婚不吉。\n胎产：坎局生男，占胎有损。\n疾病：脾土之疾，医不得力。\n遗失：元武生干支，且传得回环，虽失必得，北方寻之。\n出行：近家处防盗失。\n行人：未能动身。\n兵战：虚惊虚喜。\n坟葬：水法甚合，但来龙系假脉，亦有空陷。\n毕法云：互生俱生凡事益。\n壬髓经云：干上神生干，支上神生支，主各有生意，彼此和顺，或两家合本营生尤应。\n纂要云：甲戊庚三日，丑未临亥，为贵登天门，神藏煞没，凡谋亨利，无阻无碍。\n照胆秘诀云：用空传复支与干，旧久重新废孟完。\n指掌赋云：子申辰为仰元，守凝寒之困。",
    "jiYingQian": "庚申日第五局干上辰\n课体：重审、润下、斩关、八专、芜淫、孤辰。\n《玉历钤》云：此课三传盗气，发用空亡，凡占所事，皆不可用。上神生日，日上克用，日生用，末克初。\n课名：重审、润下。三传全水，庚日为子孙爻。初传子为空用，凶吉无成，兼又木将，脱之又脱，却可无凶。末传归日辰上，出旬别图，尚可有望。\n《义》曰：脱空叠逢，捕影捉风。忽有忽无，载西载东。虽难称遂，遇凶不凶。功名欲阴，须待运通。\n《象》曰：人生百岁等浮云，聚散由来不可闻。万事由来浑不解，东西南北总纷纷。\n又：此知一之卦（此非知一之卦），一曰润下，亦曰孤辰。夫知一者，知一而不能知两，知者以为自知、自见，不知为寇仇，故言知一也。以此为用，舍远就近，舍疏就亲，恩中生害。\n事多起于同类，凡事狐疑，事贵和同乃吉。且润下，主沟渠、水利、舟楫、渔网之类，动而不息之象，流而必清，滞则不竭，宜动不宜静，主关众亲朋相识之务，应期多过月，不然两三处与人相合相议之事。孤辰有茕茕孑立之象，占人别离桑梓，凡所占谋，多虚少实，功名难遂，事业虚花，僧道宜之，俗不宜也。上神生日，所谋百事吉，运用如意，遇灾不凶，逢吉愈吉。若当季神生日者，主声名显达，岁命生日者，尤为吉昌。此占有人上门相助，惜其传入脱空之乡，又不见其实用也。占者遇之此课，传逢空脱，占事多虚少实，或不要紧之事，凡事有损而无益，占子孙不成家。占官难遽发。占家宅虚耗不足，出者多而入者少。事事有影无形，闻事不的，不可遽信，干事目下不成。暴病吉，久病凶。课中亦见喜而不实，惟利凶忧、狱讼之事，讼不得理亦不妨。\n占出兵行师不宜空：空而多不遂，犹见失象，事多不实也，宜加详察焉。脱空无益。\n真一山人云：事到成时有变更，不须疑虑保平宁。从今祸患俱消尽，久病逢之未保生。\n《无惑钤》云：盗气传逢，初中幸空。独存辰土，生意无穷。\n《钤解》曰：三传水局，俱盗干气，幸而初中空陷，盗党解体。独存末传辰土生气，则生意有无穷之利矣。《集议》：意或两家合本生理尤应，若逢月内之生气尤的。干支全逢自刑，宾主不投。",
