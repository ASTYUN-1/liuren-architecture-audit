    "keJing": [
      [
        {
          "key": "涉害课 坎卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "四课之中同时出现多组上克下或下克上神，且同为阴神或阳神时，则以上神顺行回归地盘本宫，沿途被克的次数做比较。以涉害深（被克次数多）者作为初传。"
        },
        {
          "key": "含义",
          "value": "风波险恶，度涉艰难。舍轻就重，趋安避危之象，事宜见机而作。谋为利名，多费机关；婚姻有阻，疾病难安；胎孕迟滞，行人未还。失物还在家内，逃亡不远隐亲友家。"
        },
        {
          "key": "注意",
          "value": "神将凶，三四克，灾深难解；我克他，日辰旺，神将吉，受克浅，则忧浅易解。"
        },
        {
          "key": "占事",
          "value": "风波险恶，渡沙艰难。"
        },
        {
          "key": "谋事",
          "value": "先难而后可名成利遂，诸事多费苦心而后成，灾难消解较迟。"
        },
        {
          "key": "婚姻",
          "value": "婚姻有阻。"
        },
        {
          "key": "疾病",
          "value": "疾病难安。"
        },
        {
          "key": "逃亡",
          "value": "隐匿于朋友之家。"
        },
        {
          "key": "占孕",
          "value": "伤胎，胎孕迟滞。"
        },
        {
          "key": "占行",
          "value": "待人不来。"
        },
        {
          "key": "失物",
          "value": "物在家内。"
        }
      ],
      [
        {
          "key": "五十一、龙战课 离卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "卯酉日占；卯酉（或上神）发用；占人行年立卯酉之上。三者缺一不可。"
        },
        {
          "key": "含义",
          "value": "凡事疑惑，反复不定，乃门户不宁之课也。欲行难行，欲止难止。家室分离，兄弟异居。"
        }
      ],
      [
        {
          "key": "五十五、九丑课 小过卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "占日为九丑日；占时为四仲时；丑加日支发用；"
        },
        {
          "key": "九丑日",
          "value": "戊子、戊午、壬子、壬午、乙卯、乙酉、己卯、己酉、辛卯、辛酉，共十日。"
        },
        {
          "key": "含义",
          "value": "占者多凶。刚日男凶，柔日女祸。重阳害女，重阴害男。婚姻有灾，营造无补。诸事谋为，徒劳辛苦。嫁娶迁徙，大凶大忌。乘吉将祸浅，乘凶将祸深。"
        },
        {
          "key": "注意",
          "value": "发用若再乘大小时煞，祸不出月。大时煞者，正月起卯，逆行四仲。小时煞即月建。"
        }
      ],
      [
        {
          "key": "六十二、间传课巽卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传相间隔一位递传。"
        },
        {
          "key": "含义",
          "value": "占事得此课，间位相传，事多间阻。"
        },
        {
          "key": "顺间传",
          "value": ""
        },
        {
          "key": "登三天格",
          "value": "三传辰午申"
        },
        {
          "key": "含义",
          "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
        },
        {
          "key": "涉三渊格",
          "value": "三传申戌子"
        },
        {
          "key": "含义",
          "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
        },
        {
          "key": "向三阳格",
          "value": "三传子寅辰"
        },
        {
          "key": "含义",
          "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
        },
        {
          "key": "出三阳格",
          "value": "三传寅辰午"
        },
        {
          "key": "含义",
          "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
        },
        {
          "key": "出户格",
          "value": "三传丑卯巳"
        },
        {
          "key": "含义",
          "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
        },
        {
          "key": "盈阳格",
          "value": "三传卯巳未"
        },
        {
          "key": "含义",
          "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
        },
        {
          "key": "变盈格",
          "value": "三传巳未酉"
        },
        {
          "key": "含义",
          "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
        },
        {
          "key": "入冥格",
          "value": "三传未酉亥"
        },
        {
          "key": "含义",
          "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
        },
        {
          "key": "凝阴格",
          "value": "三传酉亥丑"
        },
        {
          "key": "含义",
          "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
        },
        {
          "key": "溟濛格",
          "value": "三传亥丑卯"
        },
        {
          "key": "含义",
          "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
        },
        {
          "key": "（二）逆间传",
          "value": ""
        },
        {
          "key": "冥阴格",
          "value": "三传寅子戌"
        },
        {
          "key": "含义",
          "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
        },
        {
          "key": "悖戾格",
          "value": "三传戌申午"
        },
        {
          "key": "含义",
          "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
        },
        {
          "key": "顾祖格",
          "value": "三传午辰寅"
        },
        {
          "key": "含义",
          "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
        },
        {
          "key": "极阴格",
          "value": "三传丑亥酉"
        },
        {
          "key": "含义",
          "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
        },
        {
          "key": "时遁格",
          "value": "三传亥酉未"
        },
        {
          "key": "含义",
          "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
        },
        {
          "key": "励明课",
          "value": "三传酉未巳"
        },
        {
          "key": "含义",
          "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
        },
        {
          "key": "回明格",
          "value": "三传未卯巳"
        },
        {
          "key": "含义",
          "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
        },
        {
          "key": "转悖格",
          "value": "三传巳卯丑"
        },
        {
          "key": "含义",
          "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
        },
        {
          "key": "断间传格",
          "value": "三传卯丑亥"
        },
        {
          "key": "含义",
          "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
        }
      ]
    ],
    "bifa": "06.六阴相继尽昏迷.A.六阴格\n26.水日逢丁财动之.A.财乘丁马格.④财乘日本.昼常\n27.传财化鬼财休觅.B.因财致祸格\n30.屋宅宽广致人衰.B.狮兽冲宅格.昼虎\n43.害贵讼直作屈断.Ⅰ.害夜贵\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干前\n47.贵虽在狱宜临干\n49.两贵受克难干贵.A.白虎或乘临丑格.夜\n52.罡塞鬼户任谋为.A.贵塞鬼户格.昼贵\n92.龙加生气吉迟迟.昼",
    "zhiZhi": "己卯日第三局干上巳\n课体：涉害，间传，极阴，九丑，龙战。\n课义：身马宅丁，不容少停，元脱空败，阴极阳生。\n解曰：身乘卯马，宅乘旬丁，马动丁随，决主于动，不容少停也。末传酉乘元武，盗脱日干之气，又系旬空，又系土败之地，至此极矣。物极而变，或者阴尽阳生之候乎。此课因未加酉，故有此说，余不然也。\n断曰：此涉害之卦，格合极阴。又己卯日，丑加辰发用，是名九丑。戊己乃北辰下降之日。卯为阳盛阴绝之辰，刑杀不正，万物纽结，上下迍邅，事多凶咎。况涉害主久历艰辛，龙战主人心疑惑，极阴进寸退尺，动有乖离也。所喜上神生日，乃有人上门助我，不劳我力。然终嫌末传不实，有始鲜终耳。\n天时：久阴霖雨。\n家宅：主人多屋窄，幽暗不明。\n婚姻：相宜，然美中不足。\n胎产：主女胎，难产。\n功名：年命在巳者吉。\n求财：有得。\n疾病：主腹痛惊危，然不妨。\n失脱：难获。\n出行：不利。\n行人：有信，丑巳日至。\n争讼：难解，至达省部。\n兵战：防有变。\n毕法云：眷属丰盈居狭宅，龙加生气吉迟迟。\n课经云：昼将六月占，青龙乘生干之神，又作月内之生气。若君子孟施惠于人，未尝启齿，缓缓作福。\n观月经云：四辰连五日，九丑主恶声，大吉将加仲，大小两时并，三年与三月，不出大凶生。",
    "jiYingQian": "己卯日第三局干上巳\n课体：涉害、六阴、龙战、九丑、极阴、三奇。\n《玉历钤》云：此课丑加宅上发用，昼蛇夜虎，主人宅不宁，人情不顺，况蛇虎在内，凡事无成。\n辰生日上，日上生辰上。\n课名：重审、间传，又名杜塞、九丑。本为凶卦，幸而末见空亡，凶吉从空而散。\n《义》曰：极阴之课，传丑亥酉。讼干省部，病未长久。干支相生，幸获和平。末传不实，事见难成。\n《象》曰：太行之路能摧车，行役冒险恒咨嗟。越此由之是平坦，惊忧变易笑喧哗。\n又：此见机之卦，一曰九丑，一曰龙战。夫见机者，察其微，见其机，谓两比两不比，当以涉害为用。涉害有浅深，欲用不用，欲言不言，事有两而取一，所作稽留，迟疑艰难，进退不定，忧患难消，怀孕伤胎，难于前而易于后。《经》云：“涉害须久历艰辛”。况龙战，主人心疑惑，进寸退尺，动有乖离之象。卯酉为天之私门，生杀有限，分杜有期，雷动龙奔，示其有战。上神生日，所为百事遂，运用如意，遇灾不凶，逢吉愈吉。日乃人相助，夜乃神相助。若当季神生日，主声名显达，岁命生日者尤吉。此乃有人上门成我之意，助我之好，不待己之用力，则彼自为相助也。但惜夫末传力弱，多有始而少终也。又谓之盗支生干，乃应“眷属丰盈居狭宅”。干见日马，有动改之象。《心镜》曰：“乙戊己辛壬五日，四仲相逢九丑神。大吉临于支千上，哭泣凶丧将及人。大小二时相际会，刚日男凶柔女速。重阳害父阴害母，丑上天官决祸因。不但纳妻并嫁女，最忌行役及出军。”《观月经》曰：“修造伤家长，迁移人口惊。殡埋妨长幼，凶深乃四平。三年与三月，不出大凶生。”此课求官者，见贵和合。婚姻宜。交易、投谒人者，名曰“行役徒劳”，而费粮裹。求财有。以上数占，皆有始而无终。远行者，抬土当门阻隔。病者惊悸，凶而不妨。逃盗难获。占宅兴旺。\n占出兵行师得此：昼占腾蛇，出阵而忧心众畏，夜占白兽，败亡而祸起。主客相生，终传落空，吉不成吉，凶不成凶。大抵用兵之道，国之重事，故曰凶事，不得已而用之，贵为将者机变而已矣。\n事成防变。\n真一山人云：养成附凤攀龙手，未必能将志气伸。且向蓬窗读经史，得时行道济斯民。\n《无惑钤》云：身马宅丁，不容少停。玄脱空败，阴极阳生。\n《钤解》曰：身乘巳马，宅乘丑丁，决主动也，岂容少停乎？末传酉金乘玄，又是空脱土败之地，至此极矣，阳将生乎？物极而变，理必然也。此课因未加酉，故有此说，余不然也。《集议》：极阴诗义见本旬丙子日第三课（极阴诗见丙实日第三课，丙子日第三课钤文有脱漏.）。丑加卯为用，得虎，主妇人腹痛。亥涉六重土才到本家，丑到本家止涉二重木，亥为涉深也，用亥是。",
