    "keJing": [
      [
        {
          "key": "九、伏吟课 艮卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
        }
      ],
      [
        {
          "key": "伏吟课",
          "value": ""
        },
        {
          "key": "特征",
          "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
        },
        {
          "key": "含义",
          "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
        },
        {
          "key": "注意",
          "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
        },
        {
          "key": "科举",
          "value": "必定高中，求名荣归。"
        },
        {
          "key": "疾病",
          "value": "有忧，或起怪异之事。"
        },
        {
          "key": "诉讼",
          "value": "为争夺田产成家宅。"
        },
        {
          "key": "灾祸",
          "value": "春冬较浅，秋夏势危。"
        },
        {
          "key": "行事",
          "value": "律身谨慎，动作无虞。"
        }
      ],
      [
        {
          "key": "自任格",
          "value": ""
        },
        {
          "key": "特征",
          "value": "伏吟课，上下无克。日干为阳干，日上神为用，名自任格。"
        },
        {
          "key": "含义",
          "value": "刚愎自用，崭露头角后即有闭塞之兆。凡事过分，易招过失。等人立至，离家逃亡者可在附近寻获。孕产废婴。若占事，祸患会连续发生。三传中见驿马，主待时而动，或不得已而动，亦主动中有成。访人不遇，家中不安，恐有哭泣和离别事。"
        },
        {
          "key": "注意",
          "value": "日辰发用旺相，再乘吉将，仍以吉论。"
        },
        {
          "key": "占事",
          "value": "做事刚烈暴躁，易成过失。"
        },
        {
          "key": "行人",
          "value": "等人将至，逃亡者就在附近。"
        },
        {
          "key": "占孕",
          "value": "不吉，产废晏。"
        },
        {
          "key": "灾锅",
          "value": "祸患留连。"
        },
        {
          "key": "干谒",
          "value": "不宜出门干谒他人，守株待兔方为吉。"
        }
      ],
      [
        {
          "key": "六十、元胎课 家人卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
        },
        {
          "key": "含义",
          "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
        },
        {
          "key": "注意",
          "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
        }
      ],
      [
        {
          "key": "绝胎格",
          "value": "元胎课逢反吟，虽开花但不结子。"
        }
      ],
      [
        {
          "key": "病胎格",
          "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
        }
      ],
      [
        {
          "key": "生胎格",
          "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
        }
      ],
      [
        {
          "key": "蓦越格",
          "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
        }
      ]
    ],
    "bifa": "30.屋宅宽广致人衰.B.狮兽冲宅格.昼虎\n32.三传互克众人欺\n35.人宅受脱俱招盗.A.财空乘元格.昼玄\n43.害贵讼直作屈断.Ⅰ.害昼贵\n46.贵人差迭事参差.夜贵在干前\n52.罡塞鬼户任谋为.B.神藏煞没格.昼贵\n69.虎乘遁鬼殃非浅.昼虎\n70.鬼临三四讼灾随\n75.宾主不投刑在上.Ⅲ.三字刑\n89.任信丁马须言动.乘马",
    "zhiZhi": "丙子日第一局干上巳\n课体：伏吟，自任，元胎。\n课义：禄财错综，昼空无用，寅马为生，夜虎凶动。\n解曰：巳乃日禄，既乘天空；申乃日财，又值旬空，昼占俱无用矣。寅，马也。昼占乘六合为生，夜占乘白虎为克，故主凶动也。\n断曰：此伏吟自任之卦，一名元胎。为伏而未发，屈而未伸之象。利上不利下，利远不利近。守则有功，触则生患。当闭塞柔顺以应之，苟不获已而后动，或动中有成。天空到巳，谓之受辱，亦名投绝。幸作日禄，稍足解之。然中空无力，事主变易。\n天时：昼占久晴，有雨不大，夜占始雾后风。\n家宅：主有孤寡之人，家堂神像不宁。\n婚姻：主女家微贱，或兵家女。\n胎产：主女或聋哑。\n功名：缓得。\n求财：未遂意。\n投谒：主客不和，徒劳无益。\n疾病：主不能言语，宜祈家堂神像。\n失脱：主家内人盗去，难寻，逃者隐乡邻家。\n出行：近处，利夜占，有惊恐。\n行人：中途有阻。\n争讼：宜解。\n兵战：不顺利，主半途而止。\n毕法云：宾主不投刑在上，任信丁马须言动。\n课经订讹云：天地鬼神，不动不克，无所取，择自任。其刚进用于时，故名自任。若任已过刚，必成愆咎。\n指南：辛未四月酉将，占东省地方安否。\n曰：日上勾陈月建被支之元武将星克制，且乘天鬼凶煞，主有伏地兵作乱。又传将递克，伏吟见丁马，官防参劾。后果验。",
    "jiYingQian": "丙子日第一局干上巳\n课体：伏吟、玄胎、折腰、末助初。\n《预见经》占曰：此课来意，主妇人迁移失脱。何以知之？盖巳为初传，日上发用，丙与辛合，辛上见天后，丙日神得天空，为落空亡。中传申上又见玄武，在日刑之位，贼神无力，不能偷物。此必是妇人自遗失其物，亦主有信而难得。盖以末传六合，是为信息，被玄武金克，故云难得。\n《玉历钤》云：此课中传空亡，见财而不实，凡百不可用。法云：此课初传为德禄，中传为财，末传为长生，但嫌中传空亡，若占行人，必中路被阻，前后两难，凡事中有阻碍，术家谓之折腰课。\n上神德日，辰上克日上，辰上克用。\n课名：伏吟。用爻带德禄，及丙上发用，寅为生用，申为财合，本为好课，但申空，见财而不实，中有小阻，始终皆吉。\n《义》曰：天空到巳，哀声嘹唳。幸作日禄，解之勿畏。干事迷蒙，投西向东。中间无力，变易其功。\n《象》曰：静处丰亨动则危，哲人远虑相其机。工夫用尽难成事，争似严滩生钓矾。\n又：此自任之卦，一曰玄胎。夫自任者，乃伏吟之卦，天地伏吟，十二神各归本家，天地如一，四伏未发之象。占事静则宜，动则滞，事主藏匿不动，静中求劳，有屈而不伸之象。况玄胎如婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不通，触则成祸，惟君子守正修德则亨。《经》云：“任信伏吟神，行人立至门。失物家内盗，逃者隐乡邻。病合难言语，占胎聋哑人。访人藏不出，行者却回轮。”一曰：“占遇玄胎，室孕婴孩。”若此课占孕胎者，多是气胎、空胎、鬼胎，不然则孕育难成，秀而不实者也。凡占只宜守旧，不可更动，动则变为罗网，守旧则有自然之禄，《赋》云“旺禄临身徒妄作”。占者遇之此课，禄德发用，本为吉福之论，又见日马，但其中传无力，号曰折腰，此所谓遇而不遇也。求官者且宜缓图，见贵者徒劳思虑。婚姻难成。求财未遂。莫如守旧，却乃相宜。暴病不凶，久病不利。失物难见。逃盗获。公讼有解，主客不和。家宅不宁。凡有占求，未见全美。\n若出兵行师得之，夜占所谋，皆非吉兆。又况贼神有隐避之理，或见中止，多未成功，宜为别图。若不得已而用之，当严加慎密，谨慎关防。且兵乃国之大事，成败系乎大将，能不可不谨乎！\n真一山人云：知足朝朝快乐，贪心日日熬煎。语云死生有命，静看富贵由天。《无惑钤》云：禄财错综，中传见空。昼不为灾，夜虎动凶。\n《钤解》曰：巳日禄乘空，申日财旬空，昼占俱无用也。寅，马也，昼乘六合为生，夜乘白虎，故主凶动也。《集议》：占行人立至，失物家内人盗，逃者隐乡邻，占病难言语，占胎聋哑人。贵人冲处是天空。",
