    "keJing": [
      [
        {
          "key": "九、伏吟课 艮卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
        }
      ],
      [
        {
          "key": "伏吟课",
          "value": ""
        },
        {
          "key": "特征",
          "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
        },
        {
          "key": "含义",
          "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
        },
        {
          "key": "注意",
          "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
        },
        {
          "key": "科举",
          "value": "必定高中，求名荣归。"
        },
        {
          "key": "疾病",
          "value": "有忧，或起怪异之事。"
        },
        {
          "key": "诉讼",
          "value": "为争夺田产成家宅。"
        },
        {
          "key": "灾祸",
          "value": "春冬较浅，秋夏势危。"
        },
        {
          "key": "行事",
          "value": "律身谨慎，动作无虞。"
        }
      ],
      [
        {
          "key": "六十、元胎课 家人卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
        },
        {
          "key": "含义",
          "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
        },
        {
          "key": "注意",
          "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
        }
      ],
      [
        {
          "key": "绝胎格",
          "value": "元胎课逢反吟，虽开花但不结子。"
        }
      ],
      [
        {
          "key": "病胎格",
          "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
        }
      ],
      [
        {
          "key": "生胎格",
          "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
        }
      ],
      [
        {
          "key": "蓦越格",
          "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
        }
      ]
    ],
    "bifa": "30.屋宅宽广致人衰.B.狮兽冲宅格.夜虎\n31.三传递生人举荐.C.两面刀格.①\n32.三传互克众人欺\n37.末助初兮三等论.Ⅰ.生干\n38.闭口卦体两般推.Ⅶ.财作闭口或食神空亡\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n75.宾主不投刑在上.Ⅲ.三字刑\n89.任信丁马须言动.乘丁\n89.任信丁马须言动.乘马",
    "zhiZhi": "戊午日第一局干上巳\n课体：伏吟，元胎。\n课义：末助初生，迤逦相侵，初丁中马，佛口蛇心。\n解曰：末传寅木，助起初传巳火以生戊土，又为德禄临身，课象可谓吉矣。但三传递克伤干，侵凌恐不能免也。初丁日禄，中马支财，财禄之动，仕宦所宜。但恃己之刚，仗势凌人，以致末传之寅先助巳以生干，后递克以伤干。一为佛口，一为蛇心，何其险哉。\n断曰：伏吟本静，传遇丁马，即为极动之象。破碎在干，羊刃在支，虽生皆有可畏。勾陈捧印，白虎入庙，螣蛇生角，大利求官见贵，当有恩命频颁，余亦难中有解。\n天时：朱雀生日，青龙克日，晴而不雨。\n家宅：昼占青龙乘旺，宜于见喜。夜占蛇乘罗网，惊恐难避。\n功名：吉凶相半。\n求财：宜守己财，外财难得。\n婚姻：昼占可就。\n胎产：子息属阳，产期尚远。\n疾病：肝与心经受病，久病凶，宜祈祷。\n出行：昼占水陆皆可，夜占不利。\n行人：立至。\n捕获：本家或亲戚家，奴仆作贼，尚未出户。\n兵战：未见有利。\n坟葬：艮坤龙向，生干大吉。\n毕法云：任信丁马须言动，三传互克众人欺。\n指南：辛未酉时占仕宦，曰:朝官占此，防台谏之封章，得好旨归里。盖因传将互克，太阳无光，岂能久居廊庙。喜朱雀德禄生日，故得温旨归里也。后果因人言请告而归。",
    "jiYingQian": "戊午日第一局干上巳\n课体：伏吟、玄胎。\n苦去甘来乐里悲，三传递克众人欺，任信丁马须言动。\n《玉历钤》云：旦将蛇虎皆凶，不可用事，夜将朱青见官，求官如意，求财求婚不成，占病渐安，公私渐散，占产未生，行人未来，盗逃不获，出入更改平稳。\n上神德日。\n课名：伏吟。守静平安，又丁神主动，上乘雀勾，不免动入闹处，虽末见腾蛇，有变怪，三刑递制不为凶，盖一德扶身，万凶皆散。\n《义》曰：人情未知，事须详慎。佛口蛇心，终不成用。课见勾留，事干两头。庶\n人不吉，仕宦宜求。\n《象》曰：课体虽云屈未伸，仕人占此倍欢忻。难中生易君知否？禄马相宜富贵春。\n又：此自任之卦，一曰玄胎。夫自任者，乃天地伏吟，十二神各归本家，天地如一，四伏未发之象。占事静则宜，动则滞，主事藏匿不动，静中求劳，有屈而不伸之象。况玄胎如婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不通，触则成祸，惟君子守正修德则亨。《经》云：“任信伏吟神，行人立至门。失物家内盗，逃者隐乡邻。病合难言语，占胎聋哑人。访人藏不出，行者却回轮。”夫三传互克，有众人相欺之象，以致众口相攻。如官员，宜自检束，以防台宪上言相害，翻为两面是非，其意谓始赖巳火而生，不觉迤逦克至日干，所喻“成也萧何，败也萧何”，占事中必有两面刀、是非之人，切宜见机，善而处之可也。占者遇之此课，虽云如此，亦终必有解。占求官者最宜，以其迁官捧印，白虎入庙为威，腾蛇生角，大利求官入任。占见贵和顺，四十五日之左右，当有恩命之荣。婚姻合。占求财难。常占摇动不宁。占宅吉。占病忌老人小儿，久病凶，暴病作福。凡事勾留迟滞。\n占出兵不宜：昼占防战士有伤，夜占口舌，谨之勿忽！\n仕宦宜。\n真一山人云：功名得此必称心，病者逢之祸患侵。惟有善功并积德，凶中化吉是佳音。\n《无惑钤》云：末助初生，迤逦相侵。干丁中马，佛口蛇心。\n《钤解》曰：末传寅木，生起初传巳火以生戊土；巳又迤逦下克，以致寅木克戊。始而作德禄生干，是佛口也，终则使寅木乘蛇为鬼，非蛇心而何？其用心也险矣哉！初丁马，动用亦不容已。《集议》：“三传递生人荐举”内有此法，谓生变克，翻为两面刀，以巳喻萧何，占者必被工匠，或干人，或巳生人作两面刀也。“三传互克众人欺”内列此日。“苦去甘来”谓寅先被递克伤干后，却上生巳火作戊土长生，即苦去甘来，寅即萧何也。长生乘虎，幸中不幸；日鬼乘龙，不幸中幸。“宾主不投刑在上”谓此三刑在传，未免无恩之义，凡占恩反怨也。任信丁马，主静中求动终是静，如占干求，先蒙允许，后必改易。如占访人，虽不藏匿，必有事出干，合在他处相见。",
