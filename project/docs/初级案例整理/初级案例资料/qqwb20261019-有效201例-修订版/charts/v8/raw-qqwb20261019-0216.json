    "keJing": [
      [
        {
          "key": "重审课 坤卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
        },
        {
          "key": "含义",
          "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
        },
        {
          "key": "注意",
          "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
        },
        {
          "key": "占事",
          "value": "宜后起，祸由内生。"
        },
        {
          "key": "兵事",
          "value": "用兵主胜。"
        },
        {
          "key": "占孕",
          "value": "主生女。"
        },
        {
          "key": "谋望",
          "value": "主先难后成。"
        },
        {
          "key": "诉讼",
          "value": "后者胜，对被告有利。"
        },
        {
          "key": "初传为墓绝，末传为生旺",
          "value": "灾祸消解，事终有成。"
        },
        {
          "key": "初传为生旺，末传为墓绝",
          "value": "先易后难，先得后失。"
        },
        {
          "key": "初传克末传",
          "value": "有凶兆"
        },
        {
          "key": "末传克初传",
          "value": "为吉兆，"
        },
        {
          "key": "末传天将为龙、常、阴。后、",
          "value": ""
        },
        {
          "key": "六合等吉将，或为德、喜等吉神",
          "value": "逢凶化吉。"
        }
      ],
      [
        {
          "key": "十八、龙德课 萃卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "太岁和月将相同；太岁（月将）乘贵人发用；"
        },
        {
          "key": "含义",
          "value": "君恩及下，万民欢欣。罪囚出狱，财喜临身。名利易遂，争讼休陈。官职拔擢，利见大人。总之利卑下求贵，吉庆重重。"
        },
        {
          "key": "注意",
          "value": "不利尊贵求卑下，再带凶煞、日鬼，决非吉庆。"
        },
        {
          "key": "占事",
          "value": "进财，并有喜事，富贵两全。"
        },
        {
          "key": "占孕",
          "value": "生得贵子。"
        },
        {
          "key": "婚姻",
          "value": "男子娶亲配美丽女子。"
        },
        {
          "key": "诉讼",
          "value": "可占理而先。"
        },
        {
          "key": "谋望",
          "value": "心中谋划之事可遂，谋望更胜于前。"
        }
      ],
      [
        {
          "key": "六十二、间传课巽卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传相间隔一位递传。"
        },
        {
          "key": "含义",
          "value": "占事得此课，间位相传，事多间阻。"
        },
        {
          "key": "顺间传",
          "value": ""
        },
        {
          "key": "登三天格",
          "value": "三传辰午申"
        },
        {
          "key": "含义",
          "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
        },
        {
          "key": "涉三渊格",
          "value": "三传申戌子"
        },
        {
          "key": "含义",
          "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
        },
        {
          "key": "向三阳格",
          "value": "三传子寅辰"
        },
        {
          "key": "含义",
          "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
        },
        {
          "key": "出三阳格",
          "value": "三传寅辰午"
        },
        {
          "key": "含义",
          "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
        },
        {
          "key": "出户格",
          "value": "三传丑卯巳"
        },
        {
          "key": "含义",
          "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
        },
        {
          "key": "盈阳格",
          "value": "三传卯巳未"
        },
        {
          "key": "含义",
          "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
        },
        {
          "key": "变盈格",
          "value": "三传巳未酉"
        },
        {
          "key": "含义",
          "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
        },
        {
          "key": "入冥格",
          "value": "三传未酉亥"
        },
        {
          "key": "含义",
          "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
        },
        {
          "key": "凝阴格",
          "value": "三传酉亥丑"
        },
        {
          "key": "含义",
          "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
        },
        {
          "key": "溟濛格",
          "value": "三传亥丑卯"
        },
        {
          "key": "含义",
          "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
        },
        {
          "key": "（二）逆间传",
          "value": ""
        },
        {
          "key": "冥阴格",
          "value": "三传寅子戌"
        },
        {
          "key": "含义",
          "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
        },
        {
          "key": "悖戾格",
          "value": "三传戌申午"
        },
        {
          "key": "含义",
          "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
        },
        {
          "key": "顾祖格",
          "value": "三传午辰寅"
        },
        {
          "key": "含义",
          "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
        },
        {
          "key": "极阴格",
          "value": "三传丑亥酉"
        },
        {
          "key": "含义",
          "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
        },
        {
          "key": "时遁格",
          "value": "三传亥酉未"
        },
        {
          "key": "含义",
          "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
        },
        {
          "key": "励明课",
          "value": "三传酉未巳"
        },
        {
          "key": "含义",
          "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
        },
        {
          "key": "回明格",
          "value": "三传未卯巳"
        },
        {
          "key": "含义",
          "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
        },
        {
          "key": "转悖格",
          "value": "三传巳卯丑"
        },
        {
          "key": "含义",
          "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
        },
        {
          "key": "断间传格",
          "value": "三传卯丑亥"
        },
        {
          "key": "含义",
          "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
        }
      ]
    ],
    "bifa": "08.权摄不正禄临支.Ⅰ\n15.脱上逢脱防虚诈.Ⅰ.昼贵\n16.空上乘空事莫追.A.脱空格\n37.末助初兮三等论.D.自招其祸格\n43.害贵讼直作屈断.Ⅳ.白虎投朱雀，朱雀投勾陈\n44.课传俱贵转无依.Ⅱ.传俱贵\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n47.贵虽在狱宜临干\n48.鬼乘天乙乃神祗.Ⅳ.夜贵在六处\n49.两贵受克难干贵\n49.两贵受克难干贵.A.白虎或乘临丑格.夜\n52.罡塞鬼户任谋为\n66.支坟财并旅程稽\n76.彼此猜忌害相随.Ⅴ.干支上下交互作六害",
    "zhiZhi": "乙丑日第十一局干上午\n课体：重审，间传，龙德，涉三渊。\n课义：脱空昼迎，禄作元丁，干官贵怒，凶吉无成。\n解曰：午乘天空，脱干之气，而能制初传之申鬼，亦一救神也。卯禄乘丁，昼占作武，恐因禄动而耗费也。夜贵坐克，日贵入狱，干贵者不逢其喜而逢其怒也。中末皆空，则吉凶两不成矣。禄临支上，谓之权摄不正。凡占不自尊贵，受屈于人，或遥授职禄，或受宅上之禄，或将本身之禄，替于儿孙，六乙日皆同。未加巳为两蛇夹墓，占病必有积块，占讼必被囚禁，占事必见凶祸。干上脱气乘空，名脱空格。凡占无中生有，全无实际，所谓脱上逢脱防虚诈也。\n断曰：此卦事多隔手，有不能退，不能遂之象。\n课义：主晴。\n家宅：夜占得贤妻，生好子，昼占多虚耗，防失脱。\n婚姻：女贪男家，亦可入赘，夜占女美。\n疾病：医人得力，虽危无害。\n胎产：男喜，八月占即生。\n行人：寅午日来。\n仕宦：可作佐贰。\n出行：宜从水路。\n遗失：财神空，恐难寻。\n捕亡：昼占往北方，夜占往南方。\n出兵：劳而无功。\n毕法云：权摄不正禄临支，两贵受克难干贵；鬼乘天乙乃神祇，人宅皆死各衰羸。涉三渊诗云：孟动不动涉三渊，申戌子兮在日前；进退艰难还万状，虽然对面隔层天。",
    "jiYingQian": "乙丑日第十一局干上午\n课体：重审、涉三渊。\n不行传者考初时，脱上逢脱防虚诈，权摄不正禄临支，两贵受克难干贵。\n《中黄经》占曰：此课初传申临午，作贵神，名为悬针。中传戌加申，名曰戌加四孟。其人行年三十一岁在申，亦是戌加四孟。乙日夜贵在申，申建庚，庚食戌，名为行年食贵神，以戌加孟，初传悬针，是合有纹面军人相害。故歌云：“戌加四孟是为军”。\n《玉历钤》云：此课德神发用，见贵有喜，但嫌午与辰上卯相破，阻滞，事或托人了绝。\n《毕法》云：此课干之禄加于支上，凡占不自尊大，受屈折于人，如占差遣，主权摄不正，或遥授职禄，或止宜食本家之禄，或将职替与子孙。又云：日干乙生午火，午又生天空，脱上生脱，兼又逢空，凡占指空话空，脱耗虚诈，全无实处。\n上神盗日，辰上生日上，用克日，日上克用。\n课名：重审、间传。德神加午为用，日上有午为伤德用，拜贵人荐引，但中末空亡，凡得此者，初焉甚好，及其终也，不能为吉。凡事亦主再三方见头面，亦无终。故曰：“不行传者考初时”。\n又：此课求名遂，病不死，望信至，胎产生，盗逃获，讼不凶。此课固可用，然日辰上卯午相破，凡事亦难成，托人或再成，占婚不利。德神用日喜非常，见贵求官事事昌。家宅安宁财禄盛，占人望信到吾乡。胎孕将生逃盗获，争讼无凶事允强。日上太冲午卯破，独有婚姻主损伤。\n《义》曰：屈而未伸，勾留疑二。事多隔手，物亦如是。羝触篱藩，进退多艰。先难后易，忧里生欢。\n《象》曰：谋望未成饶阻滞，劝君且莫生奇计。存心守正待时来，天教富贵随春至。\n又：此重审之卦，一曰天网。夫重审者，重而审之也。利为主，利后动，长有厄，事从内起，起于女人。以下犯上，卑犯尊，贱役贵，事多不顺。阴小在下者，有悖逆之事，臣未忠，子失孝，事不可遂意而行，必当审察，循乎义理，庶几以免后患也。神脱干神，虚费百出，谋望不遂，盗失损财，人口衰残。若休囚尤重，旺相庶轻。亦为子孙脱漏之事，凡事虚诈而不可信也。况申戌子乃进间传，事主进而后隔，名之涉三渊也。间传者，有间隔之意，亦如羝羊触藩，进无所往，退无所依。事防再举，病防再发。天网四张，万物被伤。此时不可远行，然而传入空乡，又不足畏也。此课占求官见贵，求谋百事，一无可成之理。暴病者醮神即安，久病者逢之难痊。\n占出兵行师：徒劳跋涉，枉然动众，战士未利，不伸其志。假使孙吴遇此，亦不能成其大功。尤当谨烽埃，慎探听，防其谲诈。敌使之言，切不可信，诡计之来，须先识之，庶不为彼之所欺也。为将者，洞察其情，深究其理，信赏必罚，故曰“知彼知己，每战必胜”，任将权者不可不知斯。\n花开无果之象，四时略同。\n真一山人云：欲望天边好事来，知音未遇且开怀。有人问我真消息，回首归山是福胎。\n《无惑钤》云：脱空昼迎，禄在玄丁。干官贵怒，凶吉无成。\n《钤解》曰：权摄不正禄临支，午乘空脱干，能制初鬼，中末又值空陷，而吉凶不成也。夜贵坐克，昼贵入狱，干官贵不喜而怒也。卯禄乘玄遁丁，必因禄动而耗费多也。《集议》：“脱上逢脱防虚诈，权摄不正禄临支”。申鬼坐克，干支俱乘死神，止宜休息万事，不宜动谋。涉三渊《邵彦和小课》：“欲动不动涉三渊，申戌子兮在目前。进退艰难还万状，对面占之是隔年。”“两贵受克难干贵，空上逢空事莫追”内列此日。以午为脱空神，“罡塞鬼户”内列此说最详。",
