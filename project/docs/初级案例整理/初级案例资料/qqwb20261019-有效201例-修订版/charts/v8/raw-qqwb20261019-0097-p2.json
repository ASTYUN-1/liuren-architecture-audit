    "keJing": [
      [
        {
          "key": "重审课 坤卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
        },
        {
          "key": "含义",
          "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
        },
        {
          "key": "注意",
          "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
        },
        {
          "key": "占事",
          "value": "宜后起，祸由内生。"
        },
        {
          "key": "兵事",
          "value": "用兵主胜。"
        },
        {
          "key": "占孕",
          "value": "主生女。"
        },
        {
          "key": "谋望",
          "value": "主先难后成。"
        },
        {
          "key": "诉讼",
          "value": "后者胜，对被告有利。"
        },
        {
          "key": "初传为墓绝，末传为生旺",
          "value": "灾祸消解，事终有成。"
        },
        {
          "key": "初传为生旺，末传为墓绝",
          "value": "先易后难，先得后失。"
        },
        {
          "key": "初传克末传",
          "value": "有凶兆"
        },
        {
          "key": "末传克初传",
          "value": "为吉兆，"
        },
        {
          "key": "末传天将为龙、常、阴。后、",
          "value": ""
        },
        {
          "key": "六合等吉将，或为德、喜等吉神",
          "value": "逢凶化吉。"
        }
      ],
      [
        {
          "key": "三十四、赘婿课 旅卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "有两种，干加支上克支；支加干上受干之克；"
        },
        {
          "key": "含义",
          "value": "主曲意从人，事多牵连。胎孕迟延，行人淹滞。财名可成，病讼未济。兵利为客，先动多胜。"
        },
        {
          "key": "注意",
          "value": "如果年命得吉神吉将，又名赘婿当权，或末传有救亦是，仍可摆脱牵制，任意所为。"
        }
      ],
      [
        {
          "key": "稼穑格（稼穑课）",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传辰戌丑未，合为土局。"
        },
        {
          "key": "含义",
          "value": "土主沉滞，占事多艰难反复，漫延迟缓。戊己日更属艰难。惟壬癸日为脱难杀，谓物极则变，变则通，危反解散。常人占则名鲸鲵归涧，凡事逼迫不由自己，遇雷神方能变化。雷神者，太冲六合也。凡占多系耕农、土工、筑室、田宅事。若日辰年命乘死气，为坟墓事，乘煞坟墓不安。巳午加日辰年命，则理窑灶事，寅卯加为耕农，申酉加为修城筑室，亥子加为治沟河，六合青龙为田宅交易。大凡为事迟钝，病者在脾。此课如占田土，发用辰将得空、贵、勾、常，主因田土争斗带众，盖天罡为部领之神，勾陈又住戊辰土，定主带众。如将不遇此，主两人争竞田土。甲乙日主争钱物。大都土气重带煞冲破者，托人费力，谋事反复。"
        }
      ]
    ],
    "bifa": "02.首尾相见始终宜.B.回环格\n28.传鬼化财钱险危.B.求财急取格.干上墓\n38.闭口卦体两般推.Ⅵ.禄作闭口\n43.害贵讼直作屈断.Ⅰ.害昼贵\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n49.两贵受克难干贵.A.白虎或乘临丑格.夜\n66.支坟财并旅程稽\n69.虎乘遁鬼殃非浅.夜虎\n75.宾主不投刑在上.Ⅲ.三字刑",
    "zhiZhi": "乙未日第十局干上未\n课体：重审，稼穑，不备，赘婿。\n课义：辛鬼后墓，休买田土，循环三刑，因财受苦。\n解曰：丑为日财，其占为田上。然旬遁辛鬼，鬼墓在后，能伤乙干，又财化为鬼。若事涉田土，于中取财，则循环于三刑之中，缠绕不脱，必致因财起衅，受诸苦楚也。夜占初传螣蛇，末传白虎，其凶尤甚。\n断曰：重审之卦，课传皆季，局合稼穑。干支各遭墓覆，事多艰苦，境亦沉迷。虽满目皆财，而妄求必招灾悔。循理守顺，利必自来。昼贵立酉，显者增荣，下秩所忌。又支财就干。最宜速取，缓则化墓矣。\n天时：阴湿不见日色。\n家宅：主宅来就人，买之不费力，又戌作朱雀加未，主有恶犬伤人。\n婚姻：主纳妾，或妇人携儿改嫁，昼占吉。\n胎产：胎神临败克，防有伤损。\n功名：用财可得，须历艰辛，卑位防谪。\n求财：自来者急取，往求则致祸。\n疾病：中停饮食，寒热不安。\n失脱：龙雀入墓，遗失文书之属。\n出行：墓覆，必不成行。\n行人：在彼不能得意，未归。\n争讼：主因田财而发难端。\n兵战：俟彼来侵，可胜，我动不吉。\n毕法云：华盖覆日人昏晦，干墓并关人宅废，虎乘遁鬼殃非浅，宾主不投刑在上。\n指要云：三传稼穑，田土稽停，四季迎财，尚宜守旧。\n指掌赋云：辰临日而受克，名为赘婿，不能自立其身。",
    "jiYingQian": "乙未日第十局干上未\n课体：重审、稼穑、不备、赘婿、励德、闭口。\n华盖覆日人昏晦。\n《玉历钤》云：此课亦木轻土重，青龙夹克，腾蛇作凶，殊无和气，凡事不可用。《毕法》云：此课未来加乙，名财就人格，财宜速取，少缓则反被未墓其乙，翻为祸矣。又云：支之华盖，作干之墓神，临于干上，又为发用，谓之华盖覆日，凡占身位，多晦暗不显，行事亦不亨泰，凡事不如意也。\n日克上神，辰上刑日上，日克三传。\n课名：重审、稼穑、阳不备。基覆日为用，凡事无气，止而不发，或是重谋，去不自由，所喜三传皆财，且涉艰辛，可以得财，春占可用。\n《义》曰：财多不足，占病少吉。难为父母，虑惹忧戚。切莫求财，求财致灾。顺理向义，福自天来。\n《象》曰：彼此昏迷不足论，相刑强弱两家分。人于忠孝如能勉，祸患应知不及门。\n又：此重审之卦，一曰稼穑，亦曰赘婿。夫重审者，重而审之也。利为主，利后动，长有厄，事从内起，起于女人。以下犯上，贱犯贵，卑犯尊，事多不顺。阴小在下者，有悖逆之事。占臣不忠，子失孝，事不可遂意而行，必当审察，循乎义理，庶几以免后患也。况稼穑乃重土，有艰难之象，常占得此，名曰鲸鲵归涧，凡事逼迫不由己，出若遇雷神，方能变化。《要》曰：稼穑者，五坟也，不宜占病。传见赘婿，凡事不快，寄居身不自由，乃为客求财之课，屈意从人，事多牵制。孕迟，病讼延，行人滞。\n出兵行师得此，昼占青龙，大胜得宝货与图书。然而课见赘婿，利为客，先动者胜。为将者须自立主意，勿令人把持，恐事由他人。但落空亡，凡事宜守旧。有敌使人来，虚诈勿信。\n无始有终。\n真一山人云：莫论婚姻勿论财，莫言公论败多乖。争如忍辱心存守，自有荣华继踵来。\n《无惑钤》云：辛鬼后墓，休买田土。循环三刑，因财受苦。\n《钤解》云：丑乃鬼墓，为田土，作日之财，但旬遁辛为鬼，反伤乙木，财化为鬼，置买田土而取财，恐因财起讼，后受苦楚也。且课传循环三刑，缠绕不了，夜占犹为不吉。《毕法》云“华盖覆日人昏晦”，为戌作朱雀加未，主犬咬人，因而取祸。干墓并关人宅废。虎乘遁鬼殃非浅。宾主不投刑在上。",
