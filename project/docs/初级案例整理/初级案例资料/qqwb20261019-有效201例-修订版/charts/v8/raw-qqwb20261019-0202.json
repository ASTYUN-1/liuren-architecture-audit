    "keti": [
      "涉害",
      "间传",
      "见机",
      "出产"
    ],
    "keyi": "",
    "keJing": [
      [
        {
          "key": "涉害课 坎卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "四课之中同时出现多组上克下或下克上神，且同为阴神或阳神时，则以上神顺行回归地盘本宫，沿途被克的次数做比较。以涉害深（被克次数多）者作为初传。"
        },
        {
          "key": "含义",
          "value": "风波险恶，度涉艰难。舍轻就重，趋安避危之象，事宜见机而作。谋为利名，多费机关；婚姻有阻，疾病难安；胎孕迟滞，行人未还。失物还在家内，逃亡不远隐亲友家。"
        },
        {
          "key": "注意",
          "value": "神将凶，三四克，灾深难解；我克他，日辰旺，神将吉，受克浅，则忧浅易解。"
        },
        {
          "key": "占事",
          "value": "风波险恶，渡沙艰难。"
        },
        {
          "key": "谋事",
          "value": "先难而后可名成利遂，诸事多费苦心而后成，灾难消解较迟。"
        },
        {
          "key": "婚姻",
          "value": "婚姻有阻。"
        },
        {
          "key": "疾病",
          "value": "疾病难安。"
        },
        {
          "key": "逃亡",
          "value": "隐匿于朋友之家。"
        },
        {
          "key": "占孕",
          "value": "伤胎，胎孕迟滞。"
        },
        {
          "key": "占行",
          "value": "待人不来。"
        },
        {
          "key": "失物",
          "value": "物在家内。"
        }
      ],
      [
        {
          "key": "见机格",
          "value": ""
        },
        {
          "key": "特征",
          "value": "当受害深浅一样时，先以四孟（寅申巳亥）上神取用者，为见机格。"
        },
        {
          "key": "含义",
          "value": "事之初起，祸福随之，见事必须见机而行。疑事须急改，犹豫必有失，因此也主事多反覆。多算胜少算不胜，将涉水不轻进之象。名利难遂，胎孕未实。"
        },
        {
          "key": "注意",
          "value": "神将吉以吉言，凶以凶论。"
        },
        {
          "key": "占事",
          "value": "有疑难急迫处，必须改变，否则有失。"
        },
        {
          "key": "占行",
          "value": "利涉大川，有孚贞吉。"
        },
        {
          "key": "名利",
          "value": "名利难递。"
        },
        {
          "key": "占孕",
          "value": "胎孕未实。"
        }
      ],
      [
        {
          "key": "六十二、间传课巽卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传相间隔一位递传。"
        },
        {
          "key": "含义",
          "value": "占事得此课，间位相传，事多间阻。"
        },
        {
          "key": "顺间传",
          "value": ""
        },
        {
          "key": "登三天格",
          "value": "三传辰午申"
        },
        {
          "key": "含义",
          "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
        },
        {
          "key": "涉三渊格",
          "value": "三传申戌子"
        },
        {
          "key": "含义",
          "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
        },
        {
          "key": "向三阳格",
          "value": "三传子寅辰"
        },
        {
          "key": "含义",
          "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
        },
        {
          "key": "出三阳格",
          "value": "三传寅辰午"
        },
        {
          "key": "含义",
          "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
        },
        {
          "key": "出户格",
          "value": "三传丑卯巳"
        },
        {
          "key": "含义",
          "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
        },
        {
          "key": "盈阳格",
          "value": "三传卯巳未"
        },
        {
          "key": "含义",
          "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
        },
        {
          "key": "变盈格",
          "value": "三传巳未酉"
        },
        {
          "key": "含义",
          "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
        },
        {
          "key": "入冥格",
          "value": "三传未酉亥"
        },
        {
          "key": "含义",
          "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
        },
        {
          "key": "凝阴格",
          "value": "三传酉亥丑"
        },
        {
          "key": "含义",
          "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
        },
        {
          "key": "溟濛格",
          "value": "三传亥丑卯"
        },
        {
          "key": "含义",
          "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
        },
        {
          "key": "（二）逆间传",
          "value": ""
        },
        {
          "key": "冥阴格",
          "value": "三传寅子戌"
        },
        {
          "key": "含义",
          "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
        },
        {
          "key": "悖戾格",
          "value": "三传戌申午"
        },
        {
          "key": "含义",
          "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
        },
        {
          "key": "顾祖格",
          "value": "三传午辰寅"
        },
        {
          "key": "含义",
          "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
        },
        {
          "key": "极阴格",
          "value": "三传丑亥酉"
        },
        {
          "key": "含义",
          "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
        },
        {
          "key": "时遁格",
          "value": "三传亥酉未"
        },
        {
          "key": "含义",
          "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
        },
        {
          "key": "励明课",
          "value": "三传酉未巳"
        },
        {
          "key": "含义",
          "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
        },
        {
          "key": "回明格",
          "value": "三传未卯巳"
        },
        {
          "key": "含义",
          "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
        },
        {
          "key": "转悖格",
          "value": "三传巳卯丑"
        },
        {
          "key": "含义",
          "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
        },
        {
          "key": "断间传格",
          "value": "三传卯丑亥"
        },
        {
          "key": "含义",
          "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
        }
      ]
    ],
    "bifa": "06.六阴相继尽昏迷.A.六阴格\n15.脱上逢脱防虚诈.Ⅱ.夜贵\n30.屋宅宽广致人衰.C.血厌克宅格.昼后\n36.干支皆败势倾颓.A.破败神临宅格.在支\n40.后合干支岂用媒.Ⅰ.昼.干上合，支上后\n43.害贵讼直作屈断.Ⅳ.白虎投朱雀，朱雀投勾陈\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干前\n47.贵虽在狱宜临干\n49.两贵受克难干贵\n49.两贵受克难干贵.A.白虎或乘临丑格.夜\n52.罡塞鬼户任谋为\n62.支乘墓虎有伏尸.A.虎鬼克支格.夜",
    "zhiZhi": "己亥日第十一局干上酉\n课体：涉害，间传，见机，出产。\n课义：破败临身，况又乘丁，五阴柔日，凡占杳冥。\n解曰：酉乃土之败气，又为支之破碎。上乘遁丁，其破败耗费，必有不免者矣。课传皆阴，而干上昼合夜后，总为魇翳之神。消沮闭藏，有不可告人者矣。\n断曰：出户之卦，虽自暗出明，而末传空亡。未能出幽离隐。惟天罡塞于鬼户，凡百阴谋，翻能遂意。丑土比肩，克宅发用，家中必有暗损。中传官鬼闭口，尚喜酉制，不至猖獗，必其家有败子，能转移祸福也。\n天时：课传皆阴，毕宿临干，当有雨。\n家宅：昼占则妻妾扰宅，夜占则同类为凶，皆有耗费。\n仕宦：贵禄不见，破败加干，不吉。\n求财：己财不守，不必外求。\n婚姻：后合占婚，成而不吉。\n胎产：男喜，防损胎。\n疾病：肾肺受伤，兼有积块腹疾，四月占更凶。\n出行：水路不吉。\n行人：天罡加孟，尚未启行。\n兵战：未见其利。\n毕法云：后合占婚岂用媒，两贵受克难干贵。\n课经云：干上酉金作日干之脱气，昼乘天后复脱酉金。谓之脱上逢脱，酉为子孙，亦为婢妾。夜乘天后，必有因酒色而败坏身家者。\n又云：申加午，子加戌，昼夜两贵，皆被下神所克，不宜干请。不惟不能成福，翻能致祸。\n心印赋云：丑卯巳为出户，春雷震蛰。",
    "jiYingQian": "己亥日第十一局干上酉\n课体：涉害、六阴、出户。\n《玉历钤》云：此课丑为日冲，卯为日鬼，巳为辰冲，三传皆凶，凡占不可用。\n《毕法》云：此课干上乘酉，酉乃干之败神，又作支之破碎，总为破败神也。以类推之，家必有破败之子，以酉为己之子也。又旦暮将乘天后、六合，酉为婢妾，以后合不正之神，加于婢妾，必主淫乱而破败家道也。\n日生上神，辰上生日上。\n课名：涉害、间传。虽顺而二贵皆逆行，凡占有间隔，所幸巳为空亡，吉凶不成耳。\n《义》曰：脱逢破碎，钱财耗费。名实利虚，济而未济。进退有阻，玄后私晦。事恐既成，不全终始。\n《象》曰：否极纯阴道未亨，莫言世事恼人情。阴消方觉阳初转，渐看春回物自成。\n又：此见机之卦，一曰洗女。夫见机者，察其微，见其机，谓两比两不比，当以涉害为用。涉害有浅深，欲用不用，欲言不言，事有两而取一，所作稽留，迟疑艰难，进退不定，优患难消，怀孕伤胎，难于前而易于后。传见洗女，《经》曰：“天后常为厌翳神，须知六合是私门。二将取名称洗女，夫妻失友异情恩。”此乃暗昧不明之象，占家宅宜谨慎闺门。日生上神，虚费百出，谋望不遂，失盗损财，人口衰残，休囚尤重，又为子孙脱漏之事。丑卯巳，进间传，进而有隔，隔而后进，欲行不行，欲止不止。占者遇之此课，占求官见贵者，美中不足，有阻，凡事干谋，多致破耗，有不足之叹。占婚姻不宜。占财难遂。占病者凶危，末后有解，老人小儿久病不吉。占失物者难得。占出行者，号曰抬土当门。占讼宜和。占投谒人者，被人蒙蔽。占逃亡，宜缉捕。\n占出兵行师得此：昼占无威而不宁，夜占败绩不吉。大抵此课，吉事未见全成，忧疑到底自释也。\n事多间隔。功亏一篑。\n真一山人云：动谋未遂且宽心，小隐闲居自鼓琴。莫道鼓琴人未识，时来便见遇知音。\n《无惑钤》云：破败乘丁，却乃临身。六阴柔日，凡占皆宜。\n《钤解》曰：真朱雀生岁干，夜。酉乃己土败乡，又为破碎句丁，其凶动耗费，败坏极矣。柔日而得纯阴之课，杳冥昏味，何可当也？《集议》：“干支皆败势倾颓”内有此日例，谓酉乃干之败气，又作支之破碎，总名破败神，必家有破败之子孙，缘酉乃己土之子息故也，夜占因妾败。出户：“出户逢明日，欲求干望时。君子升阳渐，小人尚危疑。”脱上逢脱防虚诈。",
