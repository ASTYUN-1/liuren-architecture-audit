    "keJing": [
      [
        {
          "key": "涉害课 坎卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "四课之中同时出现多组上克下或下克上神，且同为阴神或阳神时，则以上神顺行回归地盘本宫，沿途被克的次数做比较。以涉害深（被克次数多）者作为初传。"
        },
        {
          "key": "含义",
          "value": "风波险恶，度涉艰难。舍轻就重，趋安避危之象，事宜见机而作。谋为利名，多费机关；婚姻有阻，疾病难安；胎孕迟滞，行人未还。失物还在家内，逃亡不远隐亲友家。"
        },
        {
          "key": "注意",
          "value": "神将凶，三四克，灾深难解；我克他，日辰旺，神将吉，受克浅，则忧浅易解。"
        },
        {
          "key": "占事",
          "value": "风波险恶，渡沙艰难。"
        },
        {
          "key": "谋事",
          "value": "先难而后可名成利遂，诸事多费苦心而后成，灾难消解较迟。"
        },
        {
          "key": "婚姻",
          "value": "婚姻有阻。"
        },
        {
          "key": "疾病",
          "value": "疾病难安。"
        },
        {
          "key": "逃亡",
          "value": "隐匿于朋友之家。"
        },
        {
          "key": "占孕",
          "value": "伤胎，胎孕迟滞。"
        },
        {
          "key": "占行",
          "value": "待人不来。"
        },
        {
          "key": "失物",
          "value": "物在家内。"
        }
      ],
      [
        {
          "key": "五十五、九丑课 小过卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "占日为九丑日；占时为四仲时；丑加日支发用；"
        },
        {
          "key": "九丑日",
          "value": "戊子、戊午、壬子、壬午、乙卯、乙酉、己卯、己酉、辛卯、辛酉，共十日。"
        },
        {
          "key": "含义",
          "value": "占者多凶。刚日男凶，柔日女祸。重阳害女，重阴害男。婚姻有灾，营造无补。诸事谋为，徒劳辛苦。嫁娶迁徙，大凶大忌。乘吉将祸浅，乘凶将祸深。"
        },
        {
          "key": "注意",
          "value": "发用若再乘大小时煞，祸不出月。大时煞者，正月起卯，逆行四仲。小时煞即月建。"
        }
      ],
      [
        {
          "key": "六十二、间传课巽卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传相间隔一位递传。"
        },
        {
          "key": "含义",
          "value": "占事得此课，间位相传，事多间阻。"
        },
        {
          "key": "顺间传",
          "value": ""
        },
        {
          "key": "登三天格",
          "value": "三传辰午申"
        },
        {
          "key": "含义",
          "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
        },
        {
          "key": "涉三渊格",
          "value": "三传申戌子"
        },
        {
          "key": "含义",
          "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
        },
        {
          "key": "向三阳格",
          "value": "三传子寅辰"
        },
        {
          "key": "含义",
          "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
        },
        {
          "key": "出三阳格",
          "value": "三传寅辰午"
        },
        {
          "key": "含义",
          "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
        },
        {
          "key": "出户格",
          "value": "三传丑卯巳"
        },
        {
          "key": "含义",
          "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
        },
        {
          "key": "盈阳格",
          "value": "三传卯巳未"
        },
        {
          "key": "含义",
          "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
        },
        {
          "key": "变盈格",
          "value": "三传巳未酉"
        },
        {
          "key": "含义",
          "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
        },
        {
          "key": "入冥格",
          "value": "三传未酉亥"
        },
        {
          "key": "含义",
          "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
        },
        {
          "key": "凝阴格",
          "value": "三传酉亥丑"
        },
        {
          "key": "含义",
          "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
        },
        {
          "key": "溟濛格",
          "value": "三传亥丑卯"
        },
        {
          "key": "含义",
          "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
        },
        {
          "key": "（二）逆间传",
          "value": ""
        },
        {
          "key": "冥阴格",
          "value": "三传寅子戌"
        },
        {
          "key": "含义",
          "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
        },
        {
          "key": "悖戾格",
          "value": "三传戌申午"
        },
        {
          "key": "含义",
          "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
        },
        {
          "key": "顾祖格",
          "value": "三传午辰寅"
        },
        {
          "key": "含义",
          "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
        },
        {
          "key": "极阴格",
          "value": "三传丑亥酉"
        },
        {
          "key": "含义",
          "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
        },
        {
          "key": "时遁格",
          "value": "三传亥酉未"
        },
        {
          "key": "含义",
          "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
        },
        {
          "key": "励明课",
          "value": "三传酉未巳"
        },
        {
          "key": "含义",
          "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
        },
        {
          "key": "回明格",
          "value": "三传未卯巳"
        },
        {
          "key": "含义",
          "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
        },
        {
          "key": "转悖格",
          "value": "三传巳卯丑"
        },
        {
          "key": "含义",
          "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
        },
        {
          "key": "断间传格",
          "value": "三传卯丑亥"
        },
        {
          "key": "含义",
          "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
        }
      ]
    ],
    "bifa": "30.屋宅宽广致人衰.B.狮兽冲宅格.昼虎\n33.有始无终难变易.Ⅰ.初生末墓\n38.闭口卦体两般推.Ⅴ.旬尾加旬首\n43.害贵讼直作屈断.Ⅰ.害夜贵\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n47.贵虽在狱宜临干\n49.两贵受克难干贵.A.白虎或乘临丑格.夜\n52.罡塞鬼户任谋为.A.贵塞鬼户格.昼贵\n61.干乘墓虎无占病.昼虎不临干\n66.支坟财并旅程稽",
    "zhiZhi": "乙卯日第三局干上寅\n课体：涉害，间传，极阴，九丑。\n课义：财生俱空，辛酉独逢，所恶满目，所孟无踪。\n解曰：丑为日财，亥为日之长生，发用入传，似乎有益。乃五值旬空，亥坐空上，止存末传酉鬼，又遁作辛鬼，独居实地。明暗二鬼，日所恶也，而偏与之逢。财及长生日所孟也，而皆为乌有，则何益之有哉。\n断曰：极阴之卦，退逆间传，凡事稽留不进，忧患难消。况丑加卯发用，谓之九丑，凶多吉少，反喜初中空陷。吉事不成，凶亦可解，夜占名虎头鼠尾。\n天时：风雾晦冥，既而淫雨。\n家宅：有当门土，宜平去之。\n功名：反覆难成，改图可就。\n求财：虽有而不实。\n婚姻：不祥。\n胎产：主生女。\n疾病：丑加卯乘虎，主妇人腹痛，久病凶。\n争讼：主有奇祸，幸可解。\n失脱：贼获赃散。\n出行：大不利，宜安守。\n行人：有阻，不至。\n兵战：防虚声惑众。\n毕法云：踏脚空亡进用宜。\n观月经云：大吉将加仲，天灾莫举兵，大小两时并，凶神在四平，三年与三月，不出大凶生。\n心镜云：不但纳妻并嫁女，最忌游行及出军。\n订讹云：乙者雷始震之日，卯为春分，阳盛阴绝。又遇丑临仲上，加支发用，与白虎并，主有死亡之事。\n指掌赋云：正亥酉为极阴，如月隐两山。",
    "jiYingQian": "乙卯日第三局干上寅\n课体：涉害、九丑、察微、龙战、极阴、寡宿。\n《金匮经》曰：天地之道，最殃者九丑是也。谓乙戊己辛壬日，加子午卯酉四辰，时加四仲，大吉临日辰，谓之九丑卦，必有不顺之事。臣反君，子害父，奴贼主，妻背夫。阳日杀男，阴日杀女。日辰与白虎并，必有死亡。日为长老，辰为少小。当此之时，不可举兵、嫁娶、移徙、筑室、起土、远行、埋葬，百事不可为，祸不出三月。此课丑临卯，下克上为用，时加四仲，大吉乘白虎带死气而临旺乡，在小时煞上，必有暴死。乙为柔日，杀女人。阳日日辰俱在天乙前，为重阳，主害父，阴日主伤母。\n《玉历钤》云：此课蛇虎临支辰，幸乘空亡，不能为凶，凡占所求不成，所期不遂。\n日上克辰上，日克用，日上克用。\n课名：涉害、九丑、察微。事甚丑恶，凡事宜详察其细微也，幸坐空亡，不为害。\n《义》曰：善者既空，恶者反实。由此推之，何为补益？吉事不成，凶事解散。静室存诚，勿劳谋望。\n《象》曰：忧惊从此放心宽，赐饮朝皆且解颜。莫向利名求进达，南窗高卧日立竿。\n又：此见机之卦，一曰察微，一曰龙战，又曰寡宿。夫见机者，察其微，见其机，谓两比两不比，当以涉害为用。涉害有浅深，故欲用不用，欲言不言，事有两而取一，所作稽留，迟疑艰难，进退不定，忧患难消，怀孕伤胎，难于前而易于后。又曰察微，用临仲，家中产妇惊。夫龙战，主人心疑惑，进寸退尺，动有乖离之象。卯酉为天之私门，生杀有限，分杜有期，雷动龙奔，示其有战。传见寡宿，《赋》云：“寡宿孤辰，值此尤妨骨肉。”若占身得此，主见孤独，别离乡井，自立门户，财物虚耗，僧道宜之，俗不宜也。此课丑加卯上，抬土当门，行人失约，不宜远行，凡事有阻，所喜逢酉冲其卯门而有解也。占者遇之此课，凡占谋望不遂，干事难成，所闻不实，事起自虚声。占求官者，反复难成，秋来可动。占见贵者，有心无力。占婚姻，欲成难成。占财似有而非有。暴病得此为福，久病遇此甚凶。托人多诈。交易难成。狱讼不成。凶殃释散。欲谋成者无益，欲解散者有功。能灭诸凶，能消奇祸。\n占出兵行师得此：传闻不实，多不成功，昼夜所占，闻忧不忧，闻喜不喜，惟防失众而已矣。\n虎头鼠尾。\n真一山人云：久病逢之实为凶，也须作福未成功。事临好处多更变，徒向人前论始终。《无惑钤》云：财生俱空，辛酉独逢。所恶实在，欲者无踪。\n《钤解》曰：丑财亥生，所欲也，皆落空乡。酉鬼遁辛，所恶也，独居实地。可恶者森然而实在，而欲者寂然无踪矣。占者不可求遂所欲，尚当深避其所恶而已。《集议》：“踏脚空亡进用宜”内列此日，谓三旬空亡，向后全无实义，尽无所就。丑加卯，乘虎，主妇人腹痛。极阴：“极阴之课丑亥酉，百事逢之悉皆丑。占讼省部方端的，病死定为不长久。”墓虎临酉，墓门开，又外丧入内，宜合寿木以禳之。",
