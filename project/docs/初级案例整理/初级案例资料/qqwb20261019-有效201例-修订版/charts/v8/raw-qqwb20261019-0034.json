    "keJing": [
      [
        {
          "key": "重审课 坤卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "四课中仅有一组下克上神，为重审课。余课若无克，亦名始入课。"
        },
        {
          "key": "含义",
          "value": "卑犯尊，贱犯贵之象。占事多不顺，事从内起，起于女人。谋事先难后成。利下不利上，利客不利主，利被动方不利主动方。"
        },
        {
          "key": "注意",
          "value": "贵人顺行吉，贵人逆行凶。传生吉，传墓凶。初克末吉，末克初凶。"
        },
        {
          "key": "占事",
          "value": "宜后起，祸由内生。"
        },
        {
          "key": "兵事",
          "value": "用兵主胜。"
        },
        {
          "key": "占孕",
          "value": "主生女。"
        },
        {
          "key": "谋望",
          "value": "主先难后成。"
        },
        {
          "key": "诉讼",
          "value": "后者胜，对被告有利。"
        },
        {
          "key": "初传为墓绝，末传为生旺",
          "value": "灾祸消解，事终有成。"
        },
        {
          "key": "初传为生旺，末传为墓绝",
          "value": "先易后难，先得后失。"
        },
        {
          "key": "初传克末传",
          "value": "有凶兆"
        },
        {
          "key": "末传克初传",
          "value": "为吉兆，"
        },
        {
          "key": "末传天将为龙、常、阴。后、",
          "value": ""
        },
        {
          "key": "六合等吉将，或为德、喜等吉神",
          "value": "逢凶化吉。"
        }
      ],
      [
        {
          "key": "二十九、斩关课 井卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "魁罡加日辰发用，乃豹隐南山之课。"
        },
        {
          "key": "含义",
          "value": "关梁逾越，最利逃亡，捕贼难获，出行无殃。病讼凶祸，厌祷吉祥。最利隐遁逃亡。"
        },
        {
          "key": "注意",
          "value": "贵人临亥，为贵登天门。甲戊庚日贵登天门，为神藏煞没。凡占事遇之，主万事顺利，不独斩关课如此。河魁加亥，名魁度天门，主抑塞难通；天罡加寅，名罡塞鬼户，主谋为顺利；"
        },
        {
          "key": "另注",
          "value": "魁罡临日辰，传有虎阴申酉为斩关得逃者，永远不获。若带血支、血忌、呻吟、羊刃、三杀，必伤人而走。"
        },
        {
          "key": "占行",
          "value": "利于出行，逃遁，但捉贼难获。"
        },
        {
          "key": "占病",
          "value": "遇之大凶。"
        },
        {
          "key": "占讼",
          "value": "遇之大凶。"
        },
        {
          "key": "其他",
          "value": "宜于书符、合药，厌祷。"
        },
        {
          "key": "天地独通",
          "value": "逃亡出行，如有神助。"
        }
      ],
      [
        {
          "key": "六十二、间传课巽卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传相间隔一位递传。"
        },
        {
          "key": "含义",
          "value": "占事得此课，间位相传，事多间阻。"
        },
        {
          "key": "顺间传",
          "value": ""
        },
        {
          "key": "登三天格",
          "value": "三传辰午申"
        },
        {
          "key": "含义",
          "value": "云行雨施，泽及万物。官职迁动，但不宜遇空亡、脱泄。占讼则范围扩大，占病则会加重，占盗贼必来，占行人即至，久旱占者雨。"
        },
        {
          "key": "涉三渊格",
          "value": "三传申戌子"
        },
        {
          "key": "含义",
          "value": "占逢此格，如履薄冰，战战兢兢，疾病难愈，谋望不成，病讼危险，占官无望。占盗贼不来，占行人不至，久雨占则晴。"
        },
        {
          "key": "向三阳格",
          "value": "三传子寅辰"
        },
        {
          "key": "含义",
          "value": "主自暗投明，初凶后吉，病愈讼解，人情皆美。"
        },
        {
          "key": "出三阳格",
          "value": "三传寅辰午"
        },
        {
          "key": "含义",
          "value": "出阳入阴，闭塞不明，谋为动作，病讼皆凶。"
        },
        {
          "key": "出户格",
          "value": "三传丑卯巳"
        },
        {
          "key": "含义",
          "value": "出户而去，访问无从，君子升扬，小人狐疑。占盗贼难获，占行人不归。"
        },
        {
          "key": "盈阳格",
          "value": "三传卯巳未"
        },
        {
          "key": "含义",
          "value": "有物极必反之象。日中将反，稍纵即失。事宜急作，切勿迟滞，故此课占诸事急赴则吉，缓图则凶。"
        },
        {
          "key": "变盈格",
          "value": "三传巳未酉"
        },
        {
          "key": "含义",
          "value": "月盈则缺，乐不可极，势过人衰，物满必缺。占官被黜。占疾病，久病者愈，新病则死。"
        },
        {
          "key": "入冥格",
          "value": "三传未酉亥"
        },
        {
          "key": "含义",
          "value": "夕阳西下，天将背黑。急起直追，时不可失。占讼求官，均主不吉。诸事均宜速办急进，缓则不宜。"
        },
        {
          "key": "凝阴格",
          "value": "三传酉亥丑"
        },
        {
          "key": "含义",
          "value": "正不压邪，淫欲奸盗。幽暗不明，诸事多凶。"
        },
        {
          "key": "溟濛格",
          "value": "三传亥丑卯"
        },
        {
          "key": "含义",
          "value": "阴盛阳微，将明未明，进退失据，忧惧不宁。占诸事物均主欠真实，且难速决。"
        },
        {
          "key": "（二）逆间传",
          "value": ""
        },
        {
          "key": "冥阴格",
          "value": "三传寅子戌"
        },
        {
          "key": "含义",
          "value": "白日忽匿，气象阴惨，鬼域在前，须防暗损，占官最凶。"
        },
        {
          "key": "悖戾格",
          "value": "三传戌申午"
        },
        {
          "key": "含义",
          "value": "占事逢之，不进而退，悖戾之兆。强进有祸，逃避不能。占行人不至，占盗贼不获。亦名“负暄格”，戌申为阴，午为一阳，有冬天受日光暴晒之意。"
        },
        {
          "key": "顾祖格",
          "value": "三传午辰寅"
        },
        {
          "key": "含义",
          "value": "子来视母，复其旧居。游子心动，急于思归。占求财，谋望，诉讼均吉。惟庚辛日占病为凶，因初传午火为鬼故。"
        },
        {
          "key": "极阴格",
          "value": "三传丑亥酉"
        },
        {
          "key": "含义",
          "value": "极阴之地，邪气所乘。荒淫无度，酒色大胆。淫乱异常，占病必死。常占主不利趋势。"
        },
        {
          "key": "时遁格",
          "value": "三传亥酉未"
        },
        {
          "key": "含义",
          "value": "六丁前导，遁迹潜行。行人不至，盗贼难得，病讼皆凶。君子占之，却为有利。"
        },
        {
          "key": "励明课",
          "value": "三传酉未巳"
        },
        {
          "key": "含义",
          "value": "自暗入明，勉强而行。前途坦荡，所欲从心。士人占得，宜取禄位。平民占得，宜早营运，奋力取获之课。"
        },
        {
          "key": "回明格",
          "value": "三传未卯巳"
        },
        {
          "key": "含义",
          "value": "生明生魄，缺月渐圆。循序而进，殃咎自消。诸事均宜缓进，不宜急进。吉事渐成，凶事渐消。久雨占则晴。"
        },
        {
          "key": "转悖格",
          "value": "三传巳卯丑"
        },
        {
          "key": "含义",
          "value": "弃明投暗，不知检点。正路不走，好出风头。败家之子，贤郎难求。主家业凋落，做事不循正轨，不肯安分守命。"
        },
        {
          "key": "断间传格",
          "value": "三传卯丑亥"
        },
        {
          "key": "含义",
          "value": "悬崖下坠，断涧绝流。求名求利，一切无头。此格仕宦人占得，自动离职，才会吉利。平民占得，主灾殃。"
        }
      ]
    ],
    "bifa": "33.有始无终难变易.Ⅱ.初墓末生\n38.闭口卦体两般推.Ⅱ.玄武乘旬首\n38.闭口卦体两般推.Ⅴ.旬尾加旬首\n43.害贵讼直作屈断.Ⅰ.害昼贵\n43.害贵讼直作屈断.Ⅳ.白虎投朱雀，朱雀投勾陈\n46.贵人差迭事参差.夜贵在干前\n46.贵人差迭事参差.昼贵在干后\n52.罡塞鬼户任谋为\n52.罡塞鬼户任谋为.B.神藏煞没格.昼贵\n62.支乘墓虎有伏尸.干墓临支\n85.初遭夹克不由己.昼\n85.初遭夹克不由己.夜\n88.干支乘墓各昏迷.A.互乘墓神格",
    "zhiZhi": "戊寅日第十一局干上未\n课体：重审，间传，斩关，登三天，狡童。\n课义：自墓传生，终不能宁，递相挽抑，两贵皆丁。\n解曰：初传日墓，末传长生，自墓传生，先迷后醒也：而申值旬空，徒然受墓逢刃，终成虚语，岂能宁处乎。干上乘支墓，支上乘干墓，互相牵挽掩抑，以就昏昧：丑贵旬丁，未贵亦藏课丁，主贵人动变。惟贵登天门，仕宦占之最吉。\n断曰：此重审之卦，斗罡加辰发用，课名斩关，亦名登三天。事起阴小，利于后动，所往阻隔，不得遂意而行。况末传空脱，为孟登高而不能之象。夜占用起六合，终于天后，主阴私不正，君子所羞。惟罡塞鬼户，利阴谋私祷，避难逃灾。然利大人大事，不利常人小用也。秋占吉。\n天时：久旱得雨。\n家宅：主人昏宅暗，尤宜谨慎闺门。\n婚姻：夜占不宜。\n胎产：防因病损胎，七月昼占得男。\n功名：年命在丑，七月昼占大利。\n求财：无益。\n疾病：风瘫之症，虽危有解。\n失脱：主奴仆幼辈所窃，不可获。\n出行：利上任及逃避患难。\n行人：在路。\n争讼：防事情转大。\n兵战：昼夜皆吉。\n毕法云：罡塞鬼户任谋为，干支乘墓各昏迷，后合占婚岂用媒。\n课经云：贵登天门，神藏煞没；丑加亥者为的，四孟月尤佳，缘四维为月将也，\n神将论云：六合在辰曰违礼。天后在申曰奸私，起六合，谓之狡童。",
    "jiYingQian": "戊寅日第十一局干上未\n课体：重审、夜狡童、登三天、斩关。\n干支乘墓各昏迷。\n《玉历钤》云：此课六合夹克，举事不完，凡占皆不可用。\n《毕法》云：此课辰为干墓，申为长生，辰午申自墓传生也。凡占先迷后醒，先难后易。\n课名：斩关、涉害、间传。游身在门，参附有出人进望之意。末见空亡，百事不通，然墓发用晦闷。又见登三天难险之课，得空亡解之，亦吉凶无成也。\n《义》曰：彼以诚来，我以诚应。反此何如？有乖无顺。夜占得此，勿问婚姻。男女之私，闺门失废。\n《象》曰：罡塞鬼户任谋为，暗祷私谋事有期。好事未成难事散，登三天势不容奇。\n又：此重审之卦，一曰斩关，亦曰洗女。夫重审者，重而审之也。以下犯上，卑犯尊，贱役贵，事多不顺。阴小在下者，有悖逆之事。占臣未忠，占子失孝，事不可遂意而行，必当审察，循乎义理，庶几以免后患也。利为主，利后动，长有厄，事从内起，起于女人。况斩关非安居之象，常占多不自由，事多暗昧不和，离散口舌，欲隐身避难者，却利乎逃奔也。又主人情暗中不顺，多见更改，事多中止，坟墓破坏，占婚姻亦强成，难于久远。凡事历遍艰辛，然后可遂。传见洗女，《经》曰：“天后常为厌翳神，须知六合是私门。二将取名称洗女，夫妻失友异情恩。”夫洗女乃不正之课，阴私邪淫，占男女有阴私暗昧之理，占家宅宜谨慎闺门，以防阴小越礼，惟能以礼自防者可化之。此罡塞鬼户，利暗谋私祷、合药书符。又名登三天，利大事，利大人，占不利常人小用。病者死，幸解。占远行吉。况支墓干、干墓支，彼此相为掩蔽不明，所占之事多暗昧。号曰“进间传”，有花而无果也。此课诸占无益于事，惟利夫散忧疑、释患难。\n若出兵行师得此，昼夜所占，皆云获金宝之美利，亦曰有始而无终也。还见彼此暗设机智，进中阻隔，不可不先知，贵在用兵者运用之妙耳。\n难于结果。秋吉。\n真一山人云：万丈云梯势插天，世人欲步枉徒然。既知难处勿劳意，大事逢秋亦可全。\n《无惑钤》云：自墓传生，终不能亨。递相昏昧，两贵皆丁。\n《钤解》曰：《集议》：登三天课体，占病死，讼遭极刑，行人难灾。初传日墓，末传长生，当云“先迷后醒”，却曰“终不能亨”，长生空也。干乘支墓、支乘干墓，递相昏昧。丑贵旬丁，夜贵未在丁地，故云“两贵皆丁”，主贵人动变。贵登天门，仕宦占之最宜。",
