    "keJing": [
      [
        {
          "key": "九、伏吟课 艮卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "月将占时相同，天盘合于地盘本位，为伏吟课。"
        }
      ],
      [
        {
          "key": "伏吟课",
          "value": ""
        },
        {
          "key": "特征",
          "value": "伏吟课有克，按贼克法取用，中传取初传所刑之神，末传取中传所刑之神。"
        },
        {
          "key": "含义",
          "value": "凡事主屈而不伸，静中思动。选举必成，考试必中，求名荣归。疾病有忧，或起怪异之事。占断诉讼，冬春二季灾浅，夏秋二季灾重。谨慎律身，动作无虞。鬼旺更乘凶将，其势危凶。"
        },
        {
          "key": "注意",
          "value": "如果三传见吉神，又乘天马、德神、天喜，日辰又临旺相，当以吉论。"
        },
        {
          "key": "科举",
          "value": "必定高中，求名荣归。"
        },
        {
          "key": "疾病",
          "value": "有忧，或起怪异之事。"
        },
        {
          "key": "诉讼",
          "value": "为争夺田产成家宅。"
        },
        {
          "key": "灾祸",
          "value": "春冬较浅，秋夏势危。"
        },
        {
          "key": "行事",
          "value": "律身谨慎，动作无虞。"
        }
      ],
      [
        {
          "key": "自任格",
          "value": ""
        },
        {
          "key": "特征",
          "value": "伏吟课，上下无克。日干为阳干，日上神为用，名自任格。"
        },
        {
          "key": "含义",
          "value": "刚愎自用，崭露头角后即有闭塞之兆。凡事过分，易招过失。等人立至，离家逃亡者可在附近寻获。孕产废婴。若占事，祸患会连续发生。三传中见驿马，主待时而动，或不得已而动，亦主动中有成。访人不遇，家中不安，恐有哭泣和离别事。"
        },
        {
          "key": "注意",
          "value": "日辰发用旺相，再乘吉将，仍以吉论。"
        },
        {
          "key": "占事",
          "value": "做事刚烈暴躁，易成过失。"
        },
        {
          "key": "行人",
          "value": "等人将至，逃亡者就在附近。"
        },
        {
          "key": "占孕",
          "value": "不吉，产废晏。"
        },
        {
          "key": "灾锅",
          "value": "祸患留连。"
        },
        {
          "key": "干谒",
          "value": "不宜出门干谒他人，守株待兔方为吉。"
        }
      ],
      [
        {
          "key": "六十、元胎课 家人卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "三传皆四孟（寅申巳亥），又名玄胎课。"
        },
        {
          "key": "含义",
          "value": "事体皆新，胎孕成型。官加爵位，婚获美妻。病难速愈，财可大兴。道路跋涉，奔波繁忙。若老少占病，为后世投胎之兆，最凶。发用若为父母，主尊长有灾；子孙发用，值空亡名元胎不育，主百事无成，占子息尤艰。发用乘天后值空亡，则主因孕伤母。"
        },
        {
          "key": "注意",
          "value": "此课大体为新鲜吉庆之象。但身喜心忧，事远而多伏，触则成祸。"
        }
      ],
      [
        {
          "key": "绝胎格",
          "value": "元胎课逢反吟，虽开花但不结子。"
        }
      ],
      [
        {
          "key": "病胎格",
          "value": "元胎课逢寅加巳，巳加申，申加亥，亥加寅，上神气泄于下神。主怀胎有忧，事远而伏，暗昧不明，触则成祸。"
        }
      ],
      [
        {
          "key": "生胎格",
          "value": "元胎课若逢寅加亥，亥加申，申加巳，巳加寅，上神受下神之生。百事皆吉，怀孕大吉。"
        }
      ],
      [
        {
          "key": "蓦越格",
          "value": "元胎课，日鬼乘马自第四课发用。占主蓦然而来，或有惊疑、或有盗窃。"
        }
      ]
    ],
    "bifa": "26.水日逢丁财动之.A.财乘丁马格.②财乘驿马\n26.水日逢丁财动之.A.财乘丁马格.④财乘日本.昼常\n31.三传递生人举荐.C.两面刀格.①\n32.三传互克众人欺\n35.人宅受脱俱招盗.A.财空乘元格.夜玄\n37.末助初兮三等论.Ⅰ.生干\n38.闭口卦体两般推.Ⅴ.旬尾加旬首\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干前\n49.两贵受克难干贵.A.白虎或乘临丑格.夜\n69.虎乘遁鬼殃非浅.夜虎\n75.宾主不投刑在上.Ⅲ.三字刑",
    "zhiZhi": "己巳日第一局干上未\n课体：伏吟，自任，元胎。\n课义：德印长生，君子利亨，迤逦克伐，寅为祸萌。\n解曰：初巳为长生，末寅乃日德，又作官爻，仕人求进，岂有不亨利乎。但初克中，中克末，末克干，是寅又为祸萌也。常人值此，必有被人侵凌之患。平日所为过恶，亦必有攻讦之者。现任朝官，须防弹劾，总宜谨饬为妙。己巳伏吟，干支拱定日禄，宜占食禄事。又系两勾夹墓，年命在辰宫者不利。末传助初传而生日干，必有人暗地相助。如夜占寅乘天空，亦恐闲话多而实心少也。\n断曰：元胎之课，如婴儿之隐伏，有滞而未通之象。大约宜静不宜动，利上不利下。惟君子修身俟命，无不亨嘉矣。\n天时：早雨晚晴。\n家宅：宅去生人，主人口进益；若时逢生旺，占者当有兴隆发越之象。\n仕宦：循分守职，前程远大。\n求财：出外无益，在家经营，可以获利。\n婚姻：男性刚强，女性柔顺，能主中馈，益夫宜子。\n胎产：男喜，平安，产时顺利。\n疾病：脾土受克，法宜调治，天医得力，可保无事。\n出行：马空有阻。\n行人：在外受益，未即回家。\n遗失：匿在本家。\n逃亡：尚在境内。\n出兵：三传递克，止宜坚守。\n毕法云：三传互克众人欺。\n括囊赋云：害挟太常，动止则尊亲有讶。德乘朱雀，谋谟而官吏无亏。",
    "jiYingQian": "己巳日第一局干上未\n课体：伏吟、玄胎。\n三传互克众人欺。\n《预见经》占曰：此课来意，主望远信未至，为阴雨阻隔，亦主遗失文字，及有患病人，头疼、心痛不利。何以言之？盖以伏吟主信，初传巳为雷公煞，故云风雨阻隔。巳与申合，己课，寅上见朱雀，夜见天空，主遗失文字也。末传寅在岁后一辰，为病符，合亥，亥上见天后，主头疼，寅又合午，午为心，故心不利。亥数四，至四日方安。\n《通神集》占曰：人年二十八岁，行年巳，巳为用，兼上见青龙乘旺，太常在申，天马在传，此课主将科名及第。\n《玉历钤》云：此课末传日德，旦夜将俱吉，春夏得之，求望官职必成，求财如意。但凡伏吟课，多主迟滞。\n《毕法》云：此课初克中，中克末，末克日干，值者必致众口一词，攻讦凌侮，常人预防词攻状论，官员提备合台上疏论劾，须宜检束，不可忽也。又云：末助初传，而来生日，却主东方木旁人助，南方火姓人作福佑护，亦是曹官之属。\n课名：伏吟，阴日见之，惟此一课见寅为德印天官，贵人在中，初又合，可为吉课。兼末德，合一年九个月见月德，凡事主如意，先不足，后有余。\n又：此课春夏得之，求官求财如意，但伏吟而刑，必有小遗之患。占人望信必来。占婚姻成就。病即安。官司自散。三传递克己土，然后能生初传之火，火却生己土也。昼贵占求官吉。末传日德神，昼夜将皆吉。占人望信来，合神婚利益。狱讼将脱身，病人渐安逸。求利并求名，春夏美如意。\n《义》曰：暗中鬼贼，善以御之。惟恩惟德，贤希圣希。不欺为本，恒自检私。阴阳独彰，夫妇睽违。\n《象》曰：慢携琴剑上皇州，盖世纶才岂遇秋？丹桂槐黄时节好，文章主意莫旁求。\n又：此自信之卦，一曰玄胎。夫自信者，天地伏吟，十二神各归本家，天地如一，四伏未发之象。占事静则渐，主事隐匿不动，静中求劳，有屈而不伸之象。\n《经》曰：“任信伏吟神，行人立至门。失物家内盗，逃亡隐近邻。病则难言语，占胎生哑人。访人藏不出，伏吟泪淋淋。”况玄胎如婴儿隐伏之状，利上不利下，事主远而多伏，暗昧不通，触则成祸，惟君子守正修德则亨。\n《经》曰：“占遇玄胎，室产婴孩。”不利占老人小儿病，乃再投胎也，久病不宜，故曰“久病人身怕见马”，名驮尸，太阴可解。又云：日辰只有两课，用刑明起传，主事屈不得伸，静中鬼伏，且藏伏而呻吟，岂得已？外用日则舍阴，用辰则舍阳，故天地不备，阴阳独彰，实为不足之体。\n《经》曰：阴日刑害破冲已见，传内皆是刑中有害，破中有合，凶中吉，吉中凶，祸福倚伏，不可一概而论。占病多倦言，或不进饮食，久病并老人小儿凶，后世之胎也。占孕惊恐，其胎聋哑。远行回轮，近行将至。求财动摇。盗者不出其家，逃者不出邑里。远行不利，正五九月尤忌。占谒见有助，亦有隐避不欲见之理。论讼始终必见相合庶志。占宅人才兴旺，冬占主出隐贵。\n行军得此，忧心众畏，惊骇不宁，宜申严号令，明示赏罚，以一其志，以备不虞。未出军得此，宜再占之。若临敌对垒，宜坚壁固守，以相其机，出其不意，此义致胜之道，还见有两兵相合解退之意。大抵此课，惟利求名，有迁官食禄之荣，登科甲第之美，最忌占人年命冲刑禄马，则又美中未美。欲访察事情，人多不尽言。其他又在四时月令，并占人年命，而未能具尽其理也。\n春吉，夏中，秋逆，冬平。\n真一山人云：圣贤梯阶未足遥，两途祸福自相招。人于动处存天理，凶卦翻为吉卦爻。\n《无惑钤》云：德寅长生，君子则亨。迤逦克伐，寅为祸萌。\n《钤解》曰：干支拱日禄午，午为真朱雀，生日干，年命上见申酉，未免不能生初，则凶。初巳为长生，末寅为日德作官爻，又干支拱禄，主士人求进则亨，宜占食禄事。但初克中，中克末，末寅克干，诚为祸萌也。常人值此，被人欺凌，平日所为凶横，被众攻讦。见在朝官，须防阁台上言，宜自检束为妙。《集议》：“末助初生三等论”内谓此末助初生干，须年命上神生末乃吉，若制末，反凶。日上未虎临干，占病腰疼。“前后引从升迁吉”内列此日，为干支拱禄，宜占食禄事。“宾主不投刑在上”内谓此三刑在传，未免无恩之意，凡占恩反怨也。\n雍正九年三月初六日，卜家宅吉凶。夜戌时戌将，主明日有信来。舍弟来应。",
