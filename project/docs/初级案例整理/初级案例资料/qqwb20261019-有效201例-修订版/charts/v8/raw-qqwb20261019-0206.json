    "keJing": [
      [
        {
          "key": "蒿矢课",
          "value": ""
        },
        {
          "key": "特征",
          "value": "先取遥克日干之神作初传，为蒿矢课。远神克日缓而轻，如折蒿为矢力弱难伤。三传带金为矢有簇，有杀伤力。"
        },
        {
          "key": "含义",
          "value": "开始气势汹汹，后来雷声大雨点小。忧喜皆无实，文书虚谋。不宜有客，有客多反目成仇。利主不利客，利小不利大。诸事先难后利，先动手无利，后动手有利。"
        },
        {
          "key": "注意",
          "value": "三传神将凶，日辰无气。有盗贼及其他阴谋灾害。三传神将吉，日辰有气者，谒贵有喜，待人亦来。"
        },
        {
          "key": "占事",
          "value": "开始时有如雷般的凶势，但愈久愈休，逐渐消失。"
        },
        {
          "key": "文书",
          "value": "忧喜不能成实，文书停留在谋划上。"
        },
        {
          "key": "行人",
          "value": "不宜有客，有客多为仇敌。"
        },
        {
          "key": "兵事",
          "value": "兵利主一方，不利客一方。"
        }
      ],
      [
        {
          "key": "二十九、斩关课 井卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "魁罡加日辰发用，乃豹隐南山之课。"
        },
        {
          "key": "含义",
          "value": "关梁逾越，最利逃亡，捕贼难获，出行无殃。病讼凶祸，厌祷吉祥。最利隐遁逃亡。"
        },
        {
          "key": "注意",
          "value": "贵人临亥，为贵登天门。甲戊庚日贵登天门，为神藏煞没。凡占事遇之，主万事顺利，不独斩关课如此。河魁加亥，名魁度天门，主抑塞难通；天罡加寅，名罡塞鬼户，主谋为顺利；"
        },
        {
          "key": "另注",
          "value": "魁罡临日辰，传有虎阴申酉为斩关得逃者，永远不获。若带血支、血忌、呻吟、羊刃、三杀，必伤人而走。"
        },
        {
          "key": "占行",
          "value": "利于出行，逃遁，但捉贼难获。"
        },
        {
          "key": "占病",
          "value": "遇之大凶。"
        },
        {
          "key": "占讼",
          "value": "遇之大凶。"
        },
        {
          "key": "其他",
          "value": "宜于书符、合药，厌祷。"
        },
        {
          "key": "天地独通",
          "value": "逃亡出行，如有神助。"
        }
      ],
      [
        {
          "key": "三十二、三交课 姤卦",
          "value": ""
        },
        {
          "key": "特征",
          "value": "四仲日占；四仲加干或支；三传皆仲神；发用乘太阴、六合；"
        },
        {
          "key": "含义",
          "value": "主交加连累，奸私隐匿，谋事不明，求财无益。讼犯刑名，兵逢强敌。乘凶将病患尤甚。再遇凶神，男犯重法，女犯私通。初传乘太阴、六合，主门户不利，有隐私事。初传乘天空，主虚诈事。乘玄武，主遗失被盗。乘螣蛇，主惊恐怪异。乘朱雀主口舌是非。乘勾陈，主厮打斗殴。乘白虎，主孝服损伤。"
        },
        {
          "key": "注意",
          "value": "太阴、六合不入传，名三交不交，占事为不及；如年月日时皆仲神，名三交不解。占事为太过。二者之凶，更甚于交。年命乘吉将，日辰发用旺相。或三传为午卯子，为高盖乘轩，皆不得以三交课论。"
        },
        {
          "key": "逃亡",
          "value": "家中隐有奸私，或自身逃匿。"
        },
        {
          "key": "求事",
          "value": "谋事不明。"
        },
        {
          "key": "求财",
          "value": "求财不得。"
        },
        {
          "key": "占诉",
          "value": "犯法而遭刑。"
        },
        {
          "key": "占兵",
          "value": "遇到强敌。"
        },
        {
          "key": "占病",
          "value": "病患更甚。"
        }
      ]
    ],
    "bifa": "26.水日逢丁财动之.A.财乘丁马格.②财乘驿马\n35.人宅受脱俱招盗.B.鬼脱乘元格.鬼.昼玄\n37.末助初兮三等论.D.自招其祸格\n46.贵人差迭事参差.昼贵在干前\n46.贵人差迭事参差.夜贵在干前\n49.两贵受克难干贵.A.白虎或乘临丑格.夜\n69.虎乘遁鬼殃非浅.昼虎\n76.彼此猜忌害相随.Ⅴ.干支上下交互作六害",
    "zhiZhi": "己酉日第十局干上戌\n课体：蒿矢，三交，斩关。\n课义：弓矢斯张，蒿箭何防，那堪堕矢，惊恐无伤。\n解曰：发用蒿矢逢空，矢已堕矣。中午旺禄，虽坐于空，末传之镞，尽被火克，灰飞烟灭，复何伤之有。\n断曰：蒿矢祸福皆轻，虽交车六害，刑干脱支，未为凶象。况阴神互作六害，虽危有救。发用官鬼临子，逢春或改旬，破财求官甚吉。\n天时：大晴。\n家宅：日鬼作支之阴辰发用，不宁。\n功名：主有虚惊。\n求财：出旬再图。\n婚姻：昼占可用，夜占更吉。\n胎产：二阴包阳，孕男，产速。\n疾病：肾经受病，或病起饮食，宜治脾。\n争讼：鬼空，讼可解。\n出行：马恋长生，恐不成行，行则陆路吉。\n行人：天罡加季即至。\n捕获：昼占盗在正南空马房中。\n兵战：不利。\n坟葬：冬占发财发贵。\n毕法云：空上逢空事莫追。\n指南：己卯六月未加辰占病，曰:太岁发用作日破，目今无妨，但医神发用克日，用药不当。木火为虎鬼，脾肺受病，未能脱体，须平肝清心，可以渐愈。卯为死我门，酉为生我户。宜避初就末，可向空门求接命延年之术，否则壬午春，必有他虞矣。支上见胎神，家有妊妇。当二男一女，以行年推之，丁未生女，壬子、甲寅皆生男，后悉验。",
    "jiYingQian": "己酉日第十局干上戌\n课体：蒿矢、寡宿、三交、斩关、闭口。\n《玉历钤》云：此课蒿矢无力，又兼空亡发用，吉凶皆不成。\n《玉成歌》曰：官鬼下临财位上，阴私用事畏人彰，盖言卯为日鬼，而临子乡，为日之财位，凡占必主阴私用事也。\n日上克辰上，用克日上.末克初。\n课名：蒿矢、三交、斩关。用又空亡，益见无力，所占虚指妄射，终成暗昧，交加而已，吉凶从空而散。\n《义》曰：空上成空，事无定踪。凶难伤害，吉不成功。忧疑散释，君子固穷。久病逢之，是谓老终。\n《象》曰：蒿矢逢空仰射天，养由巧处也徒然。乘轩高盖惟春吉，前有三分后有三。\n又：此蒿矢之卦，一曰三交，亦曰天网，又曰寡宿。《经》曰：“神遥克日名蒿矢，射我虽端当不畏。贵人逆转子无良，天乙顺行臣不义。家有宾来不可容，亦忧口舌西南至。”然事主动摇，人情倒置，象如以蒿为矢，射虽中而不人，祸福俱轻，求事难成，利主不利客。占行人来，访人见。若带金煞，亦能伤人，主蓦然有灾。传见三交，前不能进，后不能退，交加其象。此三交也，《经》曰：“三交家匿阴私客，不迩自将逃避速。”凡事失节阻碍，谋事被人阻破，不能成合。《经》曰“天网四张，万物被伤”，为阻滞，为疑难，为灾恼。占者遇之此课，发用无力，传于空脱之乡。家宅虚耗，干事难成，谋望未就，宾主不和，惟春占庶几有得，若在夏秋，占谋乃指空说空，徒劳心志，竟未有所就也。所闻不实。占人孤独。占官位改动。占忧惊得此有解。占暴病修德可禳，久病深畏凶衰。\n占出兵行师：昼有失众之象，夜有得胜之兆。敌使多诈。吉不成吉，而凶不成凶，有影无形之象也。\n秀而不实。\n真一山人云：一壶村酒一张琴，随处逢人奏好音。世事眼前只如此，何须汲汲去劳心。\n《无惑钤》云：弓矢斯张，蒿箭何妨？更又堕矢，鬼怪无伤。\n《钤解》曰：蒿矢逢空，箭已堕矣，虚惊而已，有何伤哉？《集议》：“空上逢空事莫追”内有此法，凡占遥克为用空亡，或坐空乡，及上乘天空者，所占皆无实也。“人宅受脱俱招盗”内有此法云：初传是遥克，作空落空，尤无力，或是昴星，又是空亡发用，将乘玄武者，凡占主失脱，此法极验。夜占帘幕临支。子乘贵临酉，主尊长灾咎。“空空如也事休追”内有此法云：初传遥克，作空落空，尤无力也。己土死于卯，况本太常，去酉上败，是进败也；酉在背后，是退败也；太阴便是酉，又来日上败我。进亦败，退亦败，见在亦败，岂不死也？出《邵彦和引证戌集》。",
