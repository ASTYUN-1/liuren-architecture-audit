{
  "schemaVersion": 1,
  "domainStage": 2,
  "domains": [
    "finance",
    "recruitment",
    "promotion-salary",
    "relationship",
    "interpersonal",
    "period-outlook",
    "long-period",
    "pregnancy",
    "exam",
    "illness",
    "lost-person-object",
    "classical-conflict"
  ],
  "labels": {
    "positioning": "定位与选线",
    "evidence": "证据检索",
    "relations": "课位与关系",
    "liqi": "理气与救制",
    "void": "空亡与变质",
    "bashajiubao": "八煞九宝",
    "engine-shensha-output": "引擎神煞字段",
    "shensha-focus": "32项",
    "shensha-use": "神煞取用",
    "movement": "动态与阴神",
    "structure": "课体结构",
    "adjudication": "调制与裁决",
    "report": "报告与交付检查",
    "daliuren-paipan": "排盘操作",
    "nianming": "年命",
    "timing": "应期",
    "risk": "风险细则",
    "shensha-tradition": "神煞方法",
    "rule-semantics": "规则语义",
    "liqi-sources": "来源卡",
    "quantity": "数量与精度",
    "quantity-sources": "数法来源与条件",
    "workflow-contract": "可选结构化审计（非本机默认）"
  },
  "stages": [
    {
      "id": 1,
      "title": "数据准备",
      "action": "区分题干事实、程序盘、解释断语；列盘源、关键缺项",
      "required": [],
      "note": "复用可靠程序盘，不由模型重排。"
    },
    {
      "id": 2,
      "title": "明占类",
      "action": "保留原问，列对象、事件阶段、期限、成功标准；检索方法与反例",
      "required": [
        "positioning",
        "evidence"
      ],
      "note": "并读取命中的占类；原问与检索要求按本环节落实。"
    },
    {
      "id": 3,
      "title": "定侧重",
      "action": "固定日干/日支/类神/人物；写明主线如何直接回答本问",
      "required": [
        "relations"
      ],
      "note": "不得只给角色贴标签。"
    },
    {
      "id": 4,
      "title": "看显象",
      "action": "对主判和最强反证比较双方状态、关系与实际作用",
      "required": [
        "liqi",
        "void"
      ],
      "note": ""
    },
    {
      "id": 5,
      "title": "综合核查",
      "action": "八煞九宝及32项逐项检查，区分已核、待核、采用与无关",
      "required": [
        "bashajiubao",
        "engine-shensha-output",
        "shensha-focus",
        "shensha-use"
      ],
      "note": ""
    },
    {
      "id": 6,
      "title": "动态深化",
      "action": "关键通路、直接阴神、已核年命；写出作用与停止深化理由",
      "required": [
        "movement"
      ],
      "note": "有具体争点才扩层。"
    },
    {
      "id": 7,
      "title": "结构反证",
      "action": "九宗门、毕法结构、位次相互核对，不能由课名结案",
      "required": [
        "structure"
      ],
      "note": "构成不明时读所链接表格。"
    },
    {
      "id": 8,
      "title": "制救裁决",
      "action": "比较最强反证、救制范围；分开结果、过程、程度",
      "required": [
        "adjudication"
      ],
      "note": ""
    },
    {
      "id": 9,
      "title": "应期与取数",
      "action": "在既定对象与结果分支中分别完成数值和时间任务",
      "required": [],
      "note": "按题目选择专项；无相应任务注明不适用，不改变主干次序。"
    },
    {
      "id": 10,
      "title": "收尾核证",
      "action": "复用前置检索，核来源、迁移条件与未解决分歧；有新争点再查",
      "required": [],
      "note": "依证据检索规程复用前置检索，有新争点再查。"
    },
    {
      "id": 11,
      "title": "交付复核",
      "action": "列依据、反证取舍、结论依赖、边界及实际读取缺口",
      "required": [
        "report"
      ],
      "note": "缺必读项先补读。"
    }
  ],
  "conditional": {
    "daliuren-paipan": {
      "stage": 1,
      "trigger": "需要起课或核对程序盘",
      "selectWith": "--condition daliuren-paipan"
    },
    "nianming": {
      "stage": 1,
      "trigger": "涉及本命或行年规则的计算、核验或采用",
      "selectWith": "--nianming"
    },
    "rule-semantics": {
      "stage": 2,
      "trigger": "否定范围、摘要条件或规则强度存疑",
      "selectWith": "--condition rule-semantics"
    },
    "liqi-sources": {
      "stage": 4,
      "trigger": "所采用方法存在来源或口径分歧",
      "selectWith": "--condition liqi-sources"
    },
    "risk": {
      "stage": 4,
      "trigger": "四大凶象承担主判或最强反证",
      "selectWith": "--condition risk"
    },
    "shensha-tradition": {
      "stage": 5,
      "trigger": "采用季煞或传统神煞层级说明",
      "selectWith": "--condition shensha-tradition"
    },
    "quantity": {
      "stage": 9,
      "trigger": "原问要求金额、分数、数量、重量、距离等数值，或已选应期专法需要数理时长",
      "selectWith": "--condition quantity"
    },
    "quantity-sources": {
      "stage": 9,
      "trigger": "需要核对取数数表、原法条件或精确数值案例；已取得对应原书可复用",
      "selectWith": "--condition quantity-sources"
    },
    "timing": {
      "stage": 9,
      "trigger": "有时间任务",
      "selectWith": "--timing"
    }
  }
}
