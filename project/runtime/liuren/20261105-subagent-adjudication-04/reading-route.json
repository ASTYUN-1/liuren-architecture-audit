  "stages": [
    {
      "id": 1,
      "title": "初看课势，依问定侧重",
      "required": [
        "class-mapping",
        "positioning",
        "relations",
        "liqi",
        "structure"
      ],
      "action": "原问与可靠课盘→确定结果区分→取类定位与专项→关系及待核主线",
      "note": "类象取用与理气贯通；空亡和制救未核，不先定结果。"
    },
    {
      "id": 2,
      "title": "察类辨用，循气取象",
      "required": [
        "void",
        "bashajiubao",
        "engine-shensha-output",
        "shensha-focus",
        "shensha-use",
        "movement"
      ],
      "action": "核主象真假变质、主客取与、有效组合与传递制救；回核所主",
      "note": "阶段1已读神将模块复用；有反证回核，不重复门禁。"
    },
    {
      "id": 3,
      "title": "资料核证，独立裁决，完整交付",
      "required": [
        "evidence",
        "adjudication",
        "report"
      ],
      "action": "所需专法→中性资料核证→全新task子智能体独立裁决→完整正文",
      "note": "缺项补齐后新建独立裁决；主智能体不形成初判或代裁。"
    }
  ],
  "conditional": {
    "daliuren-paipan": {
      "stage": 1,
      "trigger": "需要起课或核对程序盘",
      "selectWith": "--condition daliuren-paipan",
      "beforeRequired": "class-mapping"
    },
    "nianming": {
      "stage": 1,
      "trigger": "涉及本命或行年规则的计算、核验或采用",
      "selectWith": "--nianming",
      "beforeRequired": "class-mapping"
    },
    "rule-semantics": {
      "stage": 1,
      "trigger": "否定范围、摘要条件或规则强度存疑",
      "selectWith": "--condition rule-semantics",
      "beforeRequired": "positioning"
    },
    "liqi-sources": {
      "stage": 1,
      "trigger": "所采用方法存在来源或口径分歧",
      "selectWith": "--condition liqi-sources",
      "beforeRequired": "positioning"
    },
    "risk": {
      "stage": 2,
      "trigger": "四大凶象承担主判或最强反证",
      "selectWith": "--condition risk",
      "beforeRequired": "movement"
    },
    "shensha-tradition": {
      "stage": 2,
      "trigger": "采用季煞或传统神煞层级说明",
      "selectWith": "--condition shensha-tradition",
      "beforeRequired": "bashajiubao"
    },
    "quantity": {
      "stage": 3,
      "trigger": "原问要求金额、分数、数量、重量、距离等数值，或已选应期专法需要数理时长",
      "selectWith": "--condition quantity",
      "beforeRequired": "evidence"
    },
    "quantity-sources": {
      "stage": 3,
      "trigger": "需要核对取数数表、原法条件或精确数值案例；已取得对应原书可复用",
      "selectWith": "--condition quantity-sources",
      "beforeRequired": "evidence"
    },
    "timing": {
      "stage": 3,
      "trigger": "有时间任务",
      "selectWith": "--timing",
      "beforeRequired": "evidence"
    },
    "shenjiang-use": {
      "stage": 1,
      "trigger": "采用神将同用、互换，或需要核对具体神将类义的适用范围",
      "selectWith": "--condition shenjiang-use",
      "beforeRequired": "positioning"
    },
    "shen-symbols": {
      "stage": 1,
      "trigger": "需查十二天神的基础义、复合取义或与本家天将的差别",
      "selectWith": "--condition shen-symbols",
      "beforeRequired": "positioning"
    },
    "jiang-symbols": {
      "stage": 1,
      "trigger": "需查十二天将的职能、占类取义或与本家支神的差别",
      "selectWith": "--condition jiang-symbols",
      "beforeRequired": "positioning"
    },
    "mapping-provenance": {
      "stage": 1,
      "trigger": "需核合并对应、旧 I/B 上下文、原卡或未决条件",
      "selectWith": "--condition mapping-provenance",
      "beforeRequired": "positioning"
    }
  },
  "domainAfter": "positioning",
