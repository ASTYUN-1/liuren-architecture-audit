        "judgment-core"
      ],
      "action": "先读共用规范和本问domain，详细方法按具体缺口查"
    },
    {
      "id": 2,
      "title": "必要补核与核心交接",
      "required": [],
      "action": "条件不清、反证冲突或摘要不足才定点查方法/原书，不整库通读"
    },
    {
      "id": 3,
      "title": "独立裁决与交付",
      "required": [
        "adjudication",
        "report"
      ],
      "action": "核心必读、来源按需，返回核对后忠实交付；report在交付前读"
    }
