{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "chartHash": {
      "type": "string"
    },
    "runtimeVersion": {
      "type": "string"
    },
    "questionId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$"
    },
    "questionRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "target": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2000
    },
    "dimension": {
      "type": "string",
      "enum": [
        "result",
        "process",
        "degree",
        "attribute",
        "identity",
        "location",
        "quantity",
        "timing"
      ]
    },
    "successCriterion": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2000
    },
    "roles": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$"
          },
          "entity": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2000
          },
          "anchorFacts": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "value": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "required": [
                "path",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "mappingSourceIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unusedReason": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "entity",
          "anchorFacts",
          "mappingSourceIds"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$"
          },
          "fromRole": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$"
          },
          "toRole": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$"
          },
          "factRefs": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "value": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "required": [
                "path",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "methodIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assessment": {
            "type": "string",
            "enum": [
              "supported",
              "limited",
              "unknown"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "result",
              "process",
              "degree",
              "attribute",
              "identity",
              "location",
              "quantity",
              "timing"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2000
          },
          "effect": {
            "type": "string",
            "enum": [
              "ordinary",
              "rescue"
            ]
          },
          "effectiveness": {
            "type": "string",
            "enum": [
              "confirmed",
              "candidate",
              "not-effective"
            ]
          },
          "limitations": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2000
            }
          }
        },
        "required": [
          "id",
          "fromRole",
          "toRole",
          "factRefs",
          "methodIds",
          "assessment",
          "scope",
          "reason",
          "effect",
          "effectiveness",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "counterEvidence": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "found",
            "searched-none",
            "unresolved"
          ]
        },
        "refs": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "searchScope": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000
        },
        "disposition": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000
        }
      },
      "required": [
        "status",
        "refs",
        "searchScope",
        "disposition"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "conditional",
            "undetermined"
          ]
        },
        "answer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000
        },
        "dependsOn": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$"
          }
        }
      },
      "required": [
        "status",
        "answer",
        "dependsOn"
      ],
      "additionalProperties": false
    },
    "unresolved": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "position",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2000
          },
          "important": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "description",
          "important"
        ],
        "additionalProperties": false
      }
    },
    "retrievalRefs": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timing": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000
        },
        "scale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000
        },
        "trigger": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000
        },
        "candidates": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2000
          }
        }
      },
      "required": [
        "event",
        "scale",
        "trigger",
        "candidates"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "chartHash",
    "runtimeVersion",
    "questionId",
    "questionRevision",
    "target",
    "dimension",
    "successCriterion",
    "roles",
    "relations",
    "counterEvidence",
    "decision",
    "unresolved",
    "retrievalRefs"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
